<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title><%= title || 'Cambiar Contraseña — MONSELEY' %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="/css/login.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
  <main class="card" role="main" aria-label="Formulario de cambio de contraseña">
    <header>
      <img src="/img/logo.png" alt="Logo de la empresa" class="logo" />
      <div class="brand" aria-label="Identidad visual">
        <span class="brand-name">BYGGER SRL · MONSELEY</span>
      </div>
      <div class="brand-divider"></div>
      <h1 class="title">Cambio Obligatorio</h1>
      <p class="subtitle">Por seguridad, debes cambiar tu contraseña temporal antes de continuar.</p>
    </header>
 
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-box" role="alert"><%= error %></div>
    <% } %>
 
    <form id="login-form" action="/cambiar-password" method="post" novalidate>
      
      <div class="field">
        <label for="password">Nueva Contraseña</label>
        <div class="control" id="wrap-password">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="input-icon">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <input
            id="password" name="password"
            type="password"
            placeholder="••••••••"
            autocomplete="new-password"
            maxlength="30"
            required
            aria-describedby="pwd-msg"
          />
          <button type="button" class="toggle toggle-pwd" aria-label="Mostrar contraseña" aria-pressed="false" data-target="password">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye-icon">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        </div>
        <div id="pwd-msg" class="msg" aria-live="polite"></div>
      </div>

      <div class="field">
        <label for="confirm_password">Confirmar Contraseña</label>
        <div class="control" id="wrap-confirm">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="input-icon">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <input
            id="confirm_password" name="confirm_password"
            type="password"
            placeholder="••••••••"
            autocomplete="new-password"
            maxlength="30"
            required
            aria-describedby="confirm-msg"
          />
          <button type="button" class="toggle toggle-pwd" aria-label="Mostrar contraseña" aria-pressed="false" data-target="confirm_password">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye-icon">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        </div>
        <div id="confirm-msg" class="msg" aria-live="polite"></div>
      </div>
 
      <button id="btn-submit" type="submit" class="btn">Guardar Contraseña</button>
    </form>
 
    <p class="foot">© <%= new Date().getFullYear() %> BYGGER SRL · Todos los derechos reservados.</p>
  </main>
 
  <script>
    const $ = s => document.querySelector(s);
    const $$ = s => document.querySelectorAll(s);
 
    const form   = $('#login-form');
    const pwd    = $('#password');
    const confirm = $('#confirm_password');
    const btn    = $('#btn-submit');
    const wrapPW = $('#wrap-password');
    const wrapConfirm = $('#wrap-confirm');
    const msgPW  = $('#pwd-msg');
    const msgConfirm  = $('#confirm-msg');
    const toggles = $$('.toggle-pwd');
 
    let submitted = false;
 
    pwd.addEventListener('input', () => { if (submitted) validatePwd(); });
    confirm.addEventListener('input', () => { if (submitted) validateConfirm(); });
 
    // --- Toggle "ojito" ---
    toggles.forEach(toggle => {
      toggle.addEventListener('click', function() {
        const targetId = this.getAttribute('data-target');
        const input = $('#' + targetId);
        const show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        this.setAttribute('aria-pressed', String(show));
        this.setAttribute('aria-label', show ? 'Ocultar contraseña' : 'Mostrar contraseña');
        
        if (show) {
          this.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye-icon">
              <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
              <line x1="1" y1="1" x2="23" y2="23"></line>
            </svg>
          `;
        } else {
          this.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye-icon">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          `;
        }
      });
    });
 
    // --- Validaciones visuales ---
    function setErr(ctrlEl, msgEl, text){
      ctrlEl.classList.add('error');
      msgEl.textContent = text;
      msgEl.classList.add('error');
    }
    function clearErr(ctrlEl, msgEl){
      ctrlEl.classList.remove('error');
      msgEl.textContent = '';
      msgEl.classList.remove('error');
    }
 
    function validatePwd(){
      const v = pwd.value;
      if(!v){
        setErr(wrapPW, msgPW, 'La contraseña es requerida.');
        return false;
      }
      if(v === '12345678'){
        setErr(wrapPW, msgPW, 'No puedes usar la misma contraseña temporal.');
        return false;
      }
      if(v.length < 6){
        setErr(wrapPW, msgPW, 'La contraseña debe tener al menos 6 caracteres.');
        return false;
      }
      if(!/[a-zA-Z]/.test(v)){
        setErr(wrapPW, msgPW, 'La contraseña debe contener al menos una letra.');
        return false;
      }
      if(!/[0-9]/.test(v)){
        setErr(wrapPW, msgPW, 'La contraseña debe contener al menos un número.');
        return false;
      }
      if(!/[^a-zA-Z0-9]/.test(v)){
        setErr(wrapPW, msgPW, 'La contraseña debe contener al menos un carácter especial (@, #, $, *, !, .).');
        return false;
      }
      clearErr(wrapPW, msgPW);
      return true;
    }

    function validateConfirm(){
      const v1 = pwd.value;
      const v2 = confirm.value;
      if(!v2){
        setErr(wrapConfirm, msgConfirm, 'Debes confirmar la contraseña.');
        return false;
      }
      if(v1 !== v2){
        setErr(wrapConfirm, msgConfirm, 'Las contraseñas no coinciden.');
        return false;
      }
      clearErr(wrapConfirm, msgConfirm);
      return true;
    }
 
    form.addEventListener('submit', (e) => {
      submitted = true;
      const isPwdValid = validatePwd();
      const isConfirmValid = validateConfirm();
      
      if(!isPwdValid || !isConfirmValid){
        e.preventDefault();
        return;
      }
      
      btn.disabled = true;
      btn.textContent = 'Guardando…';
    });
  </script>
</body>
</html>
