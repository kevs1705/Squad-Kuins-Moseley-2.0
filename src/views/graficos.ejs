<% pageTitle='Centro de Estadísticas y Gráficos BI' ;
  pageSubtitle='Tablero Ejecutivo de Rendimiento y Horas de Pasantías — BYGGER SRL' ; %>
  <%- include('partials/header') %>

    <!-- Chart.js 4.4 -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

    <style>
      /* ==========================================================================
     ESTILOS DASHBOARD EJECUTIVO BI — SISTEMA MONSELEY (LIGHT CORPORATIVO)
     ========================================================================== */
      :root {
        --bg-main: #F3F4F6;
        --bg-card: #FFFFFF;
        --color-primary: #0F5FA6;
        --color-primary-hover: #0D528F;
        --color-secondary: #0F5C8C;
        --color-accent: #0D9488;
        --color-accent-light: #E6FFFA;
        --color-text: #1E293B;
        --color-text-dark: #0F172A;
        --color-text-muted: #64748B;
        --color-border: #E2E8F0;
        --color-border-light: #F1F5F9;

        --bi-blue: #0F5FA6;
        --bi-teal: #0D9488;
        --bi-emerald: #10B981;
        --bi-indigo: #6366F1;
        --bi-amber: #F59E0B;
        --bi-amber-dark: #D97706;

        --radius-card: 16px;
        --radius-inner: 10px;
        --shadow-card: 0 4px 20px rgba(0, 0, 0, 0.04), 0 1px 3px rgba(0, 0, 0, 0.02);
        --shadow-hover: 0 10px 25px -5px rgba(0, 0, 0, 0.07);
      }

      /* Contenedor Principal */
      .bi-dashboard-container {
        width: 100%;
        margin: 0;
        padding: 0.5rem 0.25rem 3rem 0.25rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        box-sizing: border-box;
        color: var(--color-text);
      }

      /* Barra de Comando de Filtros */
      .bi-filter-bar {
        background: #FFFFFF;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-card);
        padding: 1.1rem 1.35rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        box-shadow: var(--shadow-card);
      }

      .bi-scope-tabs {
        display: inline-flex;
        background: #F1F5F9;
        border: 1px solid var(--color-border);
        padding: 4px;
        border-radius: 12px;
        gap: 4px;
      }

      .bi-scope-btn {
        background: transparent;
        border: none;
        color: var(--color-text-muted);
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }

      .bi-scope-btn:hover {
        color: var(--color-primary);
        background: #E2E8F0;
      }

      .bi-scope-btn.active {
        background: var(--color-primary);
        color: #FFFFFF;
        box-shadow: 0 2px 8px rgba(15, 95, 166, 0.28);
      }

      .bi-filter-controls {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .bi-select-custom {
        background: #FFFFFF;
        color: var(--color-text-dark);
        border: 1.5px solid #CBD5E1;
        border-radius: 10px;
        padding: 8px 14px;
        font-size: 0.86rem;
        font-weight: 600;
        cursor: pointer;
        outline: none;
        min-width: 200px;
        transition: all 0.2s ease;
      }

      .bi-select-custom:focus {
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px rgba(15, 95, 166, 0.15);
      }

      .bi-period-pills {
        display: inline-flex;
        background: #F1F5F9;
        border: 1px solid var(--color-border);
        padding: 3px;
        border-radius: 10px;
        gap: 2px;
      }

      .bi-period-btn {
        background: transparent;
        border: none;
        color: var(--color-text-muted);
        padding: 6px 12px;
        border-radius: 7px;
        font-size: 0.78rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .bi-period-btn:hover {
        color: var(--color-primary);
      }

      .bi-period-btn.active {
        background: var(--color-primary);
        color: #FFFFFF;
        box-shadow: 0 2px 6px rgba(15, 95, 166, 0.25);
      }

      /* Toggle de Orden Ascendente / Descendente */
      .bi-order-toggle {
        display: inline-flex;
        background: #F1F5F9;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        padding: 3px;
        gap: 3px;
      }

      .bi-order-btn {
        background: transparent;
        border: none;
        color: var(--color-text-muted);
        font-size: 0.76rem;
        font-weight: 700;
        padding: 6px 12px;
        border-radius: 7px;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .bi-order-btn:hover {
        color: var(--color-primary);
      }

      .bi-order-btn.active {
        background: var(--color-primary);
        color: #FFFFFF;
        box-shadow: 0 2px 6px rgba(15, 95, 166, 0.25);
      }

      .bi-btn-refresh {
        background: #FFFFFF;
        border: 1.5px solid var(--color-primary);
        color: var(--color-primary);
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.82rem;
        padding: 7px 14px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
      }

      .bi-btn-refresh:hover {
        background: var(--color-primary);
        color: #FFFFFF;
        box-shadow: 0 2px 8px rgba(15, 95, 166, 0.25);
      }

      /* Tarjetas KPI Corporativas */
      .bi-kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.25rem;
        width: 100%;
      }

      .bi-kpi-card {
        background: #FFFFFF;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-card);
        padding: 1.25rem 1.4rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: var(--shadow-card);
        position: relative;
        overflow: hidden;
        transition: all 0.25s ease;
      }

      .bi-kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-hover);
        border-color: #CBD5E1;
      }

      /* Borde superior dinámico */
      .bi-kpi-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3.5px;
      }

      .bi-kpi-blue::before {
        background: linear-gradient(90deg, #0F5FA6, #0284C7);
      }

      .bi-kpi-teal::before {
        background: linear-gradient(90deg, #0D9488, #14B8A6);
      }

      .bi-kpi-emerald::before {
        background: linear-gradient(90deg, #10B981, #34D399);
      }

      .bi-kpi-indigo::before {
        background: linear-gradient(90deg, #6366F1, #8B5CF6);
      }

      .bi-kpi-amber::before {
        background: linear-gradient(90deg, #F59E0B, #EA580C);
      }

      .bi-kpi-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.75rem;
      }

      .bi-kpi-label {
        font-size: 0.76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: var(--color-text-muted);
      }

      .bi-kpi-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
      }

      .bi-icon-blue {
        background: #EFF6FF;
        color: var(--bi-blue);
      }

      .bi-icon-teal {
        background: #F0FDFA;
        color: var(--bi-teal);
      }

      .bi-icon-emerald {
        background: #F0FDF4;
        color: var(--bi-emerald);
      }

      .bi-icon-indigo {
        background: #EEF2FF;
        color: var(--bi-indigo);
      }

      .bi-icon-amber {
        background: #FFFBEB;
        color: var(--bi-amber-dark);
      }

      .bi-kpi-value {
        font-size: 2rem;
        font-weight: 800;
        line-height: 1.1;
        color: var(--color-text-dark);
        margin-bottom: 0.35rem;
        letter-spacing: -0.5px;
      }

      .bi-kpi-sub {
        font-size: 0.78rem;
        color: var(--color-text-muted);
        display: flex;
        align-items: center;
        gap: 6px;
      }

      /* Layout de Gráficos (Dashboard Grid) */
      .bi-charts-grid-main {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.25rem;
        width: 100%;
      }

      .bi-charts-grid-secondary {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
        width: 100%;
      }

      .bi-panel {
        background: #FFFFFF;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-card);
        padding: 1.4rem 1.5rem;
        box-shadow: var(--shadow-card);
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
      }

      .bi-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--color-border-light);
      }

      .bi-panel-title {
        margin: 0;
        font-size: 1.02rem;
        font-weight: 800;
        color: var(--color-text-dark);
        display: flex;
        align-items: center;
        gap: 10px;
        letter-spacing: -0.2px;
      }

      .bi-panel-tag {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 3px 9px;
        border-radius: 6px;
        background: #EFF6FF;
        color: var(--color-primary);
        border: 1px solid #BFDBFE;
      }

      /* Contenedores de Canvas */
      .bi-chart-canvas-wrap {
        position: relative;
        width: 100%;
        height: 320px;
      }

      .bi-chart-canvas-wrap-sm {
        position: relative;
        width: 100%;
        height: 250px;
      }

      /* Widgets de Gauge Donut con Porcentaje Central (Cuadrícula simétrica 2x2) */
      .bi-gauges-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.25rem 1rem;
        align-items: center;
        justify-content: center;
        padding: 0.75rem 0.5rem;
      }

      .bi-gauge-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        position: relative;
      }

      .bi-gauge-chart-box {
        position: relative;
        width: 105px;
        height: 105px;
      }

      .bi-gauge-center-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--color-text-dark);
        letter-spacing: -0.5px;
        line-height: 1;
      }

      .bi-gauge-label {
        font-size: 0.78rem;
        font-weight: 800;
        text-transform: uppercase;
        color: var(--color-text);
        margin-top: 8px;
        letter-spacing: 0.4px;
      }

      .bi-gauge-subtext {
        font-size: 0.74rem;
        color: var(--color-text-muted);
        font-weight: 600;
        margin-top: 2px;
      }

      .bi-quick-sort-btn {
        background: #F8FAFC;
        border: 1.5px solid #CBD5E1;
        color: #475569;
        font-size: 0.76rem;
        font-weight: 700;
        padding: 6px 12px;
        border-radius: 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
      }

      .bi-quick-sort-btn:hover {
        background: #F1F5F9;
        border-color: var(--color-primary);
        color: var(--color-primary);
      }

      /* Botón de Exportar a Excel (Verde Corporativo) */
      .bi-excel-btn {
        background: #16A34A;
        background: linear-gradient(135deg, #16A34A, #15803D);
        color: #FFFFFF !important;
        border: 1px solid #15803D;
        font-size: 0.76rem;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
        box-shadow: 0 2px 6px rgba(22, 163, 74, 0.25);
        text-decoration: none;
      }

      .bi-excel-btn:hover {
        background: linear-gradient(135deg, #15803D, #166534);
        transform: translateY(-1px);
        box-shadow: 0 4px 10px rgba(22, 163, 74, 0.35);
        color: #FFFFFF !important;
      }

      .bi-excel-btn:active {
        transform: translateY(0);
      }

      /* Dropdown / Botón de Filtro por Carrera */
      .bi-filter-btn-wrap {
        position: relative;
        display: inline-flex;
        align-items: center;
      }

      .bi-filter-btn-select {
        background: #FFFFFF;
        border: 1.5px solid #CBD5E1;
        color: #334155;
        font-size: 0.76rem;
        font-weight: 700;
        padding: 6px 28px 6px 30px;
        border-radius: 8px;
        cursor: pointer;
        outline: none;
        appearance: none;
        -webkit-appearance: none;
        transition: all 0.2s ease;
        max-width: 200px;
      }

      .bi-filter-btn-select:hover,
      .bi-filter-btn-select:focus {
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px rgba(15, 95, 166, 0.12);
      }

      .bi-filter-btn-icon-left {
        position: absolute;
        left: 10px;
        pointer-events: none;
        color: var(--color-primary);
        font-size: 0.85rem;
      }

      .bi-filter-btn-icon-right {
        position: absolute;
        right: 9px;
        pointer-events: none;
        color: #64748B;
        font-size: 0.72rem;
      }

      /* Badge contador de registros en cabecera */
      .bi-panel-tag-count {
        background: #EFF6FF;
        border: 1.5px solid #BFDBFE;
        color: #0F5FA6;
        font-size: 0.72rem;
        font-weight: 800;
        padding: 6px 12px;
        border-radius: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
      }

      /* Barras de Progreso en Flecha (Arrow Bars) */
      .bi-arrow-bars-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 0.5rem;
      }

      .bi-arrow-row {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .bi-arrow-name {
        width: 140px;
        font-size: 0.84rem;
        font-weight: 700;
        color: var(--color-text-dark);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: flex;
        flex-direction: column;
      }

      .bi-arrow-career {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--color-text-muted);
      }

      .bi-arrow-bar-wrap {
        flex: 1;
        height: 32px;
        background: #F1F5F9;
        border-radius: 8px;
        position: relative;
        overflow: hidden;
        border: 1px solid var(--color-border);
        display: flex;
        align-items: center;
      }

      .bi-arrow-bar-fill {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding-right: 12px;
        font-weight: 800;
        font-size: 0.85rem;
        color: #FFFFFF;
        transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        clip-path: polygon(0% 0%, calc(100% - 12px) 0%, 100% 50%, calc(100% - 12px) 100%, 0% 100%);
      }

      /* Gradientes corporativos sobrios para las barras de progreso */
      .fill-monseley-blue {
        background: linear-gradient(90deg, #0F5FA6, #0284C7);
      }

      .fill-teal-corp {
        background: linear-gradient(90deg, #0D9488, #14B8A6);
      }

      .fill-indigo-corp {
        background: linear-gradient(90deg, #4F46E5, #6366F1);
      }

      .fill-emerald-corp {
        background: linear-gradient(90deg, #059669, #10B981);
      }

      .fill-amber-corp {
        background: linear-gradient(90deg, #D97706, #F59E0B);
      }

      /* Ficha de Perfil de Estudiante */
      .bi-student-profile-card {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 1.25rem 1.5rem;
        background: #F8FAFC;
        border: 1.5px solid #BFDBFE;
        border-radius: var(--radius-card);
        margin-bottom: 1.25rem;
        box-shadow: 0 4px 15px rgba(15, 95, 166, 0.05);
      }

      .bi-student-avatar {
        width: 60px;
        height: 60px;
        border-radius: 14px;
        background: linear-gradient(135deg, #0F5FA6, #0284C7);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
        color: #FFFFFF;
        flex-shrink: 0;
        box-shadow: 0 4px 12px rgba(15, 95, 166, 0.25);
      }

      .bi-student-details {
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex: 1;
      }

      .bi-student-name {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--color-text-dark);
        margin: 0;
      }

      .bi-student-meta {
        font-size: 0.82rem;
        color: var(--color-text-muted);
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .bi-student-meta span {
        display: inline-flex;
        align-items: center;
        gap: 5px;
      }

      /* Tabla de Auditoría Rápida — Estilo Ejecutivo Monseley */
      .bi-table-wrap {
        width: 100%;
        overflow-x: auto;
        border-radius: 12px;
        border: 1px solid var(--color-border);
        background: #FFFFFF;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }

      .bi-summary-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }

      .bi-summary-table th {
        background: #F8FAFC;
        color: #475569;
        padding: 13px 18px;
        text-transform: uppercase;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        border-bottom: 2px solid var(--color-border);
        text-align: left;
        white-space: nowrap;
      }

      .bi-summary-table td {
        padding: 12px 18px;
        border-bottom: 1px solid var(--color-border-light);
        vertical-align: middle;
        color: #334155;
        white-space: nowrap;
        font-weight: 400;
      }

      .bi-summary-table tr:hover td {
        background: #F8FAFC;
      }

      .bi-summary-table tr:last-child td {
        border-bottom: none;
      }

      .bi-table-name {
        color: #0F172A;
        font-weight: 600;
        font-size: 0.86rem;
        letter-spacing: -0.1px;
      }

      .bi-table-subinfo {
        font-size: 0.73rem;
        color: #64748B;
        font-weight: 400;
        margin-top: 3px;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
      }

      .bi-table-career-badge {
        background: #EFF6FF;
        color: #0F5FA6;
        border: 1px solid #BFDBFE;
        padding: 2px 8px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.72rem;
        letter-spacing: 0.2px;
        display: inline-block;
      }

      .bi-table-presencial {
        color: #475569;
        font-weight: 500;
      }

      .bi-table-teletrabajo {
        color: #4F46E5;
        font-weight: 500;
      }

      .bi-table-extras {
        color: #D97706;
        font-weight: 600;
      }

      .bi-table-total {
        color: #0F5FA6;
        font-weight: 600;
        font-size: 0.88rem;
      }

      .bi-table-prog-text {
        font-size: 0.71rem;
        color: #64748B;
        font-weight: 500;
        margin-top: 3px;
        display: block;
      }

      @media (max-width: 1024px) {
        .bi-charts-grid-main {
          grid-template-columns: 1fr;
        }

        .bi-charts-grid-secondary {
          grid-template-columns: 1fr;
        }
      }
    </style>

    <div class="bi-dashboard-container">

      <!-- 1. BARRA DE COMANDO Y FILTROS INTEGRADOS -->
      <div class="bi-filter-bar">
        <div class="d-flex align-items-center gap-3 flex-wrap">
          <!-- Filtro de Modo Principal (General, Carrera, Estudiante) -->
          <div class="bi-scope-tabs" role="tablist">
            <button type="button" class="bi-scope-btn active" data-mode="general">
              <i class="bi bi-globe"></i> En General
            </button>
            <button type="button" class="bi-scope-btn" data-mode="carrera">
              <i class="bi bi-mortarboard-fill"></i> Por Carrera
            </button>
            <button type="button" class="bi-scope-btn" data-mode="estudiante">
              <i class="bi bi-person-badge-fill"></i> Por Estudiante
            </button>
          </div>

          <!-- Selector Dinámico de Carrera (visible en modo carrera) -->
          <div id="wrapFiltroCarrera" style="display: none;">
            <select id="selectCarrera" class="bi-select-custom">
              <% (carreras || []).forEach(c=> { %>
                <option value="<%= c.id_carrera %>">
                  <%= c.nombre %>
                </option>
                <% }) %>
            </select>
          </div>

          <!-- Selector Dinámico de Estudiante (visible en modo estudiante) -->
          <div id="wrapFiltroEstudiante" style="display: none;">
            <select id="selectEstudiante" class="bi-select-custom" style="min-width: 260px;">
              <% (pasantes || []).forEach(p=> { %>
                <option value="<%= p.id_usuario %>">
                  <%= p.nombre_completo %> (<%= p.carrera_siglas || 'GEN' %>)
                </option>
                <% }) %>
            </select>
          </div>
        </div>

        <!-- Filtro de Período Temporal + Orden Ascendente/Descendente -->
        <div class="bi-filter-controls">
          <div class="bi-period-pills">
            <button type="button" class="bi-period-btn active" data-period="all">Histórico</button>
            <button type="button" class="bi-period-btn" data-period="mes">Este Mes</button>
            <button type="button" class="bi-period-btn" data-period="trimestre">3 Meses</button>
            <button type="button" class="bi-period-btn" data-period="anio">Este Año</button>
          </div>

          <!-- Filtro Ascendente / Descendente -->
          <div class="bi-order-toggle" role="group" aria-label="Orden de Datos">
            <button type="button" class="bi-order-btn active" data-order="desc" id="btnOrderDesc"
              title="Ordenar de mayor a menor">
              <i class="bi bi-sort-numeric-down-alt"></i> Mayor a menor
            </button>
            <button type="button" class="bi-order-btn" data-order="asc" id="btnOrderAsc"
              title="Ordenar de menor a mayor">
              <i class="bi bi-sort-numeric-up"></i> Menor a mayor
            </button>
          </div>

          <button type="button" id="btnActualizarData" class="bi-btn-refresh">
            <i class="bi bi-arrow-clockwise"></i> Actualizar
          </button>
        </div>
      </div>

      <!-- Ficha de Perfil de Estudiante (Se inyecta dinámicamente si está en modo estudiante) -->
      <div id="studentProfileContainer" style="display: none;"></div>

      <!-- 2. TARJETAS KPI CORPORATIVAS SUPERIORES -->
      <div class="bi-kpi-grid">
        <!-- KPI 1: Pasantes -->
        <div class="bi-kpi-card bi-kpi-blue">
          <div class="bi-kpi-header">
            <span class="bi-kpi-label">Pasantes en Alcance</span>
            <div class="bi-kpi-icon bi-icon-blue"><i class="bi bi-people-fill"></i></div>
          </div>
          <div class="bi-kpi-value" id="kpiTotalPasantes">0</div>
          <div class="bi-kpi-sub">
            <i class="bi bi-check2-circle text-primary"></i> <span id="kpiSubPasantes">Total registrados</span>
          </div>
        </div>

        <!-- KPI 2: Total Horas -->
        <div class="bi-kpi-card bi-kpi-teal">
          <div class="bi-kpi-header">
            <span class="bi-kpi-label">Horas Certificadas</span>
            <div class="bi-kpi-icon bi-icon-teal"><i class="bi bi-clock-history"></i></div>
          </div>
          <div class="bi-kpi-value" id="kpiTotalHoras">0.0 <span
              style="font-size: 1rem; color: var(--bi-teal); font-weight: 700;">hrs</span></div>
          <div class="bi-kpi-sub">
            <i class="bi bi-speedometer2 text-secondary"></i> Promedio: <b id="kpiPromedioHoras"
              class="text-dark">0.0</b> hrs/est.
          </div>
        </div>

        <!-- KPI 3: Cumplimiento de Meta -->
        <div class="bi-kpi-card bi-kpi-emerald">
          <div class="bi-kpi-header">
            <span class="bi-kpi-label">Avance Global Meta</span>
            <div class="bi-kpi-icon bi-icon-emerald"><i class="bi bi-bullseye"></i></div>
          </div>
          <div class="bi-kpi-value" id="kpiCumplimiento">0%</div>
          <div class="bi-kpi-sub">
            <i class="bi bi-award-fill text-success"></i> Base meta: 280 hrs/pasante
          </div>
        </div>

        <!-- KPI 4: Teletrabajo vs Presencial -->
        <div class="bi-kpi-card bi-kpi-indigo">
          <div class="bi-kpi-header">
            <span class="bi-kpi-label">Modalidad Asistencia</span>
            <div class="bi-kpi-icon bi-icon-indigo"><i class="bi bi-laptop"></i></div>
          </div>
          <div class="bi-kpi-value" id="kpiHorasTeletrabajo">0.0 <span
              style="font-size: 1rem; color: var(--bi-indigo); font-weight: 700;">hrs rem.</span></div>
          <div class="bi-kpi-sub">
            Pres: <b id="kpiHorasPresencial" class="text-dark">0.0</b>h · Extras: <b id="kpiHorasExtrasVal"
              style="color: var(--bi-amber-dark);">0.0</b>h
          </div>
        </div>

        <!-- KPI 5: Carrera Líder -->
        <div class="bi-kpi-card bi-kpi-amber">
          <div class="bi-kpi-header">
            <span class="bi-kpi-label">Carrera Líder</span>
            <div class="bi-kpi-icon bi-icon-amber"><i class="bi bi-trophy-fill"></i></div>
          </div>
          <div class="bi-kpi-value" id="kpiCarreraLider" style="font-size: 1.45rem; line-height: 1.3;">-</div>
          <div class="bi-kpi-sub">
            Mayor volumen de horas acumuladas
          </div>
        </div>
      </div>

      <!-- 3. BLOQUE PRINCIPAL DE GRÁFICOS: TENDENCIA TEMPORAL + GAUGES CIRCULARES -->
      <div class="bi-charts-grid-main">

        <!-- Gráfico 1: Evolución Temporal y Tendencia Semanal -->
        <div class="bi-panel">
          <div class="bi-panel-header">
            <div class="bi-panel-title">
              <i class="bi bi-graph-up text-primary"></i>
              <span>Tendencia Temporal de Horas y Acumulativo</span>
            </div>
            <span class="bi-panel-tag">Línea de Tiempo</span>
          </div>
          <div class="bi-chart-canvas-wrap">
            <canvas id="chartTendenciaTemporal"></canvas>
          </div>
        </div>

        <!-- Gráfico 2: Donut Gauges con Porcentaje Central -->
        <div class="bi-panel">
          <div class="bi-panel-header">
            <div class="bi-panel-title">
              <i class="bi bi-pie-chart-fill text-warning"></i>
              <span>Medidores de Eficiencia</span>
            </div>
            <span class="bi-panel-tag"
              style="color: var(--bi-teal); border-color: #99F6E4; background: #F0FDFA;">Gauges</span>
          </div>

          <div class="bi-gauges-container">
            <!-- Gauge 1: Meta -->
            <div class="bi-gauge-item">
              <div class="bi-gauge-chart-box">
                <canvas id="gaugeMeta"></canvas>
                <div class="bi-gauge-center-text" id="gaugeMetaVal">0%</div>
              </div>
              <div class="bi-gauge-label">Meta Pasantía</div>
              <div class="bi-gauge-subtext">Meta 280 hrs</div>
            </div>

            <!-- Gauge 2: Presencial -->
            <div class="bi-gauge-item">
              <div class="bi-gauge-chart-box">
                <canvas id="gaugePresencial"></canvas>
                <div class="bi-gauge-center-text" id="gaugePresencialVal">0%</div>
              </div>
              <div class="bi-gauge-label">Presencial</div>
              <div class="bi-gauge-subtext" id="gaugePresencialHrs">0 hrs</div>
            </div>

            <!-- Gauge 3: Remoto -->
            <div class="bi-gauge-item">
              <div class="bi-gauge-chart-box">
                <canvas id="gaugeRemoto"></canvas>
                <div class="bi-gauge-center-text" id="gaugeRemotoVal">0%</div>
              </div>
              <div class="bi-gauge-label">Teletrabajo</div>
              <div class="bi-gauge-subtext" id="gaugeRemotoHrs">0 hrs</div>
            </div>

            <!-- Gauge 4: Horas Extras -->
            <div class="bi-gauge-item">
              <div class="bi-gauge-chart-box">
                <canvas id="gaugeExtra"></canvas>
                <div class="bi-gauge-center-text" id="gaugeExtraVal">0%</div>
              </div>
              <div class="bi-gauge-label">Horas Extras</div>
              <div class="bi-gauge-subtext" id="gaugeExtraHrs">0 hrs</div>
            </div>
          </div>
        </div>

      </div>

      <!-- 4. BLOQUE SECUNDARIO: DISTRIBUCIÓN POR CARRERA + RANKING EN FLECHAS -->
      <div class="bi-charts-grid-secondary">

        <!-- Gráfico 3: Distribución por Carrera (Barras Verticales) -->
        <div class="bi-panel">
          <div class="bi-panel-header">
            <div class="bi-panel-title">
              <i class="bi bi-bar-chart-fill text-success"></i>
              <span>Distribución de Horas por Carrera</span>
            </div>
            <span class="bi-panel-tag"
              style="color: var(--bi-indigo); border-color: #C7D2FE; background: #EEF2FF;">Carreras</span>
          </div>
          <div class="bi-chart-canvas-wrap-sm">
            <canvas id="chartPorCarrera"></canvas>
          </div>
        </div>

        <!-- Gráfico 4: Ranking y Avance de Pasantes (Barras Flecha) -->
        <div class="bi-panel">
          <div class="bi-panel-header">
            <div class="bi-panel-title">
              <i class="bi bi-lightning-charge-fill text-primary"></i>
              <span id="rankingPanelTitle">Líderes de Rendimiento y Avance</span>
            </div>
            <div class="d-flex align-items-center gap-2">
              <button type="button" class="bi-quick-sort-btn" id="btnToggleRankingSort"
                title="Alternar Ascendente / Descendente">
                <i class="bi bi-arrow-down-up" id="sortRankingIcon"></i> <span id="sortRankingLabel">Descendente</span>
              </button>
              <span class="bi-panel-tag" id="rankingBadgeTag"
                style="color: var(--bi-amber-dark); border-color: #FDE68A; background: #FEF3C7;">Top Ranking</span>
            </div>
          </div>

          <div class="bi-arrow-bars-list" id="rankingArrowList">
            <!-- Render dinámico de las flechas de porcentaje -->
          </div>
        </div>

      </div>

      <!-- 5. TABLA RESUMEN EN ANCHO COMPLETO HORIZONTAL -->
      <div class="bi-panel" style="width: 100%;">
        <div class="bi-panel-header" style="align-items: center; margin-bottom: 1rem; padding-bottom: 0.85rem; flex-wrap: wrap; gap: 0.75rem;">
          <div class="bi-panel-title" style="white-space: nowrap;">
            <span id="tablaResumenTitle"
              style="font-size: 1.15rem; font-weight: 800; color: #0F172A; letter-spacing: -0.2px;">Detalle Rápido de Pasantes</span>
          </div>
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <!-- 1. Filtro Dinámico por Rendimiento (< 100 hrs, Por acabar, etc.) -->
            <div class="bi-filter-btn-wrap" title="Filtrar por rendimiento / estado">
              <i class="bi bi-funnel bi-filter-btn-icon-left text-primary"></i>
              <select id="filtroTablaRendimiento" class="bi-filter-btn-select" style="max-width: 220px;">
                <option value="todos">Todos los rendimientos</option>
                <option value="menos_100">Menor a 100 hrs (Contactar)</option>
                <option value="por_acabar">Por acabar (≥ 200 hrs)</option>
                <option value="completado">Meta cumplida (≥ 280 hrs)</option>
              </select>
              <i class="bi bi-chevron-down bi-filter-btn-icon-right"></i>
            </div>

            <!-- 2. Botón / Selector de Filtro por Carrera -->
            <div class="bi-filter-btn-wrap" title="Filtrar por carrera">
              <i class="bi bi-funnel-fill bi-filter-btn-icon-left"></i>
              <select id="filtroTablaCarrera" class="bi-filter-btn-select">
                <option value="">Todas las carreras</option>
                <% (carreras || []).forEach(c => { %>
                  <option value="<%= c.id_carrera %>"><%= c.nombre %></option>
                <% }) %>
              </select>
              <i class="bi bi-chevron-down bi-filter-btn-icon-right"></i>
            </div>

            <!-- 3. Botón Exportar a Excel -->
            <button type="button" class="bi-excel-btn" id="btnExportarPasantesExcel" title="Exportar Detalle de Pasantes a Excel (.xlsx) con los filtros activos">
              <i class="bi bi-file-earmark-excel-fill"></i>
              <span>Exportar a Excel</span>
            </button>

            <!-- 4. Botón Alternar Orden -->
            <button type="button" class="bi-quick-sort-btn" id="btnToggleTableSort"
              title="Alternar Ascendente / Descendente">
              <i class="bi bi-arrow-down-up" id="sortTableIcon"></i> <span id="sortTableLabel">Descendente</span>
            </button>

            <!-- 5. Badge Contador de Pasantes -->
            <span class="bi-panel-tag-count" id="tablaBadgeCount">0 PASANTES</span>
          </div>
        </div>

        <div class="bi-table-wrap">
          <table class="bi-summary-table">
            <thead>
              <tr>
                <th>Pasante</th>
                <th>Carrera</th>
                <th>Presencial</th>
                <th>Teletrabajo</th>
                <th>Horas Extras</th>
                <th>Total</th>
                <th>Progreso (Meta 280 hrs)</th>
              </tr>
            </thead>
            <tbody id="tablaResumenBody">
              <!-- Renderizado dinámico -->
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <script>
      // ==========================================================================
      // LÓGICA FRONTEND DASHBOARD BI SISTEMA MONSELEY (LIGHT CORPORATIVO)
      // ==========================================================================
      document.addEventListener('DOMContentLoaded', () => {

        // Paleta Corporativa Monseley
        const CORP = {
          blue: '#0F5FA6',
          blueHover: '#0D528F',
          teal: '#0D9488',
          emerald: '#10B981',
          indigo: '#6366F1',
          amber: '#F59E0B',
          amberDark: '#D97706',
          trackColor: '#E2E8F0',
          gridColor: '#F1F5F9',
          textDark: '#0F172A',
          textMuted: '#64748B'
        };

        // Estado local de los filtros
        let currentMode = 'general'; // 'general' | 'carrera' | 'estudiante'
        let currentPeriod = 'all';  // 'all' | 'mes' | 'trimestre' | 'anio'
        let currentOrder = 'desc';  // 'desc' | 'asc'

        // Elementos DOM
        const scopeBtns = document.querySelectorAll('.bi-scope-btn');
        const periodBtns = document.querySelectorAll('.bi-period-btn');
        const orderBtns = document.querySelectorAll('.bi-order-btn');
        const wrapCarrera = document.getElementById('wrapFiltroCarrera');
        const wrapEstudiante = document.getElementById('wrapFiltroEstudiante');
        const selectCarrera = document.getElementById('selectCarrera');
        const selectEstudiante = document.getElementById('selectEstudiante');
        const btnActualizar = document.getElementById('btnActualizarData');
        const studentProfileContainer = document.getElementById('studentProfileContainer');
        const btnToggleRankingSort = document.getElementById('btnToggleRankingSort');
        const btnToggleTableSort = document.getElementById('btnToggleTableSort');
        const sortRankingLabel = document.getElementById('sortRankingLabel');
        const sortTableLabel = document.getElementById('sortTableLabel');
        const rankingPanelTitle = document.getElementById('rankingPanelTitle');
        const rankingBadgeTag = document.getElementById('rankingBadgeTag');
        const filtroTablaRendimiento = document.getElementById('filtroTablaRendimiento');
        const filtroTablaCarrera = document.getElementById('filtroTablaCarrera');
        const btnExportarPasantesExcel = document.getElementById('btnExportarPasantesExcel');

        // Instancias de Chart.js
        let chartTendencia = null;
        let chartCarrera = null;
        let gaugeMetaChart = null;
        let gaugePresencialChart = null;
        let gaugeRemotoChart = null;
        let gaugeExtraChart = null;

        // Helper: Crear Donut Gauge con porcentaje y pista clara
        function initGauge(canvasId, color) {
          const ctx = document.getElementById(canvasId).getContext('2d');
          return new Chart(ctx, {
            type: 'doughnut',
            data: {
              datasets: [{
                data: [0, 100],
                backgroundColor: [color, CORP.trackColor],
                borderWidth: 0,
                circumference: 360,
                rotation: 0
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              cutout: '78%',
              plugins: {
                tooltip: { enabled: false },
                legend: { display: false }
              },
              animation: { animateRotate: true, duration: 800 }
            }
          });
        }

        function updateGauge(chartInstance, valElementId, percent, color) {
          if (!chartInstance) return;
          const safePct = Math.max(0, Math.min(100, Math.round(percent || 0)));
          chartInstance.data.datasets[0].data = [safePct, 100 - safePct];
          chartInstance.data.datasets[0].backgroundColor = [color, CORP.trackColor];
          chartInstance.update();
          const el = document.getElementById(valElementId);
          if (el) el.textContent = `${safePct}%`;
        }

        // Inicializar Gauges (4 medidores en cuadrícula 2x2)
        gaugeMetaChart = initGauge('gaugeMeta', CORP.emerald);
        gaugePresencialChart = initGauge('gaugePresencial', CORP.blue);
        gaugeRemotoChart = initGauge('gaugeRemoto', CORP.indigo);
        gaugeExtraChart = initGauge('gaugeExtra', CORP.amber);

        // ==========================================
        // FUNCIÓN PRINCIPAL DE CARGA DE ANALÍTICA
        // ==========================================
        async function fetchAnalytics() {
          const carreraId = (currentMode === 'carrera') ? (selectCarrera.value || (filtroTablaCarrera ? filtroTablaCarrera.value : '')) : (filtroTablaCarrera ? filtroTablaCarrera.value : '');
          const estudianteId = selectEstudiante.value;
          const rendVal = filtroTablaRendimiento ? filtroTablaRendimiento.value : 'todos';

          let url = `/api/graficos/analytics?modo=${currentMode}&periodo=${currentPeriod}&orden=${currentOrder}&filtroRendimiento=${encodeURIComponent(rendVal)}`;
          if (currentMode === 'carrera' && carreraId) url += `&carreraId=${encodeURIComponent(carreraId)}`;
          if (currentMode === 'estudiante' && estudianteId) url += `&estudianteId=${encodeURIComponent(estudianteId)}`;

          try {
            const res = await fetch(url);
            const data = await res.json();
            if (!data.ok) return;

            renderDashboard(data);
          } catch (err) {
            console.error('Error al obtener datos analíticos:', err);
          }
        }

        // ==========================================
        // RENDERIZADO DEL DASHBOARD Y WIDGETS
        // ==========================================
        function renderDashboard(data) {
          const { kpis, seriesTemporal, porCarrera, rankingEstudiantes, estudiantePerfil } = data;

          // 1. Actualizar KPIs
          document.getElementById('kpiTotalPasantes').textContent = kpis.totalPasantes || 0;
          document.getElementById('kpiTotalHoras').innerHTML = `${kpis.totalHoras || 0} <span style="font-size: 1rem; color: var(--bi-teal); font-weight: 700;">hrs</span>`;
          document.getElementById('kpiPromedioHoras').textContent = kpis.promedioHoras || 0;
          document.getElementById('kpiCumplimiento').textContent = `${kpis.tasaCumplimiento || 0}%`;
          document.getElementById('kpiHorasTeletrabajo').innerHTML = `${kpis.horasTeletrabajo || 0} <span style="font-size: 1rem; color: var(--bi-indigo); font-weight: 700;">hrs rem.</span>`;
          document.getElementById('kpiHorasPresencial').textContent = kpis.horasPresencial || 0;
          const elExtras = document.getElementById('kpiHorasExtrasVal');
          if (elExtras) elExtras.textContent = `${kpis.horasExtra || 0}`;
          document.getElementById('kpiCarreraLider').textContent = kpis.carreraLider || 'En curso';

          // 2. Gauges Circulares con Porcentajes (4 Gauges)
          updateGauge(gaugeMetaChart, 'gaugeMetaVal', kpis.tasaCumplimiento, CORP.emerald);

          const totalH = (kpis.horasPresencial || 0) + (kpis.horasTeletrabajo || 0) + (kpis.horasExtra || 0);
          const pctPresencial = totalH > 0 ? (kpis.horasPresencial / totalH) * 100 : 0;
          const pctRemoto = totalH > 0 ? (kpis.horasTeletrabajo / totalH) * 100 : 0;
          const pctExtra = totalH > 0 ? (kpis.horasExtra / totalH) * 100 : 0;

          updateGauge(gaugePresencialChart, 'gaugePresencialVal', pctPresencial, CORP.blue);
          updateGauge(gaugeRemotoChart, 'gaugeRemotoVal', pctRemoto, CORP.indigo);
          updateGauge(gaugeExtraChart, 'gaugeExtraVal', pctExtra, CORP.amber);

          const elPresHrs = document.getElementById('gaugePresencialHrs');
          if (elPresHrs) elPresHrs.textContent = `${kpis.horasPresencial || 0} hrs`;
          const elRemHrs = document.getElementById('gaugeRemotoHrs');
          if (elRemHrs) elRemHrs.textContent = `${kpis.horasTeletrabajo || 0} hrs`;
          const elExtHrs = document.getElementById('gaugeExtraHrs');
          if (elExtHrs) elExtHrs.textContent = `${kpis.horasExtra || 0} hrs`;

          // 3. Ficha de Estudiante (si corresponde)
          if (estudiantePerfil && currentMode === 'estudiante') {
            studentProfileContainer.style.display = 'block';
            studentProfileContainer.innerHTML = `
          <div class="bi-student-profile-card">
            <div class="bi-student-avatar"><i class="bi bi-person-fill"></i></div>
            <div class="bi-student-details">
              <h3 class="bi-student-name">${estudiantePerfil.nombre}</h3>
              <div class="bi-student-meta">
                <span><i class="bi bi-mortarboard text-primary"></i> ${estudiantePerfil.carrera} (${estudiantePerfil.carrera_siglas})</span>
                <span><i class="bi bi-card-text text-secondary"></i> CI: ${estudiantePerfil.ci || 'S/N'}</span>
                <span><i class="bi bi-building text-success"></i> ${estudiantePerfil.universidad}</span>
                <span><i class="bi bi-calendar-event text-danger"></i> Inicio: ${estudiantePerfil.fecha_inicio}</span>
                <span class="mt-1 d-inline-flex gap-2">
                  <span style="color: var(--bi-blue); font-weight: 700; background: #EFF6FF; padding: 2px 8px; border-radius: 6px; border: 1px solid #BFDBFE;">Pres: ${estudiantePerfil.horas_presencial} hrs</span>
                  <span style="color: var(--bi-indigo); font-weight: 700; background: #EEF2FF; padding: 2px 8px; border-radius: 6px; border: 1px solid #C7D2FE;">Tele: ${estudiantePerfil.horas_teletrabajo} hrs</span>
                  <span style="color: var(--bi-amber-dark); font-weight: 700; background: #FFFBEB; padding: 2px 8px; border-radius: 6px; border: 1px solid #FDE68A;">Extras: ${estudiantePerfil.horas_extra} hrs</span>
                </span>
              </div>
            </div>
            <div style="text-align: right;">
              <span style="font-size: 0.8rem; color: var(--color-text-muted); text-transform: uppercase; font-weight: 700;">Progreso a 280 hrs</span>
              <div style="font-size: 1.8rem; font-weight: 800; color: var(--color-primary);">${estudiantePerfil.total_horas} <span style="font-size: 0.9rem; color: var(--color-text-muted);">/ 280 hrs</span></div>
              <small style="color: var(--bi-emerald); font-weight: 700;">Resta: ${estudiantePerfil.horas_restantes} hrs</small>
            </div>
          </div>
        `;
          } else {
            studentProfileContainer.style.display = 'none';
            studentProfileContainer.innerHTML = '';
          }

          // 4. Gráfico de Tendencia Temporal
          renderChartTendencia(seriesTemporal);

          // 5. Gráfico por Carrera
          renderChartCarrera(porCarrera);

          // 6. Ranking con Flechas
          renderRankingFlechas(rankingEstudiantes);

          // 7. Tabla Resumen / Auditoría Rápida (Ancho Completo)
          renderTablaResumen(rankingEstudiantes);
        }

        // ==========================================
        // RENDERIZADO DE CHART 1: TENDENCIA TEMPORAL
        // ==========================================
        function renderChartTendencia(series) {
          const canvas = document.getElementById('chartTendenciaTemporal');
          const ctx = canvas.getContext('2d');

          if (chartTendencia) chartTendencia.destroy();

          // Gradiente suave de azul Monseley
          const gradBlue = ctx.createLinearGradient(0, 0, 0, 300);
          gradBlue.addColorStop(0, 'rgba(15, 95, 166, 0.16)');
          gradBlue.addColorStop(1, 'rgba(15, 95, 166, 0.0)');

          chartTendencia = new Chart(ctx, {
            type: 'line',
            data: {
              labels: series.labels || [],
              datasets: [
                {
                  label: 'Horas Semanales',
                  data: series.horas || [],
                  borderColor: CORP.blue,
                  backgroundColor: gradBlue,
                  fill: true,
                  tension: 0.35,
                  borderWidth: 2.5,
                  pointBackgroundColor: CORP.blue,
                  pointBorderColor: '#FFFFFF',
                  pointBorderWidth: 2,
                  pointRadius: 4,
                  pointHoverRadius: 7
                },
                {
                  label: 'Horas Acumuladas',
                  data: series.acumulado || [],
                  borderColor: CORP.teal,
                  backgroundColor: 'transparent',
                  fill: false,
                  tension: 0.35,
                  borderWidth: 2,
                  borderDash: [5, 4],
                  pointBackgroundColor: CORP.teal,
                  pointBorderColor: '#FFFFFF',
                  pointRadius: 3,
                  pointHoverRadius: 6
                },
                {
                  label: 'Teletrabajo (hrs)',
                  data: series.teletrabajo || [],
                  borderColor: CORP.indigo,
                  backgroundColor: 'transparent',
                  borderWidth: 1.8,
                  pointBackgroundColor: CORP.indigo,
                  pointRadius: 2.5
                },
                {
                  label: 'Horas Extras (hrs)',
                  data: series.horas_extra || [],
                  borderColor: CORP.amber,
                  backgroundColor: 'transparent',
                  borderWidth: 1.8,
                  pointBackgroundColor: CORP.amber,
                  pointRadius: 2.5
                }
              ]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: {
                  labels: { color: '#334155', font: { weight: '600', size: 12 } }
                },
                tooltip: {
                  backgroundColor: '#0F172A',
                  titleColor: '#FFFFFF',
                  bodyColor: '#F8FAFC',
                  borderColor: '#E2E8F0',
                  borderWidth: 1,
                  padding: 12,
                  boxPadding: 4
                }
              },
              scales: {
                x: {
                  grid: { color: CORP.gridColor },
                  ticks: { color: CORP.textMuted, font: { size: 11 } }
                },
                y: {
                  grid: { color: CORP.gridColor },
                  ticks: { color: CORP.textMuted, font: { size: 11 } }
                }
              }
            }
          });
        }

        // ==========================================
        // RENDERIZADO DE CHART 2: POR CARRERA
        // ==========================================
        function renderChartCarrera(data) {
          const canvas = document.getElementById('chartPorCarrera');
          const ctx = canvas.getContext('2d');

          if (chartCarrera) chartCarrera.destroy();

          const colores = [CORP.blue, CORP.teal, '#0284C7', CORP.indigo, CORP.amber, CORP.emerald];

          chartCarrera = new Chart(ctx, {
            type: 'bar',
            data: {
              labels: data.labels || [],
              datasets: [{
                label: 'Horas Totales',
                data: data.horas || [],
                backgroundColor: colores.slice(0, (data.labels || []).length),
                borderRadius: 6,
                borderWidth: 0,
                maxBarThickness: 45
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: { display: false },
                tooltip: {
                  backgroundColor: '#0F172A',
                  titleColor: '#FFFFFF',
                  bodyColor: '#F8FAFC',
                  borderColor: '#E2E8F0',
                  borderWidth: 1,
                  padding: 10
                }
              },
              scales: {
                x: {
                  grid: { display: false },
                  ticks: { color: CORP.textMuted, font: { size: 11, weight: '600' } }
                },
                y: {
                  grid: { color: CORP.gridColor },
                  ticks: { color: CORP.textMuted, font: { size: 11 } }
                }
              }
            }
          });
        }

        // ==========================================
        // RENDERIZADO DE FLECHAS DE PROGRESO
        // ==========================================
        function renderRankingFlechas(estudiantes) {
          const container = document.getElementById('rankingArrowList');
          if (!container) return;

          // Actualizar título y tag según el orden
          if (currentOrder === 'asc') {
            if (rankingPanelTitle) rankingPanelTitle.textContent = 'Pasantes con Menor Avance (Ascendente)';
            if (rankingBadgeTag) {
              rankingBadgeTag.textContent = 'Menor Avance';
              rankingBadgeTag.style.color = 'var(--bi-amber-dark)';
              rankingBadgeTag.style.borderColor = '#FDE68A';
              rankingBadgeTag.style.background = '#FEF3C7';
            }
          } else {
            if (rankingPanelTitle) rankingPanelTitle.textContent = 'Líderes de Rendimiento y Avance';
            if (rankingBadgeTag) {
              rankingBadgeTag.textContent = 'Top Ranking';
              rankingBadgeTag.style.color = 'var(--color-primary)';
              rankingBadgeTag.style.borderColor = '#BFDBFE';
              rankingBadgeTag.style.background = '#EFF6FF';
            }
          }

          const top = (estudiantes || []).slice(0, 5);
          if (top.length === 0) {
            container.innerHTML = '<p class="text-muted text-center py-4">No hay pasantes con actividad en este rango.</p>';
            return;
          }

          const gradientClasses = [
            'fill-monseley-blue',
            'fill-teal-corp',
            'fill-indigo-corp',
            'fill-emerald-corp',
            'fill-amber-corp'
          ];

          container.innerHTML = top.map((est, idx) => {
            const fillClass = gradientClasses[idx % gradientClasses.length];
            const pct = Math.max(12, est.porcentaje); // Mínimo 12% para que quepa el texto de la flecha
            return `
          <div class="bi-arrow-row">
            <div class="bi-arrow-name">
              <span>${est.nombre}</span>
              <span class="bi-arrow-career">${est.carrera_siglas || 'PASANTE'} · ${est.horas} hrs</span>
            </div>
            <div class="bi-arrow-bar-wrap">
              <div class="bi-arrow-bar-fill ${fillClass}" style="width: ${pct}%;">
                ${est.porcentaje}%
              </div>
            </div>
          </div>
        `;
          }).join('');
        }

        // ==========================================
        // RENDERIZADO DE TABLA DE RESUMEN
        // ==========================================
        function renderTablaResumen(estudiantes) {
          const tbody = document.getElementById('tablaResumenBody');
          const badgeCount = document.getElementById('tablaBadgeCount');
          if (!tbody) return;

          const totalCount = (estudiantes || []).length;
          const rendVal = filtroTablaRendimiento ? filtroTablaRendimiento.value : 'todos';
          let tagSuffix = 'PASANTES';
          if (rendVal === 'menos_100') tagSuffix = '(< 100 HRS)';
          else if (rendVal === 'por_acabar') tagSuffix = '(POR ACABAR)';
          else if (rendVal === 'completado') tagSuffix = '(COMPLETADOS)';

          badgeCount.textContent = `${totalCount} ${tagSuffix}`;

          if (!estudiantes || estudiantes.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">Sin registros para mostrar con los filtros seleccionados</td></tr>';
            return;
          }

          tbody.innerHTML = estudiantes.map(e => {
            const isBajo = e.horas < 100;
            const isPorAcabar = e.horas >= 200 && e.horas < 280;
            const isMeta = e.horas >= 280;

            let badgeHtml = '';
            if (isBajo) {
              badgeHtml = `<span style="font-size: 0.68rem; font-weight: 600; color: #DC2626; background: #FEF2F2; border: 1px solid #FECACA; padding: 1px 6px; border-radius: 4px; margin-left: 6px;">Menor a 100 hrs</span>`;
            } else if (isPorAcabar) {
              badgeHtml = `<span style="font-size: 0.68rem; font-weight: 600; color: #0F5FA6; background: #EFF6FF; border: 1px solid #BFDBFE; padding: 1px 6px; border-radius: 4px; margin-left: 6px;">Por acabar</span>`;
            } else if (isMeta) {
              badgeHtml = `<span style="font-size: 0.68rem; font-weight: 600; color: #16A34A; background: #F0FDF4; border: 1px solid #BBF7D0; padding: 1px 6px; border-radius: 4px; margin-left: 6px;">Meta cumplida</span>`;
            }

            return `
        <tr ${isBajo ? 'style="background: #FFFDFD;"' : ''}>
          <td>
            <div style="display: flex; align-items: center; gap: 4px; flex-wrap: wrap;">
              <span class="bi-table-name">${e.nombre}</span>
              ${badgeHtml}
            </div>
            <div class="bi-table-subinfo">
              <span>CI: ${e.ci || 'S/N'}</span>
              <span>·</span>
              <span>Celular: <span style="color: ${isBajo ? '#DC2626; font-weight: 600;' : '#334155;'}">${e.celular || 'Sin registrar'}</span></span>
            </div>
          </td>
          <td><span class="bi-table-career-badge">${e.carrera_siglas || 'GEN'}</span></td>
          <td><span class="bi-table-presencial">${e.presencial} hrs</span></td>
          <td><span class="bi-table-teletrabajo">${e.teletrabajo} hrs</span></td>
          <td><span class="bi-table-extras">${e.horas_extra || 0} hrs</span></td>
          <td><span class="bi-table-total" style="${isBajo ? 'color: #DC2626;' : ''}">${e.horas} hrs</span></td>
          <td style="min-width: 140px;">
            <div style="background: #E2E8F0; height: 7px; border-radius: 4px; overflow: hidden;">
              <div style="width: ${e.porcentaje}%; height: 100%; background: ${isBajo ? 'linear-gradient(90deg, #EF4444, #F59E0B)' : 'linear-gradient(90deg, #0F5FA6, #0D9488)'}; border-radius: 4px;"></div>
            </div>
            <span class="bi-table-prog-text">${e.porcentaje}% de 280 hrs</span>
          </td>
        </tr>
      `;
          }).join('');
        }

        // Helper para alternar orden y sincronizar controles
        function setOrder(newOrder) {
          currentOrder = newOrder;
          orderBtns.forEach(b => {
            if (b.dataset.order === currentOrder) b.classList.add('active');
            else b.classList.remove('active');
          });

          const labelText = currentOrder === 'asc' ? 'Ascendente' : 'Descendente';
          if (sortRankingLabel) sortRankingLabel.textContent = labelText;
          if (sortTableLabel) sortTableLabel.textContent = labelText;

          fetchAnalytics();
        }

        // ==========================================
        // EVENT LISTENERS DE FILTRADO
        // ==========================================

        // Cambio de modo: General / Carrera / Estudiante
        scopeBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            scopeBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentMode = btn.dataset.mode;

            wrapCarrera.style.display = currentMode === 'carrera' ? 'block' : 'none';
            wrapEstudiante.style.display = currentMode === 'estudiante' ? 'block' : 'none';

            if (currentMode === 'carrera' && filtroTablaCarrera && selectCarrera) {
              filtroTablaCarrera.value = selectCarrera.value;
            } else if (currentMode === 'general' && filtroTablaCarrera) {
              filtroTablaCarrera.value = '';
            }

            fetchAnalytics();
          });
        });

        // Cambio de período
        periodBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            periodBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentPeriod = btn.dataset.period;
            fetchAnalytics();
          });
        });

        // Cambio de Orden (Ascendente / Descendente) desde barra superior
        orderBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            setOrder(btn.dataset.order);
          });
        });

        // Botones rápidos de orden en cabecera de Ranking y Tabla
        btnToggleRankingSort?.addEventListener('click', () => {
          setOrder(currentOrder === 'desc' ? 'asc' : 'desc');
        });

        btnToggleTableSort?.addEventListener('click', () => {
          setOrder(currentOrder === 'desc' ? 'asc' : 'desc');
        });

        // Filtro por rendimiento (< 100 hrs, Por acabar, etc.)
        filtroTablaRendimiento?.addEventListener('change', fetchAnalytics);

        // Filtro por carrera desde el botón/dropdown en la cabecera de la tabla
        filtroTablaCarrera?.addEventListener('change', () => {
          const val = filtroTablaCarrera.value;
          if (val) {
            currentMode = 'carrera';
            if (selectCarrera) selectCarrera.value = val;
            scopeBtns.forEach(b => {
              if (b.dataset.mode === 'carrera') b.classList.add('active');
              else b.classList.remove('active');
            });
            wrapCarrera.style.display = 'block';
            wrapEstudiante.style.display = 'none';
          } else {
            currentMode = 'general';
            scopeBtns.forEach(b => {
              if (b.dataset.mode === 'general') b.classList.add('active');
              else b.classList.remove('active');
            });
            wrapCarrera.style.display = 'none';
            wrapEstudiante.style.display = 'none';
          }
          fetchAnalytics();
        });

        // Botón de exportación rápida a Excel de pasantes con filtros dinámicos
        btnExportarPasantesExcel?.addEventListener('click', () => {
          const carreraId = (filtroTablaCarrera && filtroTablaCarrera.value) || (currentMode === 'carrera' ? selectCarrera.value : '');
          const estudianteId = (currentMode === 'estudiante' && selectEstudiante) ? selectEstudiante.value : '';
          const rendVal = (filtroTablaRendimiento && filtroTablaRendimiento.value) || 'todos';

          let exportUrl = `/api/graficos/export-pasantes-excel?modo=${encodeURIComponent(currentMode)}&periodo=${encodeURIComponent(currentPeriod)}&orden=${encodeURIComponent(currentOrder)}&filtroRendimiento=${encodeURIComponent(rendVal)}`;
          if (carreraId) {
            exportUrl += `&carreraId=${encodeURIComponent(carreraId)}`;
          }
          if (estudianteId) {
            exportUrl += `&estudianteId=${encodeURIComponent(estudianteId)}`;
          }
          window.location.href = exportUrl;
        });

        // Cambio de selectores dinámicos
        selectCarrera?.addEventListener('change', () => {
          if (filtroTablaCarrera) filtroTablaCarrera.value = selectCarrera.value;
          fetchAnalytics();
        });
        selectEstudiante?.addEventListener('change', fetchAnalytics);
        btnActualizar?.addEventListener('click', fetchAnalytics);

        // Carga inicial
        fetchAnalytics();

      });
    </script>

    <%- include('partials/footer') %>