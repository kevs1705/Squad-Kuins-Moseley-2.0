<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Verificación de Presencia</title>

  <link rel="stylesheet" href="/css/geofence.css">

  <!-- Leaflet -->
  <link rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        crossorigin>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
          crossorigin></script>

  <!-- SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
  <div class="wrap">
    <!-- Panel -->
    <div class="card">
      <h1>Verificación de presencia</h1>
      <p>Para acceder, confirma que te encuentras dentro de una zona o lugar de trabajo autorizado.</p>
      
      <div id="lugares-info" class="small" style="margin-bottom: 12px;">
        <b>Zonas autorizadas registradas: <%= lugares.length %></b>
      </div>

      <div class="geofence-actions-group">
        <button id="btn">Verificar mi ubicación</button>
        <a href="/dashboard" class="btn-back-geo">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Volver al Inicio
        </a>
      </div>
      
      <div id="log" class="log"></div>
      
      <p class="small" style="margin-top:10px">
        * Consejo: activa el GPS y Wi-Fi para mejor precisión.
      </p>
    </div>

    <!-- Mapa -->
    <div style="position:relative">
      <div id="map"></div>
      <div class="legend">
        <div><span class="dot" style="background:#22c55e"></span> Obras / Lugares Autorizados</div>
        <div><span class="dot" style="background:#eab308"></span> Tu ubicación GPS</div>
      </div>
    </div>
  </div>
<!-- Guardamos el JSON de forma segura en un tag HTML oculto -->
<script id="lugares-data" type="application/json">
  <%- JSON.stringify(lugares || []) %>
</script>

<script>
const btn = document.getElementById('btn');
const log = document.getElementById('log');
const redirect = "<%= redirect %>";

// Inyección segura
let LUGARES = [];
try {
  LUGARES = JSON.parse(document.getElementById('lugares-data').textContent);
} catch (e) {
  console.error("Error al parsear lugares:", e);
}

// --- MAPA ---
const map = L.map('map', { zoomControl: true, attributionControl: true });

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { 
  maxZoom: 19,
  subdomains: ['a', 'b', 'c'],
  attribution: '&copy; OpenStreetMap contributors' 
}).addTo(map);

const bounds = []; // Colección de coordenadas [lat, lng] válidas

// Dibujar los lugares válidos
LUGARES.forEach(lugar => {
  const lat = parseFloat(lugar.latitud);
  const lng = parseFloat(lugar.longitud);
  const radio = parseFloat(lugar.radio_metros) || 100;

  if (!isNaN(lat) && !isNaN(lng)) {
    // Marcador central
    L.circleMarker([lat, lng], {
      radius: 7, color: '#22c55e', weight: 2, fill: true, fillOpacity: 1
    }).addTo(map).bindPopup(`<b>${lugar.nombre}</b><br>Radio: ${radio}m`);

    // Círculo de cobertura
    L.circle([lat, lng], {
      radius: radio, color: '#22c55e', weight: 1.5, fill: true, fillOpacity: 0.1
    }).addTo(map);

    // Guardamos la coordenada en nuestro array para los límites
    bounds.push([lat, lng]);
  }
});

// Ajustar vista del mapa de forma segura
if (bounds.length > 0) {
  // Ajustamos los límites pasando directamente la lista de coordenadas LatLng
  map.fitBounds(bounds, { padding: [50, 50] });
} else {
  // Coordenadas por defecto (La Paz) si no hay lugares válidos
  map.setView([-16.5000, -68.1333], 14);
}

// Forzar el recálculo de dimensiones del mapa tras renderizar el DOM
setTimeout(() => {
  map.invalidateSize();
}, 250);

let userMarker = null;
let userAccCircle = null;

function fitAll() {
  const points = [...bounds];

  if (userMarker) {
    const userLatLng = userMarker.getLatLng();
    points.push([userLatLng.lat, userLatLng.lng]);
  }

  if (points.length > 0) {
    map.fitBounds(points, { padding: [40, 40], animate: true });
  }
}

function write(s){ log.textContent = s; }

btn.addEventListener('click', verifyPosition);

async function verifyPosition() {
  write('Obteniendo posición GPS...');
  btn.disabled = true;

  const opts = { enableHighAccuracy: true, maximumAge: 15000, timeout: 12000 };

  navigator.geolocation.getCurrentPosition(async pos => {
    const { latitude: lat, longitude: lng, accuracy } = pos.coords;

    if (!userMarker) {
      userMarker = L.circleMarker([lat, lng], {
        radius: 8, color: '#eab308', weight: 2, fill: true, fillOpacity: 1
      }).addTo(map).bindPopup('Tu posición');
    } else {
      userMarker.setLatLng([lat, lng]);
    }

    if (!userAccCircle) {
      userAccCircle = L.circle([lat, lng], {
        radius: Math.max(accuracy, 1), color: '#eab308', weight: 1, fill: true, fillOpacity: 0.08
      }).addTo(map);
    } else {
      userAccCircle.setLatLng([lat, lng]).setRadius(Math.max(accuracy, 1));
    }

    fitAll();
    write(`Lat: ${lat.toFixed(6)} · Lng: ${lng.toFixed(6)} · Precisión: ${Math.round(accuracy)}m\nVerificando...`);

    try {
      const res = await fetch('/api/geofence/verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ lat, lng, accuracy })
      });

      const data = await res.json();

      if (!res.ok || !data.ok) {
        write(`❌ ${data.msg || 'Ubicación no autorizada'}`);
        await Swal.fire({
          icon: 'error',
          title: 'Fuera de zona',
          text: data.msg || 'No estás dentro del radio permitido.',
          confirmButtonText: 'Entendido'
        });
        btn.disabled = false;
        return;
      }

      write(`✅ ${data.msg}`);
      
      const result = await Swal.fire({
        title: 'Ubicación Verificada',
        html: `Te encuentras en: <b>${data.lugar}</b><br>¿Deseas registrar tu entrada o salida?`,
        icon: 'success',
        showDenyButton: true,
        showCancelButton: true,
        confirmButtonText: 'Marcar Entrada',
        denyButtonText: 'Marcar Salida',
        cancelButtonText: 'Cancelar',
        confirmButtonColor: '#10b981',
        denyButtonColor: '#0b6bcb',
        cancelButtonColor: '#e2e8f0'
      });

      let tipo = null;
      if (result.isConfirmed) {
        tipo = 'entrada';
      } else if (result.isDenied) {
        tipo = 'salida';
      } else {
        write('Acción cancelada.');
        btn.disabled = false;
        return;
      }

      write(`Registrando ${tipo}...`);

      const regRes = await fetch('/api/geofence/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ tipo })
      });

      const regData = await regRes.json();
      if (!regRes.ok || !regData.ok) {
        write(`❌ Error: ${regData.msg || 'No se pudo registrar'}`);
        await Swal.fire({
          icon: 'error',
          title: 'Error de registro',
          text: regData.msg || 'Ocurrió un error al guardar en la base de datos.',
          confirmButtonText: 'Entendido'
        });
        btn.disabled = false;
        return;
      }

      write(`✅ Registrado: ${tipo}`);
      await Swal.fire({
        icon: 'success',
        title: 'Asistencia Registrada',
        html: `Acción: <b>${tipo.toUpperCase()}</b><br>Lugar: <b>${data.lugar}</b><br>Hora del servidor: <b>${regData.hora}</b>`,
        timer: 2500,
        showConfirmButton: false
      });

      location.assign(redirect);

    } catch (e) {
      console.error(e);
      write('Error de conexión.');
      await Swal.fire({ icon: 'warning', title: 'Error de red', text: 'Reintenta en unos momentos.' });
      btn.disabled = false;
    }
  }, async err => {
    write('Error GPS: ' + err.message);
    await Swal.fire({ icon: 'error', title: 'Ubicación bloqueada', text: err.message });
    btn.disabled = false;
  }, opts);
}
</script>
</body>
</html>