<%
  pageTitle = 'Usuarios';
  pageSubtitle = 'Gestión de usuarios';
%>

<%- include('partials/header') %>

<section class="panel">

  <div class="toolbar" style="gap:12px;">

    <input
      id="q"
      class="search"
      placeholder="Buscar por nombre o CI"
    >

    <div style="display:flex; gap:10px; flex-wrap:wrap;">
      <button id="btnNew" class="btn">
        + Nuevo
      </button>
    </div>

  </div>


  <div class="table-wrap" style="margin-top:14px;">

    <table id="tbl">

      <thead>
        <tr>
          <th>ID</th>
          <th>Nombre</th>
          <th>Apellido Paterno</th>
          <th>Apellido Materno</th>
          <th>CI</th>
          <th>Universidad</th>
          <th>Carrera</th>
          <th>Celular</th>
          <th>Estado</th>
          <th>Rol</th>
          <th>Acciones</th>
        </tr>
      </thead>


      <tbody id="tbody">

        <% (users || []).forEach(u => { %>

          <tr
            data-id="<%= u.id_usuario %>"
            data-nombre="<%- (u.nombre || '').replace(/"/g, '&quot;') %>"
            data-apellido_paterno="<%- (u.apellido_paterno || '').replace(/"/g, '&quot;') %>"
            data-apellido_materno="<%- (u.apellido_materno || '').replace(/"/g, '&quot;') %>"
            data-ci="<%- (u.CI || '').replace(/"/g, '&quot;') %>"
            data-universidad="<%- (u.universidad || '').replace(/"/g, '&quot;') %>"
            data-id_carrera="<%= u.id_carrera || '' %>"
            data-celular="<%- (u.celular || '').replace(/"/g, '&quot;') %>"
            data-estado="<%= Number(u.estado) || 0 %>"
            data-rol="<%= Number(u.rol) || 0 %>"
          >
            <td>
              <%= u.id_usuario %>
            </td>

            <td class="c-nombre">
              <%= u.nombre || '' %>
            </td>

            <td class="c-apellido_paterno">
              <%= u.apellido_paterno || '' %>
            </td>

            <td class="c-apellido_materno">
              <%= u.apellido_materno || '' %>
            </td>

            <td class="c-ci">
              <%= u.CI || '' %>
            </td>

            <td class="c-univ">
              <%= u.universidad || '' %>
            </td>

            <td class="c-carr">
              <%= u.carrera_nombre || u.carrera_siglas || '-' %>
            </td>

            <td class="c-cel">
              <%= u.celular || '-' %>
            </td>

            <td class="c-est">
              <span class="chip <%= u.estado ? 'ok' : 'off' %>">
                <%= u.estado ? 'Activo' : 'Inactivo' %>
              </span>
            </td>

            <td class="c-rol">
              <span class="chip role">
                <%= u.rol ? 'Admin' : 'Usuario' %>
              </span>
            </td>

            <td class="actions">

              <button class="btn secondary btnEdit">
                Editar
              </button>

              <button class="btn secondary btnDel">
                Eliminar
              </button>

            </td>

          </tr>

        <% }) %>

      </tbody>

    </table>

  </div>

</section>


<!-- MODAL -->

<div class="modal-backdrop" id="modal-backdrop">

  <div class="modal">

    <h3 id="modal-title">
      Nuevo usuario
    </h3>

    <form id="user-form">

      <div class="form-grid">

        <label>
          Nombre
          <input
            id="f-nombre"
            name="nombre"
            required
            placeholder="Nombre completo"
          >
        </label>


        <label>
          Apellido Paterno
          <input
            id="f-app"
            name="apellido_paterno"
            required
            placeholder="Apellido paterno"
          >
        </label>


        <label>
          Apellido Materno
          <input
            id="f-apm"
            name="apellido_materno"
            required
            placeholder="Apellido materno"
          >
        </label>


        <label>
          CI
          <input
            id="f-ci"
            name="ci"
            required
            placeholder="CI"
            inputmode="numeric"
          >
        </label>


        <label>
          Universidad
          <input
            id="f-univ"
            name="universidad"
            required
            placeholder="Universidad"
          >
        </label>


        <label>
          Carrera
          <select id="f-carr" name="id_carrera" required>
            <option value="">Seleccione una carrera...</option>
            <% (carreras || []).forEach(c => { %>
              <option value="<%= c.id_carrera %>">
                <%= c.nombre %> (<%= c.siglas %>)
              </option>
            <% }) %>
          </select>
        </label>


        <label>
          Celular
          <input
            id="f-cel"
            name="celular"
            placeholder="Ej. 70000000"
            inputmode="tel"
          >
        </label>


        <label>
          Estado

          <select id="f-est" name="estado">

            <option value="1">
              Activo
            </option>

            <option value="0">
              Inactivo
            </option>

          </select>

        </label>


        <label>
          Rol

          <select id="f-rol" name="rol">

            <option value="0">
              Usuario
            </option>

            <option value="1">
              Admin
            </option>

          </select>

        </label>


        <label>
          Contraseña
          <small>(obligatoria al crear)</small>

          <input
            id="f-pass"
            name="contrasena"
            type="password"
            placeholder="Contraseña"
          >

        </label>

      </div>


      <div class="modal-actions">

        <button
          type="button"
          class="btn secondary"
          id="btn-cancel"
        >
          Cancelar
        </button>

        <button
          type="submit"
          class="btn"
          id="btn-save"
        >
          Guardar
        </button>

      </div>

    </form>

  </div>

</div>


<script>

  const q = document.getElementById('q');
  const tbody = document.getElementById('tbody');
  const btnNew = document.getElementById('btnNew');
  const backdrop = document.getElementById('modal-backdrop');
  const form = document.getElementById('user-form');
  const modalTitle = document.getElementById('modal-title');
  const btnCancel = document.getElementById('btn-cancel');

  let editId = null;


  /* =========================
     BUSCAR USUARIOS
     ========================= */

  q.addEventListener('input', () => {

    const val = q.value.toLowerCase().trim();

    [...tbody.rows].forEach(tr => {

      const name =
        tr.querySelector('.c-nombre')
          ?.textContent
          .toLowerCase() || '';

      const ci =
        tr.querySelector('.c-ci')
          ?.textContent
          .toLowerCase() || '';

      tr.style.display =
        (name.includes(val) || ci.includes(val))
          ? ''
          : 'none';

    });

  });


  /* =========================
     NUEVO USUARIO
     ========================= */

  btnNew.addEventListener('click', () => {

    editId = null;

    form.dataset.mode = 'create';

    initFormValues();

    openModal('Nuevo usuario');

    document.getElementById('f-pass').required = true;

  });


  /* =========================
     EDITAR / ELIMINAR
     ========================= */

  tbody.addEventListener('click', async (ev) => {

    const tr = ev.target.closest('tr');

    if (!tr) return;


    /* EDITAR */

    if (ev.target.closest('.btnEdit')) {

      const user = rowToObj(tr);

      editId = user.id_usuario;

      form.dataset.mode = 'edit';

      initFormValues(user);

      openModal(`Editar #${user.id_usuario}`);

      document.getElementById('f-pass').required = false;

      return;
    }


    /* ELIMINAR */

    if (ev.target.closest('.btnDel')) {

      const id = tr.dataset.id;

      const conf = confirm(
        `¿Eliminar usuario #${id}?`
      );

      if (!conf) return;


      try {

        const res = await fetch(
          `/api/usuarios/${id}`,
          {
            method: 'DELETE',
            credentials: 'include'
          }
        );


        const data = await res.json();


        if (!res.ok || !data.ok) {

          throw new Error(
            data.msg || 'No se pudo eliminar'
          );

        }


        tr.remove();


      } catch (e) {

        console.error(e);

        alert(
          e.message ||
          'No se pudo eliminar'
        );

      }

    }

  });


  /* =========================
     CERRAR MODAL
     ========================= */

  btnCancel.addEventListener(
    'click',
    closeModal
  );


  backdrop.addEventListener('click', (e) => {

    if (e.target === backdrop) {

      closeModal();

    }

  });


  form.addEventListener(
    'submit',
    onSubmit
  );


  /* =========================
     INICIALIZAR FORMULARIO
     ========================= */

  function initFormValues(u = {}) {

    document.getElementById('f-nombre').value =
      u.nombre || '';

    document.getElementById('f-app').value =
      u.apellido_paterno || '';

    document.getElementById('f-apm').value =
      u.apellido_materno || '';

    document.getElementById('f-ci').value =
      u.CI || '';

    document.getElementById('f-univ').value =
      u.universidad || '';

    document.getElementById('f-carr').value = u.id_carrera || '';

    document.getElementById('f-cel').value =
      u.celular || '';

    document.getElementById('f-est').value =
      Number(u.estado ?? 1);

    document.getElementById('f-rol').value =
      Number(u.rol ?? 0);

    document.getElementById('f-pass').value =
      '';

  }


  /* =========================
     ABRIR MODAL
     ========================= */

  function openModal(title) {

    modalTitle.textContent = title;

    backdrop.style.display = 'flex';

  }


  /* =========================
     CERRAR MODAL
     ========================= */

  function closeModal() {

    backdrop.style.display = 'none';

    form.reset();

    editId = null;

  }


  /* =========================
     GUARDAR USUARIO
     ========================= */

  async function onSubmit(e) {

    e.preventDefault();


    const payload =
      getFormValues(
        form.dataset.mode === 'create'
      );


    if (!payload) return;


    try {

      let url = '/api/usuarios';

      let method = 'POST';


      if (
        form.dataset.mode === 'edit' &&
        editId
      ) {

        url = `/api/usuarios/${editId}`;

        /*
         * IMPORTANTE:
         * Aquí dejamos POST porque tu código
         * original utilizaba POST.
         *
         * Si tu backend utiliza PUT para editar,
         * cambia esta línea a:
         *
         * method = 'PUT';
         */

        method = 'POST';

      }


      const res = await fetch(
        url,
        {
          method: method,

          headers: {
            'Content-Type': 'application/json'
          },

          credentials: 'include',

          body: JSON.stringify(payload)

        }
      );


      const data = await res.json();


      if (!res.ok || !data.ok) {

        throw new Error(
          data.msg ||
          'Error al guardar usuario'
        );

      }


      appendOrReplaceRow(data.user);

      closeModal();


    } catch (err) {

      console.error(err);

      alert(
        err.message ||
        'No se pudo guardar el usuario'
      );

    }

  }


  /* =========================
     OBTENER DATOS DEL FORMULARIO
     ========================= */

  function getFormValues(requirePass) {

    const nombre =
      document.getElementById('f-nombre')
        .value
        .trim();


    const apellido_paterno =
      document.getElementById('f-app')
        .value
        .trim();


    const apellido_materno =
      document.getElementById('f-apm')
        .value
        .trim();


    const CI =
      document.getElementById('f-ci')
        .value
        .trim();


    const universidad =
      document.getElementById('f-univ')
        .value
        .trim();

    const id_carrera = 
    Number(document.getElementById('f-carr').value);

    const celular =
      document.getElementById('f-cel')
        .value
        .trim();


    const estado =
      Number(
        document.getElementById('f-est').value
      );


    const rol =
      Number(
        document.getElementById('f-rol').value
      );


    const contrasena =
      document.getElementById('f-pass')
        .value;


    /* VALIDACIONES */

    if (
      !nombre ||
      !apellido_paterno ||
      !CI ||
      !id_carrera
    ) {

      alert(
        'Nombre, apellidos, CI y Carrera son obligatorios'
      );

      return false;

    }


    /* Validar CI */

    if (!/^[0-9.\-]{5,32}$/.test(CI)) {

      alert(
        'CI inválido (5-32 caracteres, dígitos/punto/guion)'
      );

      return false;

    }


    /* Validar celular */

    if (
      celular &&
      !/^[0-9]{7,12}$/.test(celular)
    ) {

      alert(
        'Celular: debe contener entre 7 y 12 dígitos'
      );

      return false;

    }


    /* Contraseña obligatoria solamente al crear */

    if (
      requirePass &&
      !contrasena
    ) {

      alert(
        'Contraseña obligatoria al crear'
      );

      return false;

    }


    return {

      nombre,

      apellido_paterno,

      apellido_materno,

      CI,

      universidad,

      id_carrera,

      carrera,

      celular,

      estado,

      rol,

      /*
       * Si estamos editando y la contraseña
       * está vacía, no se envía.
       *
       * Esto permite que el backend conserve
       * la contraseña actual.
       */

      ...(contrasena
        ? { contrasena }
        : {})

    };

  }


  /* =========================
     CONVERTIR FILA A OBJETO
     ========================= */

  function rowToObj(tr) {

    return {

      id_usuario:
        Number(tr.dataset.id),


      nombre:
        tr.dataset.nombre ||
        tr.querySelector('.c-nombre')
          ?.textContent
          .trim() ||
        '',


      apellido_paterno:
        tr.dataset.apellido_paterno ||
        tr.querySelector('.c-apellido_paterno')
          ?.textContent
          .trim() ||
        '',


      apellido_materno:
        tr.dataset.apellido_materno ||
        tr.querySelector('.c-apellido_materno')
          ?.textContent
          .trim() ||
        '',


      CI:
        tr.dataset.ci ||
        tr.querySelector('.c-ci')
          ?.textContent
          .trim() ||
        '',


      universidad:
        tr.dataset.universidad ||
        tr.querySelector('.c-univ')
          ?.textContent
          .trim() ||
        '',

      id_carrera: Number(tr.dataset.id_carrera) || null,


      celular:
        tr.dataset.celular ||
        (
          tr.querySelector('.c-cel')
            ?.textContent
            .trim() === '-'
            ? ''
            : tr.querySelector('.c-cel')
                ?.textContent
                .trim() || ''
        ),


      estado:
        Number(
          tr.dataset.estado || 0
        ),


      rol:
        Number(
          tr.dataset.rol || 0
        )

    };

  }


  /* =========================
     AGREGAR / REEMPLAZAR FILA
     ========================= */

  function appendOrReplaceRow(u) {

    let tr =
      tbody.querySelector(
        `tr[data-id="${u.id_usuario}"]`
      );


    const htmlCells = `

      <td>
        ${u.id_usuario}
      </td>

      <td class="c-nombre"></td>

      <td class="c-apellido_paterno"></td>

      <td class="c-apellido_materno"></td>

      <td class="c-ci"></td>

      <td class="c-univ"></td>

      <td class="c-carr"></td>

      <td class="c-cel"></td>

      <td class="c-est">
        <span class="chip ${u.estado ? 'ok' : 'off'}">
          ${u.estado ? 'Activo' : 'Inactivo'}
        </span>
      </td>

      <td class="c-rol">
        <span class="chip role">
          ${u.rol ? 'Admin' : 'Usuario'}
        </span>
      </td>

      <td class="actions">

        <button class="btn secondary btnEdit">
          Editar
        </button>

        <button class="btn secondary btnDel">
          Eliminar
        </button>

      </td>

    `;


    /* Crear fila si no existe */

    if (!tr) {

      tr = document.createElement('tr');

      tr.setAttribute(
        'data-id',
        u.id_usuario
      );

      tbody.prepend(tr);

    }


    tr.innerHTML = htmlCells;


    /* =========================
       ACTUALIZAR CELDAS
       ========================= */

    tr.querySelector('.c-nombre').textContent =
      u.nombre || '';


    tr.querySelector(
      '.c-apellido_paterno'
    ).textContent =
      u.apellido_paterno || '';


    tr.querySelector(
      '.c-apellido_materno'
    ).textContent =
      u.apellido_materno || '';


    tr.querySelector('.c-ci').textContent =
      u.CI || '';


    tr.querySelector('.c-univ').textContent =
      u.universidad || '';


    /*tr.querySelector('.c-carr').textContent =
      u.carrera || '';*/
    tr.querySelector('.c-carr').textContent = u.carrera_nombre || u.carrera_siglas || '-';

    tr.querySelector('.c-cel').textContent =
      u.celular || '-';


    /* =========================
       ACTUALIZAR DATASET
       ========================= */

    tr.dataset.nombre =
      u.nombre || '';


    tr.dataset.apellido_paterno =
      u.apellido_paterno || '';


    tr.dataset.apellido_materno =
      u.apellido_materno || '';


    tr.dataset.ci =
      u.CI || '';


    tr.dataset.universidad =
      u.universidad || '';


    /*tr.dataset.carrera =
      u.carrera || '';*/
    tr.dataset.id_carrera = u.id_carrera || '';

    tr.dataset.celular =
      u.celular || '';


    tr.dataset.estado =
      Number(u.estado) || 0;


    tr.dataset.rol =
      Number(u.rol) || 0;

  }

</script>


<%- include('partials/footer') %>