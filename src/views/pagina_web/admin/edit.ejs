<%
  pageTitle = 'Editar proyecto';
  pageSubtitle = 'Gestión de contenidos';
%>
<%- include('../../partials/header') %>

<link rel="stylesheet" href="/css/admin-pagina-web.css">

    <% if (err) { %>
      <div class="alert alert-error"><%= err %></div>
    <% } %>

    <section class="card">
      <form method="POST" action="/admin/pagina-web/edit/<%= proyecto.id %>" enctype="multipart/form-data">
        <div class="grid">
          <label>Título
            <input type="text" name="titulo" value="<%= proyecto.titulo %>" required>
          </label>
          <label>Categoría
            <select name="categoria" required>
              <option value="Unifamiliares" <%= proyecto.categoria === 'Unifamiliares' ? 'selected' : '' %>>Unifamiliares</option>
              <option value="Multifamiliares" <%= proyecto.categoria === 'Multifamiliares' ? 'selected' : '' %>>Multifamiliares</option>
              <option value="Especiales" <%= proyecto.categoria === 'Especiales' ? 'selected' : '' %>>Especiales</option>
            </select>
          </label>
          <label>Estado
            <select name="estado">
              <option value="Entregado (Activo)" <%= proyecto.estado === 'Entregado (Activo)' ? 'selected' : '' %>>Entregado (Activo)</option>
              <option value="En proceso (Activo)" <%= proyecto.estado === 'En proceso (Activo)' ? 'selected' : '' %>>En proceso (Activo)</option>
              <option value="Desactivado" <%= proyecto.estado === 'Desactivado' ? 'selected' : '' %>>Desactivado</option>
            </select>
          </label>
          <label>Imagen (archivo)
            <input type="file" name="imagen_file" accept="image/*">
            <% if (proyecto.imagen) { %>
              <small class="muted">Actual: <%= proyecto.imagen %></small>
              <input type="hidden" name="imagen_actual" value="<%= proyecto.imagen %>">
            <% } %>
          </label>
          <label>Ubicación
            <input type="text" name="ubicacion" value="<%= proyecto.ubicacion || '' %>" placeholder="Ciudad, País">
          </label>
          <label>Superficie
            <input type="text" name="superficie" value="<%= proyecto.superficie || '' %>" placeholder="Ej: 250 m²">
          </label>
          <label>Año
            <input type="number" name="anio" value="<%= proyecto.anio || '' %>" min="1900" max="2100" placeholder="2025">
          </label>
        </div>
        <label style="margin-top:12px;">Descripción
          <textarea name="descripcion"><%= proyecto.descripcion || '' %></textarea>
        </label>
        <div style="margin-top:12px; display:flex; gap:10px;">
          <button type="submit" class="btn">Guardar cambios</button>
          <a href="/admin/pagina-web" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
<%- include('../../partials/footer') %>
