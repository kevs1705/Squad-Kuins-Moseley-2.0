<%
  pageTitle = 'Administrar Página Web';
  pageSubtitle = 'Gestión de contenidos';
%>
<%- include('../../partials/header') %>

<style>
  /* Estilos específicos de administrar página web */
  .grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(240px,1fr)); gap:12px; }
  label { display:flex; flex-direction:column; gap:6px; font-size:14px; color:#9fb1c8; }
  input, select, textarea { background:#0b1628; border:1px solid rgba(255,255,255,0.08); border-radius:10px; padding:10px 12px; color:#f5f7fb; }
  textarea { min-height:90px; resize:vertical; }
  .btn { background:#279ae4; color:#fff; border:none; padding:12px 16px; border-radius:10px; cursor:pointer; font-weight:600; }
  .btn:hover { background:#2ea7f5; }
  .btn-secondary { background:#122642; border:1px solid rgba(255,255,255,0.08); }
  table { width:100%; border-collapse:collapse; margin-top:12px; }
  th, td { padding:10px; border-bottom:1px solid rgba(255,255,255,0.06); text-align:left; font-size:14px; }
  th { color:#9fb1c8; font-weight:600; }
  .badge { padding:4px 10px; border-radius:999px; font-size:12px; }
  .badge-green { background:rgba(46,204,113,0.12); color:#8ef0bd; }
  .badge-orange { background:rgba(243,156,18,0.12); color:#f6c683; }
  .badge-blue { background:rgba(39,154,228,0.12); color:#9ad6ff; }
  .actions { display:flex; gap:8px; flex-wrap:wrap; }
  .alert { padding:10px 12px; border-radius:10px; }
  .alert-success { background:rgba(39,154,228,0.12); color:#9ad6ff; border:1px solid rgba(39,154,228,0.25); }
  .alert-error { background:rgba(255,99,132,0.12); color:#ffc6d1; border:1px solid rgba(255,99,132,0.25); }
</style>

    <% if (msg) { %>
      <div class="alert alert-success"><%= msg %></div>
    <% } %>
    <% if (err) { %>
      <div class="alert alert-error"><%= err %></div>
    <% } %>

    <section class="card">
      <h3 style="margin-top:0;">Crear proyecto</h3>
      <form method="POST" action="/admin/pagina-web" enctype="multipart/form-data">
        <div class="grid">
          <label>Título
            <input type="text" name="titulo" required placeholder="Ej: Residencial Aurora">
          </label>
          <label>Categoría
            <select name="categoria" required>
              <option value="Unifamiliares">Unifamiliares</option>
              <option value="Multifamiliares">Multifamiliares</option>
              <option value="Especiales">Especiales</option>
            </select>
          </label>
          <label>Estado
            <select name="estado">
              <option value="Entregado (Activo)">Entregado (Activo)</option>
              <option value="En proceso (Activo)">En proceso (Activo)</option>
              <option value="Desactivado">Desactivado</option>
            </select>
          </label>
          <label>Imagen (archivo)
            <input type="file" name="imagen_file" accept="image/*">
          </label>
          <label>Ubicación
            <input type="text" name="ubicacion" placeholder="Ciudad, País">
          </label>
          <label>Superficie
            <input type="text" name="superficie" placeholder="Ej: 250 m²">
          </label>
          <label>Año
            <input type="number" name="anio" min="1900" max="2100" placeholder="2025">
          </label>
        </div>
        <label style="margin-top:12px;">Descripción
          <textarea name="descripcion" placeholder="Resumen del proyecto..."></textarea>
        </label>
        <div style="margin-top:12px; display:flex; gap:10px;">
          <button type="submit" class="btn">Guardar</button>
        </div>
      </form>
    </section>

    <section class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;">
        <h3 style="margin:0;">Proyectos</h3>
        <span class="muted"><%= proyectos.length %> registros</span>
      </div>

      <div style="overflow:auto;">
        <table>
          <thead>
            <tr>
              <th>Título</th>
              <th>Categoría</th>
              <th>Estado</th>
              <th>Año</th>
              <th>Ubicación</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% if (proyectos.length === 0) { %>
              <tr><td colspan="6" class="muted">Sin proyectos aún.</td></tr>
            <% } %>
            <% proyectos.forEach(p => { %>
              <tr>
                <td><strong><%= p.titulo %></strong></td>
                <td><%= p.categoria %></td>
                <td>
                  <% const badgeClass = p.estado === 'Desactivado' ? 'badge-orange' : (p.estado && p.estado.includes('Entregado') ? 'badge-green' : 'badge-blue'); %>
                  <span class="badge <%= badgeClass %>"><%= p.estado %></span>
                </td>
                <td><%= p.anio || '-' %></td>
                <td><%= p.ubicacion || '-' %></td>
                <td class="actions">
                  <a class="btn btn-secondary" href="/admin/pagina-web/edit/<%= p.id %>">Editar</a>
                  <form method="POST" action="/admin/pagina-web/delete/<%= p.id %>" onsubmit="return confirm('¿Eliminar este proyecto?');">
                    <button type="submit" class="btn btn-danger btn-secondary">Eliminar</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
<%- include('../../partials/footer') %>
