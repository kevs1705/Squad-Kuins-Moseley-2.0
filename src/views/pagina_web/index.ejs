    </section><!-- /Home About Section -->



    <!-- Featured Services Section -->
    <section id="services" class="featured-services section dark-background">

      <!-- Section Title -->
      <div class="container section-title" data-aos="fade-up">
        <h2>Nuestros Servicios</h2>
        <p>Soluciones integrales de construcción adaptadas a cada necesidad</p>
      </div><!-- End Section Title -->

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row gy-4">

          <div class="col-lg-6" data-aos="fade-up" data-aos-delay="200">
            <div class="service-card">
              <div class="service-icon">
                <i class="fas fa-drafting-compass"></i>
              </div>
              <div class="service-content">
                <h3>Diseño Arquitectónico</h3>
                <p>Creamos planos y diseños innovadores que combinan funcionalidad y estética moderna. Utilizamos modelado BIM para visualizar cada detalle antes de construir.</p>
                <ul class="service-features">
                  <li><i class="fas fa-check-circle"></i>Planos 2D y 3D</li>
                  <li><i class="fas fa-check-circle"></i>Renderizado de Alta Calidad</li>
                  <li><i class="fas fa-check-circle"></i>Optimización de Espacios</li>
                </ul>
                <a href="/servicios" class="service-btn">
                  Ver Detalles
                  <i class="fas fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </div><!-- End Service Card -->

          <div class="col-lg-6" data-aos="fade-up" data-aos-delay="300">
            <div class="service-card">
              <div class="service-icon">
                <i class="fas fa-hard-hat"></i>
              </div>
              <div class="service-content">
                <h3>Construcción Civil</h3>
                <p>Ejecución de obras civiles de gran escala, desde cimientos hasta acabados. Garantizamos estructuras seguras, duraderas y de alta calidad.</p>
                <ul class="service-features">
                  <li><i class="fas fa-check-circle"></i>Edificios Multifamiliares</li>
                  <li><i class="fas fa-check-circle"></i>Naves Industriales</li>
                  <li><i class="fas fa-check-circle"></i>Infraestructura Vial</li>
                </ul>
                <a href="/servicios" class="service-btn">
                  Ver Detalles
                  <i class="fas fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </div><!-- End Service Card -->

          <div class="col-lg-6" data-aos="fade-up" data-aos-delay="400">
            <div class="service-card">
              <div class="service-icon">
                <i class="fas fa-hammer"></i>
              </div>
              <div class="service-content">
                <h3>Remodelaciones</h3>
                <p>Renovamos espacios existentes para darles nueva vida y funcionalidad. Especialistas en modernización de oficinas, viviendas y locales comerciales.</p>
                <ul class="service-features">
                  <li><i class="fas fa-check-circle"></i>Ampliaciones</li>
                  <li><i class="fas fa-check-circle"></i>Refuerzo Estructural</li>
                  <li><i class="fas fa-check-circle"></i>Acabados de Lujo</li>
                </ul>
                <a href="/servicios" class="service-btn">
                  Ver Detalles
                  <i class="fas fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </div><!-- End Service Card -->

          <div class="col-lg-6" data-aos="fade-up" data-aos-delay="500">
            <div class="service-card">
              <div class="service-icon">
                <i class="fas fa-tasks"></i>
              </div>
              <div class="service-content">
                <h3>Gestión de Proyectos</h3>
                <p>Supervisión integral de obra para asegurar el cumplimiento de plazos y presupuestos. Nos encargamos de todos los trámites y logística.</p>
                <ul class="service-features">
                  <li><i class="fas fa-check-circle"></i>Dirección Técnica</li>
                  <li><i class="fas fa-check-circle"></i>Control de Calidad</li>
                  <li><i class="fas fa-check-circle"></i>Gestión de Permisos</li>
                </ul>
                <a href="/servicios" class="service-btn">
                  Ver Detalles
                  <i class="fas fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </div><!-- End Service Card -->

        </div>

      </div>

    </section><!-- /Featured Services Section -->

    <!-- Projects Section (Gallery Style) -->
    <section id="proyectos" class="gallery section">

      <!-- Section Title -->
      <div class="container section-title" data-aos="fade-up">
        <h2>Proyectos Destacados</h2>
        <p>Una muestra de nuestra experiencia y compromiso en cada obra</p>
      </div><!-- End Section Title -->

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="isotope-layout" data-default-filter="*" data-layout="masonry" data-sort="original-order">

          <ul class="gallery-filters isotope-filters" data-aos="fade-up" data-aos-delay="100">
            <li data-filter="*" class="filter-active">Todos</li>
            <li data-filter=".filter-especiales">Especiales</li>
            <li data-filter=".filter-unifamiliares">Unifamiliares</li>
            <li data-filter=".filter-multifamiliares">Multifamiliares</li>
          </ul><!-- End Gallery Filters -->

          <div class="row g-4 isotope-container" data-aos="fade-up" data-aos-delay="200">

          <% (proyectos || []).forEach((proyecto) => { 
                const filterClass = `filter-${(proyecto.categoria || '').toLowerCase()}`;
                const descripcion = proyecto.descripcion || '';
                const resumen = descripcion.length > 80 ? `${descripcion.substring(0, 80)}...` : descripcion;
            %>
            <div class="col-lg-4 col-md-6 gallery-item isotope-item <%= filterClass %>">
              <a href="/project-details?id=<%= proyecto.id %>" class="gallery-card always-hover d-block h-100 text-decoration-none">
                <div class="gallery-img position-relative overflow-hidden w-100 h-100">
                  <img src="<%= proyecto.imagen %>" class="img-fluid w-100 h-100 object-fit-cover" alt="<%= proyecto.titulo %>">
                  <div class="gallery-overlay d-flex flex-column justify-content-end p-4">
                    <div class="gallery-info text-white">
                      <h4 class="text-white mb-2"><%= proyecto.titulo %></h4>
                      <p class="text-white-50 m-0 small"><%= resumen %></p>
                      <span class="btn btn-sm btn-outline-light mt-3">Ver Proyecto <i class="bi bi-arrow-right ms-1"></i></span>
                    </div>
                  </div>
                </div>
              </a>
            </div><!-- End Gallery Item -->
          <% }); %>

          </div><!-- End Gallery Container -->

        </div>

      </div>

    </section><!-- /Projects Section -->

    <!-- Call To Action Section -->
    <section id="call-to-action" class="call-to-action section">

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row justify-content-center">
          <div class="col-lg-8 text-center">
            <h2 data-aos="fade-up" data-aos-delay="200">¿Listo para Iniciar su Proyecto?</h2>
            <p data-aos="fade-up" data-aos-delay="250">Nuestro equipo de ingenieros está listo para asesorarlo. Contáctenos para una evaluación inicial sin compromiso.</p>

            <div class="cta-buttons" data-aos="fade-up" data-aos-delay="300">
              <a href="/contact" class="btn-primary">Contacto</a>
            </div>
