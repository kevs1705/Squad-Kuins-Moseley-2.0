<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title><%= proyecto.titulo %> - Detalles del Proyecto</title>
  <meta name="description" content="<%= (proyecto.descripcion || '').substring(0, 150) %>...">
  <meta name="keywords" content="proyecto, construcción, <%= proyecto.categoria %>">

  <!-- Favicons -->
  <link href="/img/favicon.png" rel="icon">
  <link href="/img/apple-touch-icon.png" rel="apple-touch-icon">

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="/vendor/aos/aos.css" rel="stylesheet">
  <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
  <link href="/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
  <link href="/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="/css/main.css" rel="stylesheet">
</head>

<body class="project-details-page">

  <header id="header" class="header d-flex align-items-center fixed-top">
    <div class="header-container container-fluid container-xl position-relative d-flex align-items-center justify-content-between">

      <a href="/index" class="logo d-flex align-items-center me-auto me-xl-0">
        <h1 class="sitename" style="color: #ffffff;">BYGGERR <span style="color: #279ae4;">SRL</span></h1>
      </a>

      <nav id="navmenu" class="navmenu">
        <ul>
          <li><a href="/index">Inicio</a></li>
          <li><a href="/nosotros">Nosotros</a></li>
          <li><a href="/servicios">Servicios</a></li>
          <li><a href="/proyectos-especiales">Proyectos Especiales</a></li>
          <li class="dropdown"><a href="#"><span>Viviendas</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
            <ul>
              <li><a href="/unifamiliares">Unifamiliares</a></li>
              <li><a href="/multifamiliares">Multifamiliares</a></li>
            </ul>
          </li>
        </ul>
        <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
      </nav>

      <a class="btn-getstarted" href="/contact">Contacto</a>
      <a class="btn-getstarted" href="/login">Iniciar sesión</a>

    </div>
  </header>

  <main class="main">

    <!-- Page Title -->
    <div class="page-title">
      <div class="title-wrapper">
        <h1><%= proyecto.titulo %></h1>
      </div>
    </div><!-- End Page Title -->

    <!-- Department Details Section (Adapted for Project Details) -->
    <section id="project-details" class="about section">
      <div class="container" data-aos="fade-up">

        <div class="row gy-4">
          
          <!-- Project Image -->
          <div class="col-lg-8" data-aos="fade-up" data-aos-delay="200">
             <div class="project-image mb-4">
                <img src="<%= (proyecto.imagen || '').trim() ? proyecto.imagen : '/img/hero-construction.jpg' %>" alt="<%= proyecto.titulo %>" class="img-fluid rounded w-100" style="max-height: 500px; object-fit: cover;">
             </div>
             
             <div class="project-description">
               <h2>Descripción del Proyecto</h2>
               <p class="lead">
                 <%- (proyecto.descripcion || '').replace(/\n/g, '<br>') %>
               </p>
               <p>
                 Este proyecto representa nuestro compromiso con la excelencia y la calidad en la construcción. Cada detalle ha sido cuidadosamente planificado y ejecutado para cumplir con los estándares más exigentes y satisfacer las necesidades de nuestros clientes.
               </p>
             </div>
          </div>

          <!-- Project Info Sidebar -->
          <div class="col-lg-4" data-aos="fade-up" data-aos-delay="100">
             <div class="service-box p-4" style="background: #091121; border: 1px solid rgba(255,255,255,0.1); border-radius: 10px;">
                <h4 class="mb-4 text-white">Detalles de Obra</h4>
                
                <ul class="list-unstyled text-white-50">
                  <li class="mb-3 d-flex border-bottom border-secondary pb-2">
                    <strong class="text-white me-auto"><i class="bi bi-tag-fill me-2 text-primary"></i>Categoría:</strong> 
                    <span><%= proyecto.categoria %></span>
                  </li>
                  <li class="mb-3 d-flex border-bottom border-secondary pb-2">
                    <strong class="text-white me-auto"><i class="bi bi-check-circle-fill me-2 text-primary"></i>Estado:</strong> 
                    <span><%= proyecto.estado %></span>
                  </li>
                  <!-- Fallback placeholders if DB doesn't have these fields, removed for essential only -->
                  <li class="mb-3 d-flex border-bottom border-secondary pb-2">
                    <strong class="text-white me-auto"><i class="bi bi-calendar-event-fill me-2 text-primary"></i>Año:</strong> 
                    <span>2024</span>
                  </li>
                </ul>

                <div class="mt-4">
                  <h5 class="text-white mb-3">¿Interesado en un proyecto similar?</h5>
                  <p class="text-white-50 small mb-4">Contáctenos para discutir cómo podemos hacer realidad su visión.</p>
                  <a href="/contact" class="btn btn-primary w-100 rounded-pill">Solicitar Información</a>
                </div>
             </div>
          </div>

        </div>

      </div>
    </section>

  </main>

  <footer id="footer" class="footer position-relative dark-background">
    <div class="container footer-top">
      <div class="row gy-4">
        <div class="col-lg-4 col-md-6 footer-about">
          <a href="/index" class="logo d-flex align-items-center">
            <span class="sitename">BYGGERR SRL</span>
          </a>
          <div class="footer-contact pt-3">
            <p>Av Ismael Montes 640</p>
            <p>La Paz, Bolivia</p>
            <p class="mt-3"><strong>Teléfono:</strong> <span>+591 712 34 567</span></p>
            <p><strong>Email:</strong> <span>contacto@byggerr.com</span></p>
            <p class="mt-2"><strong>Horario:</strong> <br>Lun - Vie: 8:00 AM - 6:00 PM</p>
          </div>
          <div class="social-links d-flex mt-4">
            <a href=""><i class="bi bi-twitter-x"></i></a>
            <a href=""><i class="bi bi-facebook"></i></a>
            <a href=""><i class="bi bi-instagram"></i></a>
            <a href=""><i class="bi bi-linkedin"></i></a>
          </div>
        </div>

        <div class="col-lg-2 col-md-3 footer-links">
          <h4>Enlaces Útiles</h4>
          <ul>
            <li><a href="/index">Inicio</a></li>
            <li><a href="/nosotros">Nosotros</a></li>
            <li><a href="/servicios">Servicios</a></li>
            <li><a href="#">Términos de servicio</a></li>
            <li><a href="#">Política de privacidad</a></li>
          </ul>
        </div>

        <div class="col-lg-2 col-md-3 footer-links">
          <h4>Nuestros Servicios</h4>
          <ul>
            <li><a href="/servicios">Diseño Arquitectónico</a></li>
            <li><a href="/servicios">Construcción Civil</a></li>
            <li><a href="/servicios">Gestión de Obras</a></li>
            <li><a href="/servicios">Remodelaciones</a></li>
            <li><a href="/servicios">Consultoría</a></li>
          </ul>
        </div>

        <div class="col-lg-2 col-md-3 footer-links">
          <h4>Proyectos</h4>
          <ul>
            <li><a href="/unifamiliares">Viviendas Unifamiliares</a></li>
            <li><a href="/multifamiliares">Edificios Residenciales</a></li>
            <li><a href="/proyectos-especiales">Proyectos Especiales</a></li>
          </ul>
        </div>

      </div>
    </div>

    <div class="container copyright text-center mt-4">
      <p>© <span>Copyright</span> <strong class="px-1 sitename">BYGGERR SRL</strong> <span>Todos los derechos reservados</span></p>
      <div class="credits">
      </div>
    </div>
  </footer>

  <!-- Scroll Top -->
  <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

  <!-- Preloader -->
  <div id="preloader"></div>

  <!-- Vendor JS Files -->
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/vendor/php-email-form/validate.js"></script>
  <script src="/vendor/aos/aos.js"></script>
  <script src="/vendor/purecounter/purecounter_vanilla.js"></script>
  <script src="/vendor/swiper/swiper-bundle.min.js"></script>
  <script src="/vendor/imagesloaded/imagesloaded.pkgd.min.js"></script>
  <script src="/vendor/isotope-layout/isotope.pkgd.min.js"></script>
  <script src="/vendor/glightbox/js/glightbox.min.js"></script>

  <!-- Main JS File -->
  <script src="/js/main.js"></script>

</body>

</html>


