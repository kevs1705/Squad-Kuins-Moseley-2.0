<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>Viviendas Unifamiliares - BYGGERR SRL</title>
  <meta name="description" content="Diseño y construcción de viviendas unifamiliares exclusivas. Creamos el hogar de sus sueños con BYGGERR SRL.">
  <meta name="keywords" content="viviendas unifamiliares, casas, construcción, diseño residencial, byggerr">

  <!-- Favicons -->
  <link href="/img/favicon.png" rel="icon">
  <link href="/img/apple-touch-icon.png" rel="apple-touch-icon">

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="/vendor/aos/aos.css" rel="stylesheet">
  <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
  <link href="/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
  <link href="/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="/css/main.css" rel="stylesheet">
</head>

<body class="proyectos-page"> <!-- Using proyectos-page class to inherit the always-visible overlay style if desired, or we can remove it if user wants hover effect here -->

  <header id="header" class="header d-flex align-items-center fixed-top">
    <div class="header-container container-fluid container-xl position-relative d-flex align-items-center justify-content-between">

      <a href="/index" class="logo d-flex align-items-center me-auto me-xl-0">
        <h1 class="sitename" style="color: #ffffff;">BYGGERR <span style="color: #279ae4;">SRL</span></h1>
      </a>

      <nav id="navmenu" class="navmenu">
        <ul>
          <li><a href="/index">Inicio</a></li>
          <li><a href="/nosotros">Nosotros</a></li>
          <li><a href="/servicios">Servicios</a></li>
          <li><a href="/proyectos-especiales">Proyectos Especiales</a></li>
          <li class="dropdown"><a href="#" class="active"><span>Viviendas</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
            <ul>
              <li><a href="/unifamiliares" class="active">Unifamiliares</a></li>
              <li><a href="/multifamiliares">Multifamiliares</a></li>
            </ul>
          </li>
        </ul>
        <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
      </nav>

      <a class="btn-getstarted" href="/contact">Contacto</a>
      <a class="btn-getstarted" href="/login">Iniciar sesión</a>

    </div>
  </header>

  <main class="main">

    <!-- Page Title -->
    <div class="page-title">
      <div class="breadcrumbs">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/index"><i class="bi bi-house"></i> Inicio</a></li>
            <li class="breadcrumb-item">Viviendas</li>
            <li class="breadcrumb-item active current">Unifamiliares</li>
          </ol>
        </nav>
      </div>

      <div class="title-wrapper">
        <h1>Viviendas Unifamiliares</h1>
        <p>Diseñamos y construimos hogares únicos, fusionando confort, funcionalidad y estilo personalizado.</p>
      </div>
    </div><!-- End Page Title -->

    <!-- Projects Gallery Section -->
    <section id="proyectos-gallery" class="gallery section">

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row g-4 justify-content-center">

          <% if (proyectos && proyectos.length) { %>
            <% proyectos.forEach((proyecto) => { 
                 const imageSrc = (proyecto.imagen || '').trim() ? proyecto.imagen : '/img/hero-construction.jpg';
                 const desc = proyecto.descripcion || '';
            %>
            <div class="col-lg-4 col-md-6 gallery-item">
              <div class="gallery-card always-hover" onclick="location.href='/project-details?id=<%= proyecto.id %>'" style="cursor: pointer;">
                <div class="gallery-img">
                  <img src="<%= imageSrc %>" class="img-fluid" alt="<%= proyecto.titulo %>">
                  <div class="gallery-overlay">
                    <div class="gallery-info">
                      <h4><%= proyecto.titulo %></h4>
                      <p><%= desc %></p>
                       <span class="btn-getstarted" style="font-size: 0.8rem; padding: 5px 15px; margin-top: 10px; display: inline-block; background: var(--accent-color); color: white; border-radius: 4px;">Ver Proyecto</span>
                    </div>
                  </div>
                </div>
              </div>
            </div><!-- End Gallery Item -->
            <% }); %>
          <% } else { %>
            <div class="col-12 text-center">
              <div class="alert alert-info" role="alert">
                <h4 class="alert-heading">Próximamente</h4>
                <p>Nuestros proyectos de viviendas unifamiliares estarán disponibles muy pronto.</p>
                <hr>
                <p class="mb-0">Mientras tanto, le invitamos a conocer nuestros <a href="/servicios">servicios</a> o <a href="/contact">contactarnos</a>.</p>
              </div>
              <div class="row g-4 mt-4 opacity-50">
                  <div class="col-lg-4 col-md-6 gallery-item">
                    <div class="gallery-card">
                      <div class="gallery-img">
                        <img src="/img/hero-construction.jpg" class="img-fluid" alt="Placeholder">
                        <div class="gallery-overlay"><div class="gallery-info"><h4>Residencia Ejemplo</h4></div></div>
                      </div>
                    </div>
                  </div>
              </div>
            </div>
          <% } %>

        </div>

      </div>

    </section><!-- /Projects Gallery Section -->

  </main>

  <footer id="footer" class="footer position-relative dark-background">

    <div class="container footer-top">
      <div class="row gy-4">
        <div class="col-lg-4 col-md-6 footer-about">
          <a href="/index" class="logo d-flex align-items-center">
            <span class="sitename">BYGGERR SRL</span>
          </a>
          <div class="footer-contact pt-3">
            <p>Av Ismael Montes 640</p>
            <p>La Paz, Bolivia</p>
            <p class="mt-3"><strong>Teléfono:</strong> <span>+591 712 34 567</span></p>
            <p><strong>Email:</strong> <span>contacto@byggerr.com</span></p>
            <p class="mt-2"><strong>Horario:</strong> <br>Lun - Vie: 8:00 AM - 6:00 PM</p>
          </div>
          <div class="social-links d-flex mt-4">
            <a href=""><i class="bi bi-twitter-x"></i></a>
            <a href=""><i class="bi bi-facebook"></i></a>
            <a href=""><i class="bi bi-instagram"></i></a>
            <a href=""><i class="bi bi-linkedin"></i></a>
          </div>
        </div>

        <div class="col-lg-2 col-md-3 footer-links">
          <h4>Enlaces Útiles</h4>
          <ul>
            <li><a href="/index">Inicio</a></li>
            <li><a href="/nosotros">Nosotros</a></li>
            <li><a href="/servicios">Servicios</a></li>
            <li><a href="#">Términos de servicio</a></li>
            <li><a href="#">Política de privacidad</a></li>
          </ul>
        </div>

        <div class="col-lg-2 col-md-3 footer-links">
          <h4>Nuestros Servicios</h4>
          <ul>
            <li><a href="/servicios">Diseño Arquitectónico</a></li>
            <li><a href="/servicios">Construcción Civil</a></li>
            <li><a href="/servicios">Gestión de Obras</a></li>
            <li><a href="/servicios">Remodelaciones</a></li>
            <li><a href="/servicios">Consultoría</a></li>
          </ul>
        </div>

        <div class="col-lg-2 col-md-3 footer-links">
          <h4>Proyectos</h4>
          <ul>
            <li><a href="/unifamiliares">Viviendas Unifamiliares</a></li>
            <li><a href="/multifamiliares">Edificios Residenciales</a></li>
            <li><a href="/proyectos-especiales">Proyectos Especiales</a></li>
          </ul>
        </div>

      </div>
    </div>

    <div class="container copyright text-center mt-4">
      <p>© <span>Copyright</span> <strong class="px-1 sitename">BYGGERR SRL</strong> <span>Todos los derechos reservados</span></p>
      <div class="credits">
      </div>
    </div>

  </footer>

  <!-- Scroll Top -->
  <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

  <!-- Preloader -->
  <div id="preloader"></div>

  <!-- Vendor JS Files -->
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/vendor/php-email-form/validate.js"></script>
  <script src="/vendor/aos/aos.js"></script>
  <script src="/vendor/purecounter/purecounter_vanilla.js"></script>
  <script src="/vendor/swiper/swiper-bundle.min.js"></script>
  <script src="/vendor/imagesloaded/imagesloaded.pkgd.min.js"></script>
  <script src="/vendor/isotope-layout/isotope.pkgd.min.js"></script>
  <script src="/vendor/glightbox/js/glightbox.min.js"></script>

  <!-- Main JS File -->
  <script src="/js/main.js"></script>

</body>

</html>


