<body class="services-page">

  <header id="header" class="header d-flex align-items-center fixed-top">
    <div class="header-container container-fluid container-xl position-relative d-flex align-items-center justify-content-between">

      <a href="/index" class="logo d-flex align-items-center me-auto me-xl-0">
        <h1 class="sitename" style="color: #ffffff;">BYGGERR <span style="color: #279ae4;">SRL</span></h1>
      </a>

      <nav id="navmenu" class="navmenu">
        <ul>
          <li><a href="/index">Inicio</a></li>
          <li><a href="/nosotros">Nosotros</a></li>
          <li><a href="/servicios" class="active">Servicios</a></li>
          <li><a href="/proyectos-especiales">Proyectos Especiales</a></li>
          <li class="dropdown"><a href="#"><span>Viviendas</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
            <ul>
              <li><a href="/unifamiliares">Unifamiliares</a></li>
              <li><a href="/multifamiliares">Multifamiliares</a></li>
            </ul>
          </li>
        </ul>
        <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
      </nav>

      <a class="btn-getstarted" href="/contact">Contacto</a>
      <a class="btn-getstarted" href="/login">Iniciar sesión</a>

    </div>
  </header>

  <main class="main">

    <!-- Page Title -->
    <div class="page-title">
      <div class="breadcrumbs">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/index"><i class="bi bi-house"></i> Inicio</a></li>
            <li class="breadcrumb-item active current">Servicios</li>
          </ol>
        </nav>
      </div>

      <div class="title-wrapper">
        <h1>Nuestros Servicios</h1>
        <p>Soluciones integrales de construcción diseñadas para cumplir con los más altos estándares de calidad y seguridad.</p>
      </div>
    </div><!-- End Page Title -->

    <!-- Services Section -->
    <section id="services" class="services section">

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="services-tabs">
          <ul class="nav nav-tabs" role="tablist" data-aos="fade-up" data-aos-delay="200">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" id="services-design-tab" data-bs-toggle="tab" data-bs-target="#services-design" type="button" role="tab">Diseño y Planificación</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="services-construction-tab" data-bs-toggle="tab" data-bs-target="#services-construction" type="button" role="tab">Construcción Civil</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="services-management-tab" data-bs-toggle="tab" data-bs-target="#services-management" type="button" role="tab">Gestión de Proyectos</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="services-remodelacion-tab" data-bs-toggle="tab" data-bs-target="#services-remodelacion" type="button" role="tab">Remodelación</button>
            </li>
          </ul>

          <div class="tab-content" data-aos="fade-up" data-aos-delay="300">

            <div class="tab-pane fade show active" id="services-design" role="tabpanel">
              <div class="row g-4">
                <div class="col-12">
                  <div class="service-item d-flex flex-column flex-md-row align-items-center">
                    <div class="service-img">
                      <img src="/img/service-design.jpg" class="img-fluid" alt="Diseño Arquitectónico">
                    </div>
                    <div class="service-details flex-grow-1">
                      <div class="service-icon-wrapper mb-3">
                        <i class="fa fa-pencil-ruler"></i>
                      </div>
                      <h5>Diseño Arquitectónico</h5>
                      <p>Creamos planos innovadores y funcionales que aprovechan al máximo cada espacio, combinando estética y utilidad. Utilizamos herramientas BIM para previsualizar cada detalle.</p>
                      <ul class="service-benefits">
                        <li><i class="fa fa-check-circle"></i>Planos Personalizados</li>
                        <li><i class="fa fa-check-circle"></i>Renderizado 3D y Recorridos Virtuales</li>
                        <li><i class="fa fa-check-circle"></i>Diseño Sostenible y Bioclimático</li>
                      </ul>
                    </div>
                  </div>
                </div>

                <div class="col-12">
                  <div class="service-item d-flex flex-column flex-md-row align-items-center">
                    <div class="service-img">
                      <img src="/img/hero-construction.jpg" class="img-fluid" alt="Cálculo Estructural">
                    </div>
                    <div class="service-details flex-grow-1">
                      <div class="service-icon-wrapper mb-3">
                        <i class="fa fa-calculator"></i>
                      </div>
                      <h5>Cálculo Estructural</h5>
                      <p>Garantizamos la seguridad y estabilidad de su edificación con cálculos precisos y cumplimiento estricto de normativas locales e internacionales.</p>
                      <ul class="service-benefits">
                        <li><i class="fa fa-check-circle"></i>Análisis de Cargas y Resistencia</li>
                        <li><i class="fa fa-check-circle"></i>Optimización de Materiales</li>
                        <li><i class="fa fa-check-circle"></i>Seguridad Sísmica</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="tab-pane fade" id="services-construction" role="tabpanel">
              <div class="row g-4">
                <div class="col-12">
                  <div class="service-item featured d-flex flex-column flex-md-row align-items-center">
                    <div class="service-img">
                      <img src="/img/cta-bg.jpg" class="img-fluid" alt="Edificación Vertical">
                    </div>
                    <div class="service-details flex-grow-1">
                      <div class="service-icon-wrapper mb-3">
                        <i class="fa fa-building"></i>
                      </div>
                      <h5>Edificación Vertical</h5>
                      <p>Construcción de edificios residenciales y comerciales con tecnología de punta y acabados de primera calidad. Expertos en estructuras de altura.</p>
                      <ul class="service-benefits">
                        <li><i class="fa fa-check-circle"></i>Torres de Apartamentos</li>
                        <li><i class="fa fa-check-circle"></i>Edificios de Oficinas Modernos</li>
                        <li><i class="fa fa-check-circle"></i>Centros Comerciales y Plazas</li>
                      </ul>
                    </div>
                  </div>
                </div>

                <div class="col-12">
                  <div class="service-item d-flex flex-column flex-md-row align-items-center">
                    <div class="service-img">
                      <img src="/img/hero-construction.jpg" class="img-fluid" alt="Viviendas Unifamiliares">
                    </div>
                    <div class="service-details flex-grow-1">
                      <div class="service-icon-wrapper mb-3">
                        <i class="fa fa-home"></i>
                      </div>
                      <h5>Viviendas Unifamiliares</h5>
                      <p>Construimos el hogar de sus sueños, cuidando cada detalle desde la cimentación hasta los acabados finales, garantizando confort y durabilidad.</p>
                      <ul class="service-benefits">
                        <li><i class="fa fa-check-circle"></i>Casas Modernas y Minimalistas</li>
                        <li><i class="fa fa-check-circle"></i>Residencias de Lujo</li>
                        <li><i class="fa fa-check-circle"></i>Urbanizaciones y Condominios</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="tab-pane fade" id="services-management" role="tabpanel">
              <div class="row g-4">
                <div class="col-12">
                  <div class="service-item d-flex flex-column flex-md-row align-items-center">
                    <div class="service-img">
                      <img src="/img/service-design.jpg" class="img-fluid" alt="Supervisión de Obras">
                    </div>
                    <div class="service-details flex-grow-1">
                      <div class="service-icon-wrapper mb-3">
                        <i class="fa fa-tasks"></i>
                      </div>
                      <h5>Supervisión de Obras</h5>
                      <p>Aseguramos que cada etapa del proyecto se ejecute según lo planificado, controlando estrictamente la calidad, los costos y los plazos de entrega.</p>
                      <ul class="service-benefits">
                        <li><i class="fa fa-check-circle"></i>Control de Calidad Riguroso</li>
                        <li><i class="fa fa-check-circle"></i>Gestión Eficiente de Presupuestos</li>
                        <li><i class="fa fa-check-circle"></i>Seguimiento de Cronogramas</li>
                      </ul>
                    </div>
                  </div>
                </div>

                <div class="col-12">
                  <div class="service-item d-flex flex-column flex-md-row align-items-center">
                    <div class="service-img">
                      <img src="/img/cta-bg.jpg" class="img-fluid" alt="Consultoría Técnica">
                    </div>
                    <div class="service-details flex-grow-1">
                      <div class="service-icon-wrapper mb-3">
                        <i class="fa fa-handshake"></i>
                      </div>
                      <h5>Consultoría Técnica</h5>
                      <p>Asesoramiento experto para determinar la viabilidad de proyectos, gestión de trámites legales y optimización de recursos constructivos.</p>
                      <ul class="service-benefits">
                        <li><i class="fa fa-check-circle"></i>Estudios de Viabilidad Económica</li>
                        <li><i class="fa fa-check-circle"></i>Gestión de Permisos y Licencias</li>
                        <li><i class="fa fa-check-circle"></i>Auditorías Técnicas y Peritajes</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="tab-pane fade" id="services-remodelacion" role="tabpanel">
              <div class="row g-4">
                <div class="col-12">
                  <div class="service-item d-flex flex-column flex-md-row align-items-center">
                    <div class="service-img">
                      <img src="/img/hero-construction.jpg" class="img-fluid" alt="Remodelación de Interiores">
                    </div>
                    <div class="service-details flex-grow-1">
                      <div class="service-icon-wrapper mb-3">
                        <i class="fa fa-paint-roller"></i>
                      </div>
                      <h5>Remodelación de Interiores</h5>
                      <p>Transformamos espacios interiores para modernizarlos y optimizar su funcionalidad. Renovación de cocinas, baños, oficinas y espacios comerciales.</p>
                      <ul class="service-benefits">
                        <li><i class="fa fa-check-circle"></i>Diseño de Interiores</li>
                        <li><i class="fa fa-check-circle"></i>Acabados de Alta Calidad</li>
                        <li><i class="fa fa-check-circle"></i>Optimización de Espacios</li>
                      </ul>
                    </div>
                  </div>
                </div>

                <div class="col-12">
                  <div class="service-item d-flex flex-column flex-md-row align-items-center">
                    <div class="service-img">
                      <img src="/img/cta-bg.jpg" class="img-fluid" alt="Restauración de Fachadas">
                    </div>
                    <div class="service-details flex-grow-1">
                      <div class="service-icon-wrapper mb-3">
                        <i class="fa fa-brush"></i>
                      </div>
                      <h5>Restauración de Fachadas</h5>
                      <p>Devolvemos el esplendor a las fachadas de edificios y viviendas, mejorando su estética y protegiéndolas contra los elementos.</p>
                      <ul class="service-benefits">
                        <li><i class="fa fa-check-circle"></i>Pintura y Revestimientos</li>
                        <li><i class="fa fa-check-circle"></i>Reparación de Grietas</li>
                        <li><i class="fa fa-check-circle"></i>Impermeabilización</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>



      </div>

    </section><!-- /Services Section -->

    <!-- Featured Projects Section -->
    <section id="featured-projects" class="gallery section bg-light" style="background-color: #0b1526 !important;"> <!-- Darker background for contrast -->
      <div class="container" data-aos="fade-up">
        
        <div class="section-title text-center mb-5">
          <h2 style="color: #fff; font-size: 32px; font-weight: 700;">Proyectos Destacados</h2>
          <p style="color: rgba(255,255,255,0.7);">Obras recientes que demuestran nuestra calidad y compromiso</p>
        </div>

        <div class="row g-4 justify-content-center">
          <% if (proyectos_destacados && proyectos_destacados.length) { %>
            <% proyectos_destacados.forEach((proyecto) => { 
                 const imageSrc = (proyecto.imagen || '').trim() ? proyecto.imagen : '/img/hero-construction.jpg';
                 const categoria = proyecto.categoria || '';
            %>
            <div class="col-lg-4 col-md-6 gallery-item">
              <div class="gallery-card">
                <div class="gallery-img">
                  <img src="<%= imageSrc %>" class="img-fluid" alt="<%= proyecto.titulo %>">
                  <div class="gallery-overlay">
                    <div class="gallery-info">
                      <h4><%= proyecto.titulo %></h4>
                      <p><%= categoria %></p>
                      <a href="<%= imageSrc %>" class="glightbox gallery-link" data-gallery="featured-projects" title="<%= proyecto.titulo %>">
                        <i class="bi bi-zoom-in"></i>
                      </a>
                      <a href="/project-details?id=<%= proyecto.id %>" class="details-link" title="Ver Detalles">
                        <i class="bi bi-arrow-right"></i>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <% }); %>
          <% } else { %>
             <div class="col-12 text-center text-white">
                <p>Pronto publicaremos nuestros proyectos destacados.</p>
             </div>
          <% } %>
        </div>
        
        <div class="text-center mt-5">
            <a href="/proyectos-especiales" class="btn-getstarted" style="display: inline-block; padding: 12px 30px; border-radius: 50px;">Ver Todos los Proyectos</a>
        </div>

      </div>
    </section>
    
    <!-- CTA Section (Moved) -->
    <section class="services section">
      <div class="container">
        <div class="services-cta" data-aos="fade-up">
          <div class="row">
            <div class="col-lg-8 mx-auto text-center">
              <div class="cta-content">
                <i class="fa fa-hard-hat"></i>
                <h3>¿Listo para Construir su Futuro?</h3>
                <p>Contáctenos hoy mismo para recibir una consulta personalizada y un presupuesto detallado para su próximo proyecto.</p>
                <div class="cta-buttons">
                  <a href="/index#contact" class="btn-book">Solicitar Presupuesto</a>
                  <a href="/contact" class="btn-contact">Contactar Ahora</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

