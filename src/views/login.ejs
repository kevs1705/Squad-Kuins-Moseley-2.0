<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title><%= title || 'Iniciar sesión — MONSELEY' %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="/css/login.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
  <main class="card" role="main" aria-label="Formulario de acceso">
    <a href="/" class="back-to-web" title="Volver a la página web">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
        <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
      </svg>
      <span>Volver a la página web</span>
    </a>
   
    <header>
      <img src="/img/logo.png" alt="Logo de la empresa" class="logo" />
      <div class="brand" aria-label="Identidad visual">
        <span class="brand-name">BYGGER SRL · MONSELEY</span>
      </div>
      <div class="brand-divider"></div>
      <h1 class="title">Bienvenido de nuevo</h1>
      <p class="subtitle">Inicia sesión para acceder a tu cuenta</p>
    </header>
 
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-box" role="alert"><%= error %></div>
    <% } %>
 
    <form id="login-form" action="/login" method="post" novalidate>
      <div class="field">
        <label for="ci">CI</label>
        <div class="control" id="wrap-ci">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="input-icon">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <input
            id="ci" name="ci"
            type="text"
            placeholder="Ingresa tu CI"
            inputmode="numeric"
            autocomplete="username"
            maxlength="16"
            required
            aria-describedby="ci-msg"
          />
        </div>
        <div id="ci-msg" class="msg" aria-live="polite"></div>
      </div>
 
      <div class="field">
        <label for="password">Contraseña</label>
        <div class="control" id="wrap-password">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="input-icon">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <input
            id="password" name="password"
            type="password"
            placeholder="••••••••"
            autocomplete="current-password"
            maxlength="16"
            required
            aria-describedby="pwd-msg"
          />
          <button type="button" class="toggle" id="toggle-pwd" aria-label="Mostrar contraseña" aria-pressed="false">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye-icon">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        </div>
        <div id="pwd-msg" class="msg" aria-live="polite"></div>
      </div>
 
      <button id="btn-submit" type="submit" class="btn">Iniciar sesión</button>
    </form>
 
    <p class="foot">© <%= new Date().getFullYear() %> BYGGER SRL · Todos los derechos reservados.</p>
  </main>
 
  <script>
    const $ = s => document.querySelector(s);
 
    const form   = $('#login-form');
    const ci     = $('#ci');
    const pwd    = $('#password');
    const btn    = $('#btn-submit');
    const wrapCI = $('#wrap-ci');
    const wrapPW = $('#wrap-password');
    const msgCI  = $('#ci-msg');
    const msgPW  = $('#pwd-msg');
    const toggle = $('#toggle-pwd');
 
    let submitted = false;
 
    // --- Permitir solo números en el CI ---
    ci.addEventListener('input', () => {
      ci.value = ci.value.replace(/\D/g, '');
      if (submitted) {
        validateCI();
      }
    });
 
    pwd.addEventListener('input', () => {
      if (submitted) {
        validatePwd();
      }
    });
 
    // --- Toggle "ojito" ---
    function togglePwd(){
      const show = pwd.type === 'password';
      pwd.type = show ? 'text' : 'password';
      toggle.setAttribute('aria-pressed', String(show));
      toggle.setAttribute('aria-label', show ? 'Ocultar contraseña' : 'Mostrar contraseña');
     
      if (show) {
        toggle.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye-icon">
            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
            <line x1="1" y1="1" x2="23" y2="23"></line>
          </svg>
        `;
      } else {
        toggle.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye-icon">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        `;
      }
      toggle.focus({ preventScroll: true });
    }
    toggle.addEventListener('click', togglePwd);
    toggle.addEventListener('keydown', (e) => { if(e.key==='Enter' || e.key===' '){ e.preventDefault(); togglePwd(); } });
 
    // --- Validaciones visuales ---
    function setErr(ctrlEl, msgEl, text){
      ctrlEl.classList.add('error');
      msgEl.textContent = text;
      msgEl.classList.add('error');
    }
    function clearErr(ctrlEl, msgEl){
      ctrlEl.classList.remove('error');
      msgEl.textContent = '';
      msgEl.classList.remove('error');
    }
 
    function validateCI(){
      const v = ci.value.trim();
      if(!v) {
        setErr(wrapCI, msgCI, 'El CI es requerido.');
        return false;
      }
      if(!/^\d+$/.test(v)){
        setErr(wrapCI, msgCI, 'Ingresa solo números.');
        return false;
      }
      clearErr(wrapCI, msgCI);
      return true;
    }
 
    function validatePwd(){
      const v = pwd.value;
      if(!v){
        setErr(wrapPW, msgPW, 'La contraseña es requerida.');
        return false;
      }
      clearErr(wrapPW, msgPW);
      return true;
    }
 
    form.addEventListener('submit', (e) => {
      submitted = true;
      const isCIValid = validateCI();
      const isPwdValid = validatePwd();
     
      if(!isCIValid || !isPwdValid){
        e.preventDefault();
        return;
      }
     
      btn.disabled = true;
      btn.textContent = 'Ingresando…';
    });
 
   /* <% if (typeof error !== 'undefined' && error) { %>
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: '<%= error %>',
        confirmButtonColor: '#0F5FA6'
      });
    <% } %>*/
  </script>
</body>
</html>