<% pageTitle='Panel de Mi Horario' ; pageSubtitle='Configuración y programación de jornadas de pasantía' ; %>
<%- include('../partials/header') %>

<link rel="stylesheet" href="/css/horario.css">

<div class="horario-wrapper">

  <!-- Header del Módulo -->
  <div class="horario-header-row">
    <h2 class="horario-header-title">Mi Horario</h2>
    <p class="horario-header-user">
      <i class="bi bi-person me-1"></i>Usuario: <strong><%= user.nombre %></strong> | CI: <%= user.ci %>
    </p>
  </div>

  <!-- METRICAS SUPERIORES -->
  <% 
    const horasRequeridas = user.horas_requeridas || 280; 
    const horasPrevias = user.horas_previas || 0; 
    const horasSistema = (typeof totalHorasSistema !== 'undefined') ? totalHorasSistema : 0; 
    const totalAcumulado = horasPrevias + horasSistema; 
    const porcentaje = Math.min(100, Math.round((totalAcumulado / horasRequeridas) * 100)); 
  %>

  <div class="horario-stats-grid">
    <div class="horario-stat-card">
      <div class="horario-stat-header">
        <div class="horario-stat-title">Meta Carrera</div>
      </div>
      <div class="horario-stat-value">
        <%= horasRequeridas %> <span style="font-size: 1.1rem; font-weight: 500;">hrs</span>
      </div>
    </div>

    <div class="horario-stat-card">
      <div class="horario-stat-header">
        <div class="horario-stat-title">Total Acumulado</div>
      </div>
      <div class="horario-stat-value">
        <%= String(Math.round(totalAcumulado)).padStart(3, '0') %> / <%= horasRequeridas %> 
        <span style="font-size: 1.1rem; font-weight: 500;">hrs</span>
      </div>
      <div class="horario-progress-container">
        <div class="horario-progress-fill" style="width: <%= porcentaje %>%;"></div>
      </div>
    </div>
  </div>

  <!-- CONTENEDOR PRINCIPAL DE 2 COLUMNAS -->
  <div class="horario-two-columns">

    <!-- COLUMNA IZQUIERDA: FORMULARIO -->
    <div class="horario-col-form">
      <div class="card-form">
        <div class="card-title">
          <i class="bi bi-sliders me-2 text-primary"></i>Configurar Horario
        </div>

        <p class="card-subtitle">
          Establece los días y las horas de tu jornada de pasantía para proyectar tu agenda.
        </p>

        <form action="/usuario/horario" method="POST" id="formHorario">

          <!-- SELECCIÓN MÚLTIPLE DE DÍAS -->
          <div class="form-group mb-3">
            <label class="form-label fw-bold mb-2 text-dark">
              Días de asistencia:
            </label>
            <div class="dias-checkbox-container">
              <label class="checkbox-day">
                <input type="checkbox" name="dias_semana" value="1"> Lun
              </label>
              <label class="checkbox-day">
                <input type="checkbox" name="dias_semana" value="2"> Mar
              </label>
              <label class="checkbox-day">
                <input type="checkbox" name="dias_semana" value="3"> Mié
              </label>
              <label class="checkbox-day">
                <input type="checkbox" name="dias_semana" value="4"> Jue
              </label>
              <label class="checkbox-day">
                <input type="checkbox" name="dias_semana" value="5"> Vie
              </label>
              <label class="checkbox-day">
                <input type="checkbox" name="dias_semana" value="6"> Sáb
              </label>
            </div>
          </div>

          <!-- ENTRADAS VERTICALES -->
          <div class="form-grid">
            <div class="form-group">
              <label for="hora_entrada">Hora de entrada</label>
              <input type="time" name="hora_entrada" id="hora_entrada" class="form-control" value="08:00" required>
            </div>

            <div class="form-group">
              <label for="horas">Horas de pasantía</label>
              <select name="horas" id="horas" class="form-select">
                <option value="4" selected>4 horas</option>
                <option value="6">6 horas</option>
                <option value="8">8 horas</option>
                <option value="custom">Personalizado (Manual)</option>
              </select>
            </div>

            <div class="form-group">
              <label for="hora_salida">Hora de salida</label>
              <input type="time" name="hora_salida" id="hora_salida" class="form-control" value="12:00" required>
            </div>
          </div>

          <div id="alertaHorario" class="time-warning">
            ⚠️ La hora de salida debe ser posterior a la hora de entrada.
          </div>

          <div class="total-box">
            <span>Horas calculadas por día:</span>
            <strong id="totalHoras">4.0 hrs</strong>
          </div>

          <button type="submit" class="btn-submit" id="btnGuardar">
            <i class="bi bi-check-circle me-1"></i> Guardar Configuración
          </button>
        </form>
      </div>
    </div>

  <!-- COLUMNA DERECHA: VISTA CALENDARIO / AGENDA REDUCIDA Y EDITABLE -->
<div class="horario-col-tabla">
  <div class="card-form">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div class="card-title mb-0">
        <i class="bi bi-calendar3 me-2 text-primary"></i>Mi Agenda Semanal
      </div>
      <span class="badge bg-light text-dark border fw-normal px-2 py-1">
        <i class="bi bi-clock-history me-1"></i>Jornada Regular
      </span>
    </div>

    <div class="calendar-timeline-container compact-calendar">
      
      <!-- Encabezado con los nombres completos de los días -->
      <div class="calendar-header-days">
        <div class="time-col-header">Hora</div>
        <div class="day-col-header">Lunes</div>
        <div class="day-col-header">Martes</div>
        <div class="day-col-header">Miércoles</div>
        <div class="day-col-header">Jueves</div>
        <div class="day-col-header">Viernes</div>
        <div class="day-col-header">Sábado</div>
      </div>

      <!-- Malla de Horas y Tarjetas -->
      <div class="calendar-body-grid">
        
        <!-- Marcadores de hora reducidos (36px por bloque de hora) -->
        <div class="time-axis">
          <div>07:00</div>
          <div>08:00</div>
          <div>09:00</div>
          <div>10:00</div>
          <div>11:00</div>
          <div>12:00</div>
          <div>13:00</div>
          <div>14:00</div>
          <div>15:00</div>
          <div>16:00</div>
          <div>17:00</div>
          <div>18:00</div>
        </div>

        <!-- Grilla Semanal -->
        <div class="days-columns-wrapper">
          <% const diasMapa = [1, 2, 3, 4, 5, 6]; %>
          <% diasMapa.forEach(diaNum => { %>
            <% const horarioDia = horarios ? horarios.find(h => h.dia_semana === diaNum) : null; %>
            
            <div class="day-column">
              <% if (horarioDia) { %>
                <% 
                  const [hE, mE] = horarioDia.hora_entrada.split(':').map(Number);
                  const [hS, mS] = horarioDia.hora_salida.split(':').map(Number);
                  
                  // Altura compacta: 36px por cada hora (Base 07:00 AM)
                  const topPx = ((hE - 7) * 36) + ((mE / 60) * 36);
                  const duracionMin = ((hS * 60) + mS) - ((hE * 60) + mE);
                  const heightPx = (duracionMin / 60) * 36;

                  // Asignar 2 paletas de colores distintas (ej. azul para lun-vie, morado/índigo para sábado)
                  const colorClass = (diaNum === 6) ? 'palette-purple' : 'palette-blue';
                %>
                
                <div class="calendar-event-card <%= colorClass %>" style="top: <%= topPx %>px; height: <%= heightPx %>px;">
                  
                  <!-- BOTÓN DE ELIMINACIÓN DIRECTA -->
                  <form action="/usuario/horario/eliminar/<%= horarioDia.id_horario %>" method="POST" class="delete-day-form" onsubmit="return confirm('¿Seguro que deseas eliminar el horario de este día?');">
                    <button type="submit" class="btn-delete-event" title="Eliminar este día">
                      <i class="bi bi-x"></i>
                    </button>
                  </form>

                  <div class="event-title">
                    <i class="bi bi-briefcase-fill me-1"></i>Pasantía
                  </div>
                  <div class="event-time">
                    <%= horarioDia.hora_entrada.slice(0,5) %> - <%= horarioDia.hora_salida.slice(0,5) %>
                  </div>
                  <div class="event-badge">
                    <%= (duracionMin/60).toFixed(1) %> hrs
                  </div>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>

      </div>
    </div>

  </div>
</div>

  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const entrada = document.getElementById('hora_entrada');
    const salida = document.getElementById('hora_salida');
    const selectorHoras = document.getElementById('horas');
    const totalLabel = document.getElementById('totalHoras');
    const alertaHorario = document.getElementById('alertaHorario');
    const form = document.getElementById('formHorario');
    const btnGuardar = document.getElementById('btnGuardar');

    function calcularDesdePreset() {
      if (!entrada.value) return;
      if (selectorHoras.value === 'custom') {
        calcularDesdeSalida();
        return;
      }

      const [hora, minutos] = entrada.value.split(':').map(Number);
      const duracionHoras = parseFloat(selectorHoras.value);

      if (isNaN(hora) || isNaN(minutos) || isNaN(duracionHoras)) return;

      const totalMin = (hora * 60 + minutos) + Math.round(duracionHoras * 60);
      const hSalida = Math.floor((totalMin / 60) % 24);
      const mSalida = Math.round(totalMin % 60);

      salida.value = `${String(hSalida).padStart(2, '0')}:${String(mSalida).padStart(2, '0')}`;
      validarYActualizarEtiqueta();
    }

    function calcularDesdeSalida() {
      if (!entrada.value || !salida.value) return;

      const [hEntrada, mEntrada] = entrada.value.split(':').map(Number);
      const [hSalida, mSalida] = salida.value.split(':').map(Number);

      const minEntrada = hEntrada * 60 + mEntrada;
      const minSalida = hSalida * 60 + mSalida;
      const diffMinutos = minSalida - minEntrada;

      if (diffMinutos > 0) {
        const horasDecimales = (diffMinutos / 60);
        const valorEntero = horasDecimales.toString();
        const opcionesExistentes = ['4', '6', '8'];

        if (opcionesExistentes.includes(valorEntero)) {
          selectorHoras.value = valorEntero;
        } else {
          selectorHoras.value = 'custom';
        }
      }

      validarYActualizarEtiqueta();
    }

    function validarYActualizarEtiqueta() {
      if (!entrada.value || !salida.value) return;

      const [hEntrada, mEntrada] = entrada.value.split(':').map(Number);
      const [hSalida, mSalida] = salida.value.split(':').map(Number);

      const minEntrada = hEntrada * 60 + mEntrada;
      const minSalida = hSalida * 60 + mSalida;
      const diffMinutos = minSalida - minEntrada;

      if (diffMinutos <= 0) {
        if (alertaHorario) alertaHorario.style.display = 'block';
        totalLabel.textContent = 'Horario inválido';
        totalLabel.style.color = '#dc2626';
        if (btnGuardar) btnGuardar.disabled = true;
      } else {
        if (alertaHorario) alertaHorario.style.display = 'none';
        const horasDec = (diffMinutos / 60).toFixed(1);
        totalLabel.textContent = `${horasDec} hrs`;
        totalLabel.style.color = '#000000';
        if (btnGuardar) btnGuardar.disabled = false;
      }
    }

    selectorHoras.addEventListener('change', () => {
      if (selectorHoras.value !== 'custom') {
        calcularDesdePreset();
      } else {
        calcularDesdeSalida();
      }
    });

    entrada.addEventListener('input', () => {
      if (selectorHoras.value !== 'custom') {
        calcularDesdePreset();
      } else {
        calcularDesdeSalida();
      }
    });

    salida.addEventListener('input', calcularDesdeSalida);

    if (form) {
      form.addEventListener('submit', (e) => {
        const diasSeleccionados = document.querySelectorAll('input[name="dias_semana"]:checked');
        if (diasSeleccionados.length === 0) {
          e.preventDefault();
          alert('Por favor, seleccione al menos un día de la semana.');
          return;
        }

        const [hEntrada, mEntrada] = entrada.value.split(':').map(Number);
        const [hSalida, mSalida] = salida.value.split(':').map(Number);
        const diffMinutos = (hSalida * 60 + mSalida) - (hEntrada * 60 + mEntrada);

        if (diffMinutos <= 0) {
          e.preventDefault();
          alert('La hora de salida debe ser posterior a la hora de entrada.');
          return;
        }
      });
    }

    calcularDesdePreset();
  });
</script>

<%- include('../partials/footer') %>