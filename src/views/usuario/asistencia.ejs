<%- include('../partials/header') %>

<!-- Hoja de estilos independiente -->
<link rel="stylesheet" href="/css/reporte_asistencia.css">

<div class="asistencia-wrapper py-3">
  
  <!-- Header del Módulo -->
  <div class="asistencia-header-row">
    <div>
      <h2 class="asistencia-header-title">Mis Jornadas</h2>
      <p class="asistencia-header-user">
        <i class="bi bi-person me-1"></i>Usuario: <strong><%= user.nombre %></strong> | CI: <%= user.ci %>
      </p>
    </div>
    <div>
      <a href="/usuario/reporte" class="btn-bitacora-link">
        <i class="bi bi-journal-text me-1"></i> Ir a Bitácoras y Reportes
      </a>
    </div>
  </div>

  <div class="asistencia-flex-row">
    <!-- Tarjeta 1: Total Acumulado -->
    <div class="asistencia-col-totales">
      <div class="card-horas-totales">
        <div class="card-horas-header">
          <i class="bi bi-clock me-2"></i>Horas totales acumuladas
        </div>
        <div class="card-horas-body">
          <h1 class="horas-value-text"><%= total_acumulada || '00:00:00' %><span class="horas-unit-text">hrs</span></h1>
        </div>
      </div>
    </div>

    <!-- Tarjeta 2: Panel de Verificación GPS / Geocerca -->
    <div class="asistencia-col-jornada">
      <div class="card-jornada-hoy">
        <div class="jornada-top-row">
          <div class="jornada-title-box">
            <div class="icon-calendar-circle">
              <i class="bi bi-calendar-event"></i>
            </div>
            <div>
              <h5 class="jornada-title-text">Jornada de hoy</h5>
              <span class="badge-jornada-status <%= jornadaActiva ? 'active' : '' %>">
                <i class="bi bi-circle-fill" style="font-size: 0.45rem;"></i> <%= jornadaActiva ? 'Jornada en curso' : 'Sin jornada activa' %>
              </span>
            </div>
          </div>
          <div class="jornada-watermark-icon">
            <i class="bi bi-geo-alt-fill"></i>
          </div>
        </div>

        <div class="jornada-gps-section">
          <h6 class="jornada-gps-title">Estado de marcación GPS</h6>
          <% if (jornadaActiva) { %>
            <p class="jornada-gps-desc">
              Tienes una jornada <strong>EN CURSO</strong> iniciada a las <strong><%= jornadaActiva.hora_entrada %></strong> en <strong><%= jornadaActiva.lugar_nombre %></strong>.
            </p>
            <div class="d-flex justify-content-end">
              <a href="/geofence" class="btn-gps-action">
                <i class="bi bi-geo-alt-fill me-2"></i>Verificar GPS para Marcar Salida
              </a>
            </div>
          <% } else { %>
            <p class="jornada-gps-desc">
              No tienes ninguna jornada activa hoy.<br>Para registrar entrada debes verificar tu posición GPS.
            </p>
            <div class="d-flex justify-content-end">
              <a href="/geofence" class="btn-gps-action">
                <i class="bi bi-geo-alt-fill me-2"></i>Verificar GPS e iniciar jornada
              </a>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabla Histórica de Asistencias -->
  <div class="card-historial">
    <h5 class="historial-header-title">Historial de jornadas</h5>

    <!-- Fila de Filtros / Controles (Primero Fecha, Segundo Búsqueda) -->
    <div class="historial-controls-row">
      <div class="filter-field-group filter-date-box">
        <label for="historialDateFilter" class="filter-field-label">Filtrar por fecha:</label>
        <div class="input-icon-wrapper">
          <i class="bi bi-calendar3"></i>
          <input type="date" id="historialDateFilter" class="form-control" title="Filtrar por fecha">
        </div>
      </div>
      <div class="filter-field-group search-input-box">
        <label for="historialSearch" class="filter-field-label">Búsqueda:</label>
        <div class="input-icon-wrapper">
          <i class="bi bi-search"></i>
          <input type="text" id="historialSearch" class="form-control" placeholder="Buscar por obra / lugar">
        </div>
      </div>
    </div>

    <div class="table-historial-wrapper">
      <table class="table table-historial align-middle">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Obra / lugar</th>
            <th>Hora entrada</th>
            <th>Hora salida</th>
            <th>Duración</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody>
          <% if (asistencias && asistencias.length > 0) { %>
            <% asistencias.forEach(a => { %>
              <tr>
                <td>
                  <i class="bi bi-calendar2-event me-2 text-primary"></i><strong><%= a.fecha %></strong>
                </td>
                <td>
                  <span class="obra-nombre"><%= a.lugar_nombre || 'Sin asignación' %></span>
                  <% if(a.lugar_tipo) { %>
                    <br><span class="obra-tipo">(<%= a.lugar_tipo %>)</span>
                  <% } %>
                </td>
                <td>
                  <%= a.hora_entrada || '-' %>
                  <% if(a.bio_entrada) { %>
                    <span class="dot-indicator-cyan" title="Huella Biométrica: <%= a.bio_entrada %>"></span>
                  <% } %>
                </td>
                <td>
                  <%= a.hora_salida || '-' %>
                  <% if(a.bio_salida) { %>
                    <span class="dot-indicator-cyan" title="Huella Biométrica: <%= a.bio_salida %>"></span>
                  <% } %>
                </td>
                <% 
                  const tieneSalida = (a.hora_salida && a.hora_salida !== '-') || 
                                      (a.bio_salida && a.bio_salida !== '-') || 
                                      (a.fecha_hora_biometrico_salida && a.fecha_hora_biometrico_salida !== '-');
                %>
                <td>
                  <%= tieneSalida ? (a.horas_dia !== 'En curso' ? a.horas_dia : 'Finalizado') : 'En curso' %>
                </td>
                <td>
                  <span class="badge-estado-pill <%= tieneSalida ? 'badge-estado-blue' : 'badge-estado-warning' %>">
                    <i class="bi bi-circle-fill" style="font-size: 0.4rem;"></i>
                    <%= tieneSalida ? (a.estado || 'Finalizado') : 'En curso' %>
                  </span>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-4 text-muted">No se registran marcas de asistencia.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Script de filtrado dinámico en frontend -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('historialSearch');
    const dateInput = document.getElementById('historialDateFilter');
    const tableRows = document.querySelectorAll('.table-historial tbody tr');

    function filterTable() {
      const searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : '';
      const dateTerm = dateInput ? dateInput.value : '';

      tableRows.forEach(row => {
        if (row.children.length <= 1) return; // Omitir fila de mensaje de "Sin registros"

        const fechaText = row.cells[0] ? row.cells[0].textContent.trim() : '';
        const obraText = row.cells[1] ? row.cells[1].textContent.toLowerCase() : '';

        const matchesSearch = !searchTerm || obraText.includes(searchTerm) || fechaText.toLowerCase().includes(searchTerm);
        const matchesDate = !dateTerm || fechaText.includes(dateTerm);

        if (matchesSearch && matchesDate) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    if (searchInput) searchInput.addEventListener('input', filterTable);
    if (dateInput) dateInput.addEventListener('change', filterTable);
  });
</script>

<%- include('../partials/footer') %>