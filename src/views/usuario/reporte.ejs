    <!-- MODAL INTERACTIVO: VER BITÁCORA DETALLADA (CENTRADOS) -->
    <div class="modal fade" id="modalVerBitacora" tabindex="-1" aria-labelledby="modalVerBitacoraLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header" style="background-color: #f0f5fc;">
            <h5 class="modal-title fw-bold" id="modalVerBitacoraLabel" style="color: #0b3c5d;">
              <i class="bi bi-journal-text me-2 text-primary"></i>Detalle de Tarea / Bitácora
            </h5>
            <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Cerrar">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
          <div class="modal-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
              <span class="text-muted fs-7"><i class="bi bi-calendar2-event me-1 text-primary"></i> Fecha: <strong id="modalVerBitacoraFecha" class="text-dark"></strong></span>
              <span class="text-muted fs-7" id="modalVerBitacoraLugarWrap" style="display: none;"><i class="bi bi-geo-alt me-1 text-danger"></i> Obra: <strong id="modalVerBitacoraLugar" class="text-dark"></strong></span>
            </div>
            <label class="form-label fw-bold text-dark mb-2">Descripción Completa:</label>
            <div id="modalVerBitacoraTexto" class="p-3 bg-light rounded border"
                 style="max-height: 320px; overflow-y: auto; word-break: break-word; white-space: pre-wrap; font-size: 0.93rem; color: #1e293b; line-height: 1.5;">
            </div>
