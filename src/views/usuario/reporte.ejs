<% pageTitle='Panel de Reportes de Asistencia y Bitácora' ;
  pageSubtitle='Resumen de asistencias, actividades y solicitudes de horas extras' ; %>
  <%- include('../partials/header') %>

    <!-- Hoja de estilos independiente para Reportes -->
    <link rel="stylesheet" href="/css/reporte.css">
    <style>
      #modal_tarea,
      #modal_tarea::placeholder {
        font-family: 'Montserrat', sans-serif !important;
        font-weight: 300 !important;
      }
    </style>

    <div class="reporte-wrapper py-3">

      <!-- Encabezado, Resumen de Horas y Acciones -->
      <div class="reporte-header-row">
        <div>
          <h2 class="reporte-header-title">Mi Reporte de Jornadas</h2>
          <p class="reporte-header-user">
            <i class="bi bi-person me-1"></i>Usuario: <strong>
              <%= user.nombre %>
            </strong> | CI: <%= user.ci %>
          </p>
        </div>

        <div class="reporte-header-right">
          <div class="reporte-actions-group">
            <a href="/reportes/export" class="btn-excel-custom">
              <i class="bi bi-file-earmark-excel me-1"></i> Exportar a Excel
            </a>
            <!-- Botón que activa la alerta interactiva de módulo en desarrollo -->
            <button type="button" class="btn-horas-extra-custom" data-bs-toggle="modal"
              data-bs-target="#modalEnProceso">
              <i class="bi bi-clock-history me-1"></i> Solicitar Horas Extra
            </button>
          </div>
        </div>
      </div>

      <!-- Tarjeta: Panel de Verificación GPS / Geocerca -->
      <% 
        const jHoy = (typeof jornadaHoy !== 'undefined' && jornadaHoy) ? jornadaHoy : { estado: 'SIN_JORNADA' };
        let badgeLabel = 'SIN JORNADA';
        let badgeClass = 'badge-status-grey';
        if (jHoy.estado === 'EN_CURSO') {
          badgeLabel = 'EN CURSO';
          badgeClass = 'badge-status-blue';
        } else if (jHoy.estado === 'COMPLETADA') {
          badgeLabel = 'COMPLETADA';
          badgeClass = 'badge-status-green';
        }
      %>
      <div class="card-jornada-hoy-v2 mb-4">
        <!-- Banner Azul Superior -->
        <div class="jornada-banner-top">
          <div class="jornada-banner-left">
            <div class="jornada-banner-circle">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M11 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5z"/>
                <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H1a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z"/>
              </svg>
            </div>
            <div>
              <h5 class="jornada-banner-title">Jornadas de hoy</h5>
              <span class="jornada-banner-badge <%= badgeClass %>">
                <%= badgeLabel %>
              </span>
            </div>
          </div>

          <div class="jornada-banner-right">
            <div class="jornada-banner-divider"></div>
            <div class="jornada-banner-circle">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z"/>
                <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0"/>
              </svg>
            </div>
            <div>
              <span class="jornada-hours-label">Horas acumuladas</span>
              <span class="jornada-hours-val">
                <%= total_acumulada %> <small>hrs</small>
              </span>
            </div>
          </div>
        </div>

        <!-- Cuerpo de la Tarjeta (Flujo de 3 Pasos + Footer) -->
        <div class="jornada-body-v2">
          
          <div class="jornada-workflow-container">
            <!-- PASO 1: ENTRADA -->
            <div class="jornada-workflow-col">
              <span class="workflow-col-title text-entrada">ENTRADA</span>
              <div class="jornada-step-card card-entrada">
                <% if (jHoy.hora_entrada) { %>
                  <div class="step-card-header">
                    <div class="step-card-icon icon-entrada">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 15h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0z"/>
                        <path fill-rule="evenodd" d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
                      </svg>
                    </div>
                    <div class="step-card-info">
                      <span class="step-card-subtitle">Entrada registrada</span>
                      <span class="step-card-time"><%= jHoy.hora_entrada %> hrs</span>
                    </div>
                  </div>
                  <div class="step-card-body">
                    <div class="step-card-location">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M12.166 8.94c-.524 1.062-1.234 2.12-1.96 3.07A32 32 0 0 1 8 14.58a32 32 0 0 1-2.206-2.57c-.726-.95-1.436-2.008-1.96-3.07C3.304 7.867 3 6.862 3 6a5 5 0 0 1 10 0c0 .862-.305 1.867-.834 2.94M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10"/>
                        <path d="M8 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4"/>
                      </svg>
                      <span><%= jHoy.lugar_nombre || 'Ubicación' %></span>
                    </div>
                    <div class="step-card-badge badge-gps-green">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
                      </svg>
                      GPS verificado
                    </div>
                  </div>
                <% } else { %>
                  <div class="step-card-header">
                    <div class="step-card-icon icon-grey">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 15h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0z"/>
                        <path fill-rule="evenodd" d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
                      </svg>
                    </div>
                    <div class="step-card-info">
                      <span class="step-card-subtitle">Aún no registrada</span>
                      <span class="step-card-desc-empty">Marca tu entrada al iniciar tu jornada</span>
                    </div>
                  </div>
                <% } %>
              </div>
            </div>

            <!-- FLECHA DE CONEXIÓN 1 -->
            <div class="jornada-workflow-arrow">
              <div class="arrow-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                  <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
                </svg>
              </div>
            </div>

            <!-- PASO 2: TIEMPO TRANSCURRIDO HOY (CRONÓMETRO) -->
            <div class="jornada-workflow-col">
              <span class="workflow-col-title text-timer">TIEMPO TRANSCURRIDO HOY</span>
              <div class="jornada-step-card card-timer">
                <div class="timer-icon-wrapper">
                  <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z"/>
                    <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0"/>
                  </svg>
                </div>
                <div class="timer-display-digits" id="cronometro-display">
                  00:00:00
                </div>
                <div class="timer-labels">
                  <span>Horas</span>
                  <span>Minutos</span>
                  <span>Segundos</span>
                </div>
              </div>
            </div>

            <!-- FLECHA DE CONEXIÓN 2 -->
            <div class="jornada-workflow-arrow">
              <div class="arrow-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                  <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
                </svg>
              </div>
            </div>

            <!-- PASO 3: SALIDA -->
            <div class="jornada-workflow-col">
              <span class="workflow-col-title text-salida">SALIDA</span>
              <div class="jornada-step-card card-salida">
                <% if (jHoy.hora_salida) { %>
                  <div class="step-card-header">
                    <div class="step-card-icon icon-salida">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 1h-8A1.5 1.5 0 0 0 0 2.5v9A1.5 1.5 0 0 0 1.5 13h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z"/>
                        <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
                      </svg>
                    </div>
                    <div class="step-card-info">
                      <span class="step-card-subtitle">Salida registrada</span>
                      <span class="step-card-time"><%= jHoy.hora_salida %> hrs</span>
                    </div>
                  </div>
                  <div class="step-card-body">
                    <div class="step-card-location">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M12.166 8.94c-.524 1.062-1.234 2.12-1.96 3.07A32 32 0 0 1 8 14.58a32 32 0 0 1-2.206-2.57c-.726-.95-1.436-2.008-1.96-3.07C3.304 7.867 3 6.862 3 6a5 5 0 0 1 10 0c0 .862-.305 1.867-.834 2.94M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10"/>
                        <path d="M8 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4"/>
                      </svg>
                      <span><%= jHoy.lugar_nombre || 'Ubicación' %></span>
                    </div>
                    <div class="step-card-badge badge-gps-amber">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
                      </svg>
                      GPS verificado
                    </div>
                  </div>
                <% } else { %>
                  <div class="step-card-header">
                    <div class="step-card-icon icon-orange">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 1h-8A1.5 1.5 0 0 0 0 2.5v9A1.5 1.5 0 0 0 1.5 13h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z"/>
                        <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
                      </svg>
                    </div>
                    <div class="step-card-info">
                      <span class="step-card-subtitle">Aún no registrada</span>
                      <span class="step-card-desc-empty">Marca tu salida al finalizar tu jornada</span>
                    </div>
                  </div>
                <% } %>
              </div>
            </div>
          </div>

          <!-- FOOTER DE ESTADO Y BOTÓN DE ACCIÓN -->
          <div class="jornada-bottom-bar">
            <div class="jornada-bottom-status">
              <% if (jHoy.estado === 'EN_CURSO') { %>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="text-success me-2 flex-shrink-0" viewBox="0 0 16 16">
                  <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l5-6.25a.75.75 0 0 0-.019-1.04"/>
                </svg>
                <span class="status-text fw-semibold">Tu jornada está actualmente en curso.</span>
              <% } else if (jHoy.estado === 'COMPLETADA') { %>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="text-success me-2 flex-shrink-0" viewBox="0 0 16 16">
                  <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l5-6.25a.75.75 0 0 0-.019-1.04"/>
                </svg>
                <span class="status-text fw-semibold">Tu jornada de hoy se ha completado con éxito.</span>
              <% } else { %>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="text-secondary me-2 flex-shrink-0" viewBox="0 0 16 16">
                  <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l.451-.081zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/>
                </svg>
                <span class="status-text text-muted">No tienes ninguna jornada activa hoy. Debes marcar entrada con GPS.</span>
              <% } %>
            </div>

            <div class="jornada-bottom-action">
              <% if (jHoy.estado === 'EN_CURSO') { %>
                <a href="/geofence" class="btn-gps-blue">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6"/>
                  </svg>
                  Verificar ubicación y marcar salida
                </a>
              <% } else if (jHoy.estado === 'SIN_JORNADA') { %>
                <a href="/geofence" class="btn-gps-blue">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6"/>
                  </svg>
                  Verificar GPS e iniciar jornada
                </a>
              <% } else { %>
                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" disabled>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                    <path d="M12.354 4.354a.5.5 0 0 0-.708-.708L5 10.293 1.854 7.146a.5.5 0 1 1-.708.708l3.5 3.5a.5.5 0 0 0 .708 0zm-4.208 7-.896-.897.707-.707.501.502 6.146-6.147a.5.5 0 0 1 .708.708l-7 7a.5.5 0 0 1-.708 0z"/>
                  </svg>
                  Jornada finalizada
                </button>
              <% } %>
            </div>
          </div>

        </div>
      </div>

      <!-- Tabla de Jornadas (Asistencia + Bitácora) -->
      <div class="card-historial-reporte">
        <h5 class="historial-reporte-title">
          <i class="bi bi-journal-text me-2 text-primary"></i>Historial de Asistencias y Bitácora
        </h5>

        <!-- Fila de Filtros / Controles (Primero Fecha, Segundo Búsqueda) -->
        <div class="reporte-controls-row">
          <div class="filter-field-group filter-date-box">
            <label for="reporteDateFilter" class="filter-field-label">Filtrar por fecha:</label>
            <div class="input-icon-wrapper">
              <i class="bi bi-calendar3"></i>
              <input type="date" id="reporteDateFilter" class="form-control" title="Filtrar por fecha">
            </div>
          </div>
          <div class="filter-field-group search-input-box">
            <label for="reporteSearch" class="filter-field-label">Búsqueda:</label>
            <div class="input-icon-wrapper">
              <i class="bi bi-search"></i>
              <input type="text" id="reporteSearch" class="form-control"
                placeholder="Buscar por obra / lugar / tarea...">
            </div>
          </div>
        </div>

        <div class="table-reporte-wrapper">
          <table class="table table-reporte align-middle">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Lugar / Obra</th>
                <th>Entrada</th>
                <th>Salida</th>
                <th>Horas Turno</th>
                <th>Tarea / Bitácora</th>
                <th>Comprobante</th>
                <th class="text-center">Acción</th>
              </tr>
            </thead>
            <tbody>
              <% if (jornadas && jornadas.length> 0) { %>
                <% jornadas.forEach(j=> { %>
                  <tr>
                    <td><i class="bi bi-calendar2-event me-2 text-primary"></i><strong>
                        <%= j.fecha %>
                      </strong></td>

                    <td>
                      <strong style="color: #1e293b;">
                        <%= j.lugar_nombre || 'N/A' %>
                      </strong>
                      <% if(j.lugar_tipo) { %>
                        <br><small class="text-muted">(<%= j.lugar_tipo %>)</small>
                        <% } %>
                    </td>

                    <!-- HORA ENTRADA -->
                    <td>
                      <%= j.hora_entrada_vis || j.hora_entrada || '-' %>
                    </td>

                    <!-- HORA SALIDA -->
                    <td>
                      <%= j.hora_salida_vis || j.hora_salida || '-' %>
                    </td>

                    <!-- HORAS TRANSCURRIDAS POR FECHA -->
                    <td>
                      <% if (j.horas_dia==='En curso' ) { %>
                        <span class="badge-turno-curso">
                          <i class="bi bi-clock-history"></i> En curso
                        </span>
                        <% } else { %>
                          <span class="badge-turno-finalizado">
                            <i class="bi bi-stopwatch"></i>
                            <%= j.horas_dia %>
                          </span>
                          <% } %>
                    </td>

                    <td class="col-tarea-cell">
                      <% if(j.tarea) { %>
                        <% if(j.tarea.length > 80) { %>
                          <div class="bitacora-container">
                            <span class="bitacora-corta"><%= j.tarea.substring(0, 80) %>...</span>
                            <button type="button" class="btn-ver-mas-bitacora btn-ver-detalle-bitacora"
                              data-tarea="<%= j.tarea %>"
                              data-fecha="<%= j.fecha %>"
                              data-lugar="<%= j.lugar_nombre || '' %>">
                              Ver más
                            </button>
                          </div>
                        <% } else { %>
                          <span class="bitacora-texto"><%= j.tarea %></span>
                        <% } %>
                      <% } else { %>
                        <span class="text-muted fs-7"><em>Sin bitácora registrada</em></span>
                      <% } %>
                      <% if(j.observacion) { %>
                        <br><small class="text-danger">Obs: <%= j.observacion %></small>
                      <% } %>
                    </td>

                    <td>
                      <% if(j.comprobante) { %>
                        <a href="<%= j.comprobante %>" target="_blank" class="btn-comprobante-ver">
                          <i class="bi bi-image"></i> Ver
                        </a>
                        <% } else { %>
                          <span class="text-muted">-</span>
                          <% } %>
                    </td>

                    <td class="text-center">
                      <button class="btn-reporte-action btn-reporte" data-asistencia="<%= j.id_asistencia %>"
                        data-tarea="<%= j.tarea || '' %>" data-comprobante="<%= j.comprobante || '' %>">
                        <i class="bi bi-pencil-square me-1"></i>
                        <%= j.tarea ? 'Editar' : 'Registrar' %>
                      </button>
                    </td>
                  </tr>
                  <% }); %>
                    <% } else { %>
                      <tr>
                        <td colspan="8" class="text-center py-4 text-muted fw-semibold">No se encontraron registros de
                          jornadas.</td>
                      </tr>
                      <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- MODAL INTERACTIVO: MÓDULO EN PROCESO -->
    <div class="modal fade" id="modalEnProceso" tabindex="-1" aria-labelledby="modalEnProcesoLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-3">
