          // 3. CANCELAR / DESCARTAR SESIÓN ACTIVA
          btnCancelar?.addEventListener('click', async () => {
            const result = await Swal.fire({
              title: '¿Descartar Sesión de Horas Extras?',
              text: 'Se cancelará el cronómetro en curso y no se registrará ningún tiempo extraordinario.',
              icon: 'warning',
              showCancelButton: true,
              confirmButtonText: 'Sí, Descartar',
              cancelButtonText: 'Seguir Trabajando',
              confirmButtonColor: '#ef4444',
              cancelButtonColor: '#64748b'
            });

            if (!result.isConfirmed) return;

            try {
              btnCancelar.disabled = true;
              const res = await fetch('/api/horas-extras/cancelar', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify({})
              });
              const data = await res.json();
              if (data.ok) {
                await Swal.fire({
                  icon: 'info',
                  title: 'Sesión Descartada',
                  text: data.msg || 'La sesión de horas extras fue cancelada correctamente.',
                  timer: 1500,
                  showConfirmButton: false
                });
                location.reload();
              } else {
                mostrarAlerta(data.msg || 'No se pudo descartar la sesión', 'error');
                btnCancelar.disabled = false;
              }
            } catch (err) {
              console.error(err);
              mostrarAlerta('Error de conexión al descartar', 'error');
              btnCancelar.disabled = false;
            }
          });

          // 4. VISTA PREVIA DE FOTO EN EL MODAL DE FINALIZACIÓN
          fileFin?.addEventListener('change', (e) => {
            const file = e.target.files?.[0];
            if (file) {
              if (file.size > 5 * 1024 * 1024) {
