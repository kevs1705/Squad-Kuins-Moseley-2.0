        // Cronómetro en vivo de Tiempo Transcurrido Hoy
        (function initCronometro() {
          const estadoJornada = '<%= jHoy.estado %>';
          const horaEntradaRaw = '<%= jHoy.hora_entrada_raw || "" %>';
          const fechaRaw = '<%= jHoy.fecha_raw || "" %>';
          const duracionSegundos = parseInt('<%= jHoy.duracion_segundos || 0 %>', 10) || 0;
          const displayEl = document.getElementById('cronometro-display');

          if (!displayEl) return;

          function formatHHMMSS(totalSecs) {
            const secs = Math.max(0, Math.floor(totalSecs));
            const h = String(Math.floor(secs / 3600)).padStart(2, '0');
            const m = String(Math.floor((secs % 3600) / 60)).padStart(2, '0');
            const s = String(secs % 60).padStart(2, '0');
            return `${h}:${m}:${s}`;
          }

          if (estadoJornada === 'EN_CURSO' && fechaRaw && horaEntradaRaw) {
            const timeParts = horaEntradaRaw.split(':');
            const dateParts = fechaRaw.split('-');
            const entradaDate = new Date(
              parseInt(dateParts[0], 10),
              parseInt(dateParts[1], 10) - 1,
              parseInt(dateParts[2], 10),
              parseInt(timeParts[0] || '0', 10),
              parseInt(timeParts[1] || '0', 10),
              parseInt(timeParts[2] || '0', 10)
            );

            function updateTicker() {
              const now = new Date();
              const diffMs = Math.max(0, now.getTime() - entradaDate.getTime());
              displayEl.textContent = formatHHMMSS(diffMs / 1000);
            }

            updateTicker();
            setInterval(updateTicker, 1000);
          } else if (estadoJornada === 'COMPLETADA') {
            displayEl.textContent = formatHHMMSS(duracionSegundos);
          } else {
            displayEl.textContent = '00:00:00';
          }
        })();

        /*
        ===============================================================
        GESTIÓN DE HORAS EXTRAS EN TIEMPO REAL (INICIAR, CANCELAR, FINALIZAR)
        ===============================================================
        */
        (function() {
          const btnIniciar = document.getElementById('btnIniciarHorasExtra');
