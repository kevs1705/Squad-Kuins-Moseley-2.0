    <!-- MODAL: REGISTRAR / EDITAR BITÁCORA -->
    <div class="modal fade" id="modalReporte" tabindex="-1">
      <div class="modal-dialog">
        <div class="modal-content">
          <form id="formReporte">
            <div class="modal-header">
              <h5 class="modal-title fw-bold">Bitácora de Trabajo</h5>
              <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Cerrar">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>
            <div class="modal-body">
              <input type="hidden" name="id_asistencia" id="modal_id_asistencia">

              <div class="mb-3">
                <label class="form-label fw-semibold">Descripción de la Tarea / Avance <span
                    class="text-danger">*</span></label>
                <textarea class="form-control" name="tarea" id="modal_tarea" rows="4" required
                  style="resize: none; width: 100%; font-family: 'Montserrat', sans-serif !important; font-weight: 300 !important;"
                  placeholder="Describe las actividades realizadas en la jornada..."></textarea>
              </div>

              <!-- Comprobante existente si aplica -->
              <div id="preview_existing_container" class="mb-3 p-2 bg-light rounded border" style="display: none;">
                <div class="d-flex align-items-center justify-content-between">
                  <span class="text-muted fs-7"><i class="bi bi-image me-1"></i> Comprobante guardado:</span>
                  <a href="#" id="preview_existing_link" target="_blank"
                    class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 12px;">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Ver comprobante actual
                  </a>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold">Adjuntar Comprobante (PNG / JPG / WEBP)</label>
                <input type="file" name="comprobante" class="form-control" id="modal_comprobante"
                  accept="image/png, image/jpeg, image/jpg, image/webp">
                <small class="text-muted d-block mt-1" style="font-size: 0.78rem;">Las imágenes se subirán automáticamente a Cloudinary.</small>
              </div>

              <!-- Previsualización de nueva imagen seleccionada -->
              <div id="preview_new_container" class="mb-3 text-center" style="display: none;">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <small class="text-muted fw-semibold">Previsualización de nueva imagen:</small>
                  <button type="button" id="btn_quitar_img" class="btn btn-sm btn-link text-danger p-0"
                    style="font-size: 12px;">Quitar</button>
                </div>
                <img id="preview_new_img" src="" alt="Previsualización" class="img-fluid rounded border shadow-sm"
                  style="max-height: 180px; object-fit: contain;">
              </div>

              <!-- Estado de carga / spinner -->
              <div id="upload_feedback" class="alert alert-info py-2 px-3 align-items-center gap-2 mb-0"
                style="display: none; font-size: 0.875rem;">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                <span id="upload_feedback_text">Subiendo imagen a Cloudinary...</span>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
              <button type="submit" id="btnGuardarReporte" class="btn btn-primary"
                style="background-color: #0b6bcb; border-color: #0b6bcb;">
                <i class="bi bi-check2-circle me-1"></i> Guardar Bitácora
              </button>
