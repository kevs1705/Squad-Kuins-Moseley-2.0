<% pageTitle='Panel de Reportes de Asistencia y Bitácora' ;
  pageSubtitle='Resumen de asistencias, actividades y solicitudes de horas extras' ; %>
  <%- include('../partials/header') %>

    <!-- Hoja de estilos independiente para Reportes y Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/reporte.css">
    <style>
      #modal_tarea,
      #modal_tarea::placeholder {
        font-family: 'Montserrat', sans-serif !important;
        font-weight: 300 !important;
      }

      #btn_seleccionar_comprobante {
        transition: all 0.2s ease;
      }

      #btn_seleccionar_comprobante:hover {
        background-color: #0958a6 !important;
        border-color: #0958a6 !important;
        transform: translateY(-1px);
        box-shadow: 0 3px 8px rgba(11, 107, 203, 0.25) !important;
      }

      .btn-ojito-bitacora {
        background: rgba(11, 107, 203, 0.08) !important;
        border: 1px solid rgba(11, 107, 203, 0.25) !important;
        color: #0b6bcb !important;
        border-radius: 6px !important;
        padding: 5px 8px !important;
        font-size: 0.84rem !important;
        line-height: 1 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        vertical-align: middle !important;
        cursor: pointer !important;
        transition: all 0.15s ease !important;
        text-decoration: none !important;
      }

      .btn-ojito-bitacora:hover {
        background: #0b6bcb !important;
        color: #ffffff !important;
        border-color: #0b6bcb !important;
        transform: scale(1.08);
      }

      .btn-ojito-bitacora svg {
        display: block;
        pointer-events: none;
      }
    </style>

    <div class="reporte-wrapper py-3">

      <!-- Encabezado, Resumen de Horas y Acciones -->
      <div class="reporte-header-row">
        <div>
          <h2 class="reporte-header-title">Mi Reporte de Jornadas</h2>
          <p class="reporte-header-user">
            <i class="bi bi-person me-1"></i>Usuario: <strong>
              <%= user.nombre %>
            </strong> | CI: <%= user.ci %>
          </p>
        </div>

        <div class="reporte-header-right">
          <div class="reporte-actions-group">
            <a href="/reportes/export" class="btn-excel-custom">
              <i class="bi bi-file-earmark-excel me-1"></i> Exportar a Excel
            </a>
            <!-- Botón: Solicitar Teletrabajo -->
            <button type="button" class="btn-teletrabajo-custom" data-bs-toggle="modal"
              data-bs-target="#modalTeletrabajo">
              <i class="bi bi-house-door me-1"></i> Solicitar Teletrabajo
            </button>
            <!-- Botón de Horas Extras (Solo si no hay una sesión activa) -->
            <% if (typeof horaExtraActiva === 'undefined' || !horaExtraActiva) { %>
              <button type="button" class="btn-horas-extra-custom" id="btnIniciarHorasExtra">
                <i class="bi bi-play-circle-fill me-1"></i> Iniciar Horas Extra
              </button>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Tarjeta Premium: Horas Extras en Curso (Si aplica) -->
      <% if (typeof horaExtraActiva !== 'undefined' && horaExtraActiva) { %>
        <div class="card-horas-extras-v2 mb-4">
          <!-- Banner Ámbar/Naranja Superior -->
          <div class="horas-extras-banner-top">
            <div class="horas-extras-banner-left">
              <div class="horas-extras-banner-circle">
                <i class="bi bi-stopwatch-fill"></i>
              </div>
              <div>
                <h5 class="horas-extras-banner-title">Sesión de Horas Extras</h5>
                <span class="horas-extras-banner-badge">
                  <i class="bi bi-record-circle-fill"></i> EN VIVO
                </span>
              </div>
            </div>

            <div class="horas-extras-banner-right">
              <div class="horas-extras-banner-divider"></div>
              <div class="horas-extras-banner-circle">
                <i class="bi bi-clock-history"></i>
              </div>
              <div>
                <span class="jornada-hours-label">Tiempo transcurrido</span>
                <span id="tickerHorasExtra" class="jornada-hours-val font-monospace" data-inicio="<%= horaExtraActiva.fecha_solicitada %>T<%= horaExtraActiva.hora_inicio %>">
                  00:00:00
                </span>
              </div>
            </div>
          </div>

          <!-- Cuerpo de la Tarjeta con Detalles y Acciones -->
          <div class="horas-extras-body-v2">
            <div class="d-flex align-items-center gap-4 flex-wrap">
              <div class="horas-extras-info-item">
                <div class="horas-extras-icon-box">
                  <i class="bi bi-calendar-check-fill"></i>
                </div>
                <div>
                  <span class="horas-extras-info-label">Fecha de registro</span>
                  <span class="horas-extras-info-val"><%= horaExtraActiva.fecha_solicitada %></span>
                </div>
              </div>

              <div class="horas-extras-info-item">
                <div class="horas-extras-icon-box">
                  <i class="bi bi-play-circle-fill"></i>
                </div>
                <div>
                  <span class="horas-extras-info-label">Hora de inicio (Bolivia)</span>
                  <span class="horas-extras-info-val"><%= horaExtraActiva.hora_inicio %> hrs</span>
                </div>
              </div>

              <div class="horas-extras-info-item">
                <div class="horas-extras-icon-box text-danger" style="background: #fef2f2; border-color: #fecaca;">
                  <i class="bi bi-activity text-danger"></i>
                </div>
                <div>
                  <span class="horas-extras-info-label">Estado de la sesión</span>
                  <span class="horas-extras-info-val text-danger d-flex align-items-center gap-1">
                    <span class="spinner-grow spinner-grow-sm text-danger" style="width: 0.55rem; height: 0.55rem;" role="status"></span>
                    Contabilizando tiempo
                  </span>
                </div>
              </div>
            </div>

            <!-- Botones de Acción dentro de la sección -->
            <div class="horas-extras-action-btns">
              <button type="button" class="btn-he-finalizar" data-bs-toggle="modal" data-bs-target="#modalFinalizarHorasExtra">
                <i class="bi bi-stop-circle-fill"></i>
                <span>Finalizar y Reportar</span>
              </button>
              <button type="button" class="btn-he-descartar" id="btnCancelarHorasExtra" title="Descartar sesión en curso sin guardar">
                <i class="bi bi-trash3-fill"></i>
                <span>Descartar Sesión</span>
              </button>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Banner de Permiso de Teletrabajo Activo Hoy (Si aplica) -->
      <% if (typeof teletrabajoHoy !=='undefined' && teletrabajoHoy) { %>
        <div class="banner-teletrabajo-hoy mb-3 shadow-sm">
          <div class="banner-title">
            <i class="bi bi-house-check-fill text-success fs-5"></i>
            <span>¡Tienes autorización de Teletrabajo para hoy!</span>
          </div>
          <div class="d-flex align-items-center gap-3">
            <p class="banner-desc">
              Ubicación: <strong>
                <%= teletrabajoHoy.direccion_remota || 'Domicilio particular' %>
              </strong>
              | Horario: <strong>
                <%= teletrabajoHoy.hora_inicio %> - <%= teletrabajoHoy.hora_fin %>
              </strong>
            </p>
            <a href="/geofence" class="btn btn-sm btn-success rounded-pill px-3 py-1 fw-semibold text-nowrap">
              <i class="bi bi-geo-alt-fill me-1"></i> Ir a Marcación
            </a>
          </div>
        </div>
        <% } %>

          <!-- Tarjeta: Panel de Verificación GPS / Geocerca -->
          <% const jHoy=(typeof jornadaHoy !=='undefined' && jornadaHoy) ? jornadaHoy : { estado: 'SIN_JORNADA' }; let
            badgeLabel='SIN JORNADA' ; let badgeClass='badge-status-grey' ; if (jHoy.estado==='EN_CURSO' ) {
            badgeLabel=jHoy.modalidad==='TELETRABAJO' ? 'EN CURSO (TELETRABAJO)' : 'EN CURSO' ;
            badgeClass='badge-status-blue' ; } else if (jHoy.estado==='COMPLETADA' ) {
            badgeLabel=jHoy.modalidad==='TELETRABAJO' ? 'COMPLETADA (OBSERVADO)' : 'COMPLETADA' ;
            badgeClass=jHoy.modalidad==='TELETRABAJO' ? 'badge-status-amber' : 'badge-status-green' ; } %>
            <div class="card-jornada-hoy-v2 mb-4">
              <!-- Banner Azul Superior -->
              <div class="jornada-banner-top">
                <div class="jornada-banner-left">
                  <div class="jornada-banner-circle">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                      viewBox="0 0 16 16">
                      <path d="M11 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5z" />
                      <path
                        d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H1a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z" />
                    </svg>
                  </div>
                  <div>
                    <h5 class="jornada-banner-title">Jornadas de hoy</h5>
                    <span class="jornada-banner-badge <%= badgeClass %>">
                      <%= badgeLabel %>
                    </span>
                  </div>
                </div>

                <div class="jornada-banner-right" style="gap: 16px;">
                  <div class="jornada-banner-divider"></div>
                  <div class="jornada-banner-circle">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor"
                      viewBox="0 0 16 16">
                      <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z" />
                      <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0" />
                    </svg>
                  </div>
                  <div>
                    <span class="jornada-hours-label">Horas acumuladas</span>
                    <span class="jornada-hours-val">
                      <%= total_acumulada %> <small>hrs</small>
                    </span>
                    
                    <% const horasCongeladasVis = (typeof total_congeladas !== 'undefined' && total_congeladas) ? total_congeladas : ((typeof total_observadas !== 'undefined' && total_observadas) ? total_observadas : '00:00:00'); %>
                    <% const horasDisponiblesVis = (typeof total_disponibles !== 'undefined' && total_disponibles) ? total_disponibles : total_acumulada; %>

                    <div class="d-flex flex-column gap-1 mt-1">
                      <small class="d-inline-flex align-items-center fw-semibold text-danger" style="font-size: 0.76rem;">
                        <i class="bi bi-snowflake me-1"></i>Horas congeladas: <strong><%= horasCongeladasVis %></strong> hrs
                      </small>
                      <small class="d-inline-flex align-items-center fw-bold text-success" style="font-size: 0.78rem; background: rgba(34, 197, 94, 0.1); padding: 2px 8px; border-radius: 6px; border: 1px solid rgba(34, 197, 94, 0.25);">
                        <i class="bi bi-check-circle-fill me-1 text-success"></i>Horas disponibles: <%= horasDisponiblesVis %> hrs
                      </small>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Cuerpo de la Tarjeta (Flujo de 3 Pasos + Footer) -->
              <div class="jornada-body-v2">

                <div class="jornada-workflow-container">
                  <!-- PASO 1: ENTRADA -->
                  <div class="jornada-workflow-col">
                    <span class="workflow-col-title text-entrada">ENTRADA</span>
                    <div class="jornada-step-card card-entrada">
                      <% if (jHoy.hora_entrada) { %>
                        <div class="step-card-header">
                          <div class="step-card-icon icon-entrada">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor"
                              viewBox="0 0 16 16">
                              <path fill-rule="evenodd"
                                d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 15h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0z" />
                              <path fill-rule="evenodd"
                                d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z" />
                            </svg>
                          </div>
                          <div class="step-card-info">
                            <span class="step-card-subtitle">Entrada registrada</span>
                            <span class="step-card-time">
                              <%= jHoy.hora_entrada %> hrs
                            </span>
                          </div>
                        </div>
                        <div class="step-card-body">
                          <div class="step-card-location">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                              viewBox="0 0 16 16">
                              <path
                                d="M12.166 8.94c-.524 1.062-1.234 2.12-1.96 3.07A32 32 0 0 1 8 14.58a32 32 0 0 1-2.206-2.57c-.726-.95-1.436-2.008-1.96-3.07C3.304 7.867 3 6.862 3 6a5 5 0 0 1 10 0c0 .862-.305 1.867-.834 2.94M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10" />
                              <path d="M8 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4" />
                            </svg>
                            <span>
                              <%= jHoy.modalidad==='TELETRABAJO' ? '🏠 Teletrabajo (Remoto)' : (jHoy.lugar_nombre
                                || 'Ubicación' ) %>
                            </span>
                          </div>
                          <div
                            class="step-card-badge <%= jHoy.modalidad === 'TELETRABAJO' ? 'badge-gps-amber' : 'badge-gps-green' %>">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor"
                              viewBox="0 0 16 16">
                              <path
                                d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z" />
                            </svg>
                            <%= jHoy.modalidad==='TELETRABAJO' ? 'GPS Remoto' : 'GPS verificado' %>
                          </div>
                        </div>
                        <% } else { %>
                          <div class="step-card-header">
                            <div class="step-card-icon icon-grey">
                              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor"
                                viewBox="0 0 16 16">
                                <path fill-rule="evenodd"
                                  d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 15h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0z" />
                                <path fill-rule="evenodd"
                                  d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z" />
                              </svg>
                            </div>
                            <div class="step-card-info">
                              <span class="step-card-subtitle">Aún no registrada</span>
                              <span class="step-card-desc-empty">Marca tu entrada al iniciar tu jornada</span>
                            </div>
                          </div>
                          <% } %>
                    </div>
                  </div>

                  <!-- FLECHA DE CONEXIÓN 1 -->
                  <div class="jornada-workflow-arrow">
                    <div class="arrow-circle">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                        viewBox="0 0 16 16">
                        <path fill-rule="evenodd"
                          d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8" />
                      </svg>
                    </div>
                  </div>

                  <!-- PASO 2: TIEMPO TRANSCURRIDO HOY (CRONÓMETRO) -->
                  <div class="jornada-workflow-col">
                    <span class="workflow-col-title text-timer">TIEMPO TRANSCURRIDO HOY</span>
                    <div class="jornada-step-card card-timer">
                      <div class="timer-icon-wrapper">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor"
                          viewBox="0 0 16 16">
                          <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z" />
                          <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0" />
                        </svg>
                      </div>
                      <div class="timer-display-digits" id="cronometro-display">
                        00:00:00
                      </div>
                      <div class="timer-labels">
                        <span>Horas</span>
                        <span>Minutos</span>
                        <span>Segundos</span>
                      </div>
                    </div>
                  </div>

                  <!-- FLECHA DE CONEXIÓN 2 -->
                  <div class="jornada-workflow-arrow">
                    <div class="arrow-circle">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                        viewBox="0 0 16 16">
                        <path fill-rule="evenodd"
                          d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8" />
                      </svg>
                    </div>
                  </div>

                  <!-- PASO 3: SALIDA -->
                  <div class="jornada-workflow-col">
                    <span class="workflow-col-title text-salida">SALIDA</span>
                    <div class="jornada-step-card card-salida">
                      <% if (jHoy.hora_salida) { %>
                        <div class="step-card-header">
                          <div class="step-card-icon icon-salida">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor"
                              viewBox="0 0 16 16">
                              <path fill-rule="evenodd"
                                d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 1h-8A1.5 1.5 0 0 0 0 2.5v9A1.5 1.5 0 0 0 1.5 13h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z" />
                              <path fill-rule="evenodd"
                                d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z" />
                            </svg>
                          </div>
                          <div class="step-card-info">
                            <span class="step-card-subtitle">Salida registrada</span>
                            <span class="step-card-time">
                              <%= jHoy.hora_salida %> hrs
                            </span>
                          </div>
                        </div>
                        <div class="step-card-body">
                          <div class="step-card-location">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                              viewBox="0 0 16 16">
                              <path
                                d="M12.166 8.94c-.524 1.062-1.234 2.12-1.96 3.07A32 32 0 0 1 8 14.58a32 32 0 0 1-2.206-2.57c-.726-.95-1.436-2.008-1.96-3.07C3.304 7.867 3 6.862 3 6a5 5 0 0 1 10 0c0 .862-.305 1.867-.834 2.94M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10" />
                              <path d="M8 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4" />
                            </svg>
                            <span>
                              <%= jHoy.lugar_nombre || 'Ubicación' %>
                            </span>
                          </div>
                          <div class="step-card-badge badge-gps-amber">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor"
                              viewBox="0 0 16 16">
                              <path
                                d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z" />
                            </svg>
                            GPS verificado
                          </div>
                        </div>
                        <% } else { %>
                          <div class="step-card-header">
                            <div class="step-card-icon icon-orange">
                              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor"
                                viewBox="0 0 16 16">
                                <path fill-rule="evenodd"
                                  d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 1h-8A1.5 1.5 0 0 0 0 2.5v9A1.5 1.5 0 0 0 1.5 13h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z" />
                                <path fill-rule="evenodd"
                                  d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z" />
                              </svg>
                            </div>
                            <div class="step-card-info">
                              <span class="step-card-subtitle">Aún no registrada</span>
                              <span class="step-card-desc-empty">Marca tu salida al finalizar tu jornada</span>
                            </div>
                          </div>
                          <% } %>
                    </div>
                  </div>
                </div>

                <!-- FOOTER DE ESTADO Y BOTÓN DE ACCIÓN -->
                <div class="jornada-bottom-bar">
                  <div class="jornada-bottom-status">
                    <% if (jHoy.estado==='EN_CURSO' ) { %>
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                        class="text-success me-2 flex-shrink-0" viewBox="0 0 16 16">
                        <path
                          d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l5-6.25a.75.75 0 0 0-.019-1.04" />
                      </svg>
                      <span class="status-text fw-semibold">Tu jornada está actualmente en curso.</span>
                      <% } else if (jHoy.estado==='COMPLETADA' ) { %>
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                          class="text-success me-2 flex-shrink-0" viewBox="0 0 16 16">
                          <path
                            d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l5-6.25a.75.75 0 0 0-.019-1.04" />
                        </svg>
                        <span class="status-text fw-semibold">Tu jornada de hoy se ha completado con éxito.</span>
                        <% } else { %>
                          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                            class="text-secondary me-2 flex-shrink-0" viewBox="0 0 16 16">
                            <path
                              d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l.451-.081zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2" />
                          </svg>
                          <span class="status-text text-muted">No tienes ninguna jornada activa hoy. Debes marcar
                            entrada con GPS.</span>
                          <% } %>
                  </div>

                  <div class="jornada-bottom-action">
                    <% if (jHoy.estado==='EN_CURSO' ) { %>
                      <a href="/geofence" class="btn-gps-blue">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                          viewBox="0 0 16 16">
                          <path
                            d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6" />
                        </svg>
                        Verificar ubicación y marcar salida
                      </a>
                      <% } else if (jHoy.estado==='SIN_JORNADA' ) { %>
                        <a href="/geofence" class="btn-gps-blue">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                            viewBox="0 0 16 16">
                            <path
                              d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6" />
                          </svg>
                          Verificar GPS e iniciar jornada
                        </a>
                        <% } else { %>
                          <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" disabled>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                              class="me-1" viewBox="0 0 16 16">
                              <path
                                d="M12.354 4.354a.5.5 0 0 0-.708-.708L5 10.293 1.854 7.146a.5.5 0 1 1-.708.708l3.5 3.5a.5.5 0 0 0 .708 0zm-4.208 7-.896-.897.707-.707.501.502 6.146-6.147a.5.5 0 0 1 .708.708l-7 7a.5.5 0 0 1-.708 0z" />
                            </svg>
                            Jornada finalizada
                          </button>
                          <% } %>
                  </div>
                </div>

              </div>
            </div>
          <% 
            const hoyBoliviaStr = (typeof hoyBolivia !== 'undefined' && hoyBolivia) ? hoyBolivia : new Date().toLocaleDateString('sv-SE', { timeZone: 'America/La_Paz' });
            let bitacorasPendientes = 0;
            if (jornadas && jornadas.length > 0) {
              bitacorasPendientes = jornadas.filter(j => {
                const faltaT = !j.tarea || j.tarea.trim() === '';
                const faltaC = !j.comprobante || j.comprobante.trim() === '';
                return faltaT || faltaC;
              }).length;
            }
          %>

          <!-- AVISO DE BITÁCORAS PENDIENTES DEL USUARIO Y CONTADOR DE CIERRE 00:00 -->
          <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #ffffff; border: 1px solid #e2e8f0 !important; overflow: hidden;">
            <div class="card-body p-3 d-flex align-items-center justify-content-between flex-wrap gap-3">
              
              <!-- Lado Izquierdo: Icono + Títulos -->
              <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center justify-content-center rounded-3" 
                     style="width: 44px; height: 44px; background-color: <%= bitacorasPendientes > 0 ? '#fee2e2' : '#dcfce7' %>; color: <%= bitacorasPendientes > 0 ? '#dc2626' : '#15803d' %>; flex-shrink: 0;">
                  <i class="bi <%= bitacorasPendientes > 0 ? 'bi-journal-exclamation' : 'bi-journal-check' %> fs-4"></i>
                </div>
                <div>
                  <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.95rem; letter-spacing: -0.2px;">Control y Estado de Bitácoras</h6>
                  <small class="text-muted" style="font-size: 0.82rem;">Registros de actividades y comprobantes de tus jornadas</small>
                </div>
              </div>

              <!-- Lado Derecho: Badge de Estado -->
              <div>
                <% if (bitacorasPendientes > 0) { %>
                  <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill shadow-sm" 
                       style="background-color: #fff1f2; border: 1px solid #fecdd3; color: #e11d48; font-size: 0.85rem; font-weight: 700;">
                    <i class="bi bi-exclamation-triangle-fill" style="font-size: 0.95rem;"></i>
                    <span>Tienes <strong><%= bitacorasPendientes %></strong> bitácora(s) pendiente(s) por llenar</span>
                  </div>
                <% } else { %>
                  <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill shadow-sm" 
                       style="background-color: #f0fdf4; border: 1px solid #bbf7d0; color: #16a34a; font-size: 0.85rem; font-weight: 700;">
                    <i class="bi bi-check-circle-fill" style="font-size: 0.95rem;"></i>
                    <span>Todas las bitácoras al día</span>
                  </div>
                <% } %>
              </div>

            </div>

            <!-- Notificación de Cuenta Regresiva antes de las 12:00 AM (Medianoche) -->
            <div class="px-3 py-2 d-flex align-items-center justify-content-between flex-wrap gap-2" 
                 style="background: #fffbeb; border-top: 1px solid #fef3c7; font-size: 0.82rem; color: #92400e;">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-hourglass-split text-warning fs-6"></i>
                <span><strong>Cierre de Jornada:</strong> Las bitácoras se bloquean a las <strong>12:00 AM (medianoche)</strong> y las horas no justificadas se congelan automáticamente.</span>
              </div>
              <div class="d-inline-flex align-items-center gap-1 fw-bold text-danger bg-white px-2 py-1 rounded border border-warning shadow-sm">
                <i class="bi bi-clock-history"></i>
                <span>Tiempo restante hoy: </span>
                <span id="countdownMedianocheTicker" class="font-monospace" style="font-size: 0.88rem;">--:--:--</span>
              </div>
            </div>
          </div>
            
            <!-- Tabla de Jornadas (Asistencia + Bitácora) -->
            <div class="card-historial-reporte">
              <h5 class="historial-reporte-title">
                <i class="bi bi-journal-text me-2 text-primary"></i>Historial de Asistencias y Bitácora
              </h5>

              <!-- Fila de Filtros / Controles (Rango de Fechas + Búsqueda) -->
              <div class="reporte-controls-row">
                <div class="filter-field-group filter-date-box">
                  <label for="reporteFechaDesde" class="filter-field-label">Desde:</label>
                  <div class="input-icon-wrapper">
                    <i class="bi bi-calendar3"></i>
                    <input type="date" id="reporteFechaDesde" class="form-control" title="Fecha Desde">
                  </div>
                </div>
                <div class="filter-field-group filter-date-box">
                  <label for="reporteFechaHasta" class="filter-field-label">Hasta:</label>
                  <div class="input-icon-wrapper">
                    <i class="bi bi-calendar3"></i>
                    <input type="date" id="reporteFechaHasta" class="form-control" title="Fecha Hasta">
                  </div>
                </div>
                <div class="filter-field-group search-input-box">
                  <label for="reporteSearch" class="filter-field-label">Búsqueda:</label>
                  <div class="input-icon-wrapper">
                    <i class="bi bi-search"></i>
                    <input type="text" id="reporteSearch" class="form-control"
                      placeholder="Buscar por obra / lugar / tarea...">
                  </div>
                </div>
              </div>
         

              <div class="table-reporte-wrapper">
                <table class="table table-reporte align-middle">
                  <thead>
                    <tr>
                      <th>Fecha</th>
                      <th>Lugar / Obra</th>
                      <th>Entrada</th>
                      <th>Salida</th>
                      <th>Horas Turno</th>
                      <th class="text-center">Bitácora y Comprobante</th>
                    </tr>
                  </thead>
                <!-- TABLA DE JORNADAS -->
<tbody>
  <% if (jornadas && jornadas.length > 0) { %>
    <% jornadas.forEach(j => { %>
      <% 
        const tieneTarea = Boolean(j.tarea && j.tarea.trim() !== '');
        const tieneComp = Boolean(j.comprobante && j.comprobante.trim() !== '');
        const faltaBitacora = !tieneTarea;
        const faltaComprobante = !tieneComp;
        const faltaAmbos = faltaBitacora && faltaComprobante;
        const tienePendiente = faltaBitacora || faltaComprobante;
        
        const esFechaPasada = Boolean(j.fecha && j.fecha < hoyBoliviaStr);
        const esReactivada = (j.asistencia_estado === 'HABILITADO_EDICION');
        const esBloqueada = esFechaPasada && !esReactivada;
        
        const esCongelado = (j.asistencia_estado === 'CONGELADO');
        const esObservado = (j.asistencia_estado === 'OBSERVADO') || esCongelado || (tienePendiente && esFechaPasada);
      %>
      
      <!-- FILA CON BORDE IZQUIERDO ROJO SI TIENE OBSERVACIÓN / REGISTRO PENDIENTE -->
      <tr class="<%= esObservado ? 'table-danger-custom' : '' %>" 
          style="<%= esObservado ? 'border-left: 4px solid #d90429 !important; background-color: #fff8f8;' : '' %>">
        
        <td>
          <i class="bi bi-calendar2-event me-2 text-primary"></i>
          <strong><%= j.fecha %></strong>
        </td>

        <td>
          <% if (j.modalidad === 'TELETRABAJO') { %>
            <span class="badge-modalidad-teletrabajo mb-1">
              <i class="bi bi-house-door"></i> Teletrabajo
            </span>
            <br><small class="text-muted"><%= j.lugar_nombre || 'Ubicación Remota' %></small>
          <% } else if (j.modalidad === 'HORA_EXTRA') { %>
            <span class="badge mb-1" style="background-color: #f3e8ff; color: #7c3aed; border: 1px solid #ddd6fe; font-size: 0.78rem;">
              <i class="bi bi-lightning-charge-fill"></i> Horas Extras
            </span>
          <% } else { %>
            <strong style="color: #1e293b;"><%= j.lugar_nombre || 'N/A' %></strong>
            <% if(j.lugar_tipo) { %>
              <br><small class="text-muted">(<%= j.lugar_tipo %>)</small>
            <% } %>
          <% } %>
        </td>

        <!-- HORA ENTRADA -->
        <td><%= j.hora_entrada_vis || j.hora_entrada || '-' %></td>

        <!-- HORA SALIDA -->
        <td><%= j.hora_salida_vis || j.hora_salida || '-' %></td>

        <!-- HORAS TURNO / ESTADO DE OBSERVACIÓN -->
        <td class="align-middle">
          <% if (j.horas_dia === 'En curso') { %>
            <span class="badge-turno-curso">
              <i class="bi bi-clock-history"></i> En curso
            </span>
          <% } else if (esCongelado) { %>
            <!-- BADGE DE HORAS CONGELADAS -->
            <span class="badge d-inline-flex align-items-center gap-1" 
                  style="background-color: #eff6ff !important; 
                         color: #1d4ed8 !important; 
                         border: 1px solid #bfdbfe !important; 
                         border-radius: 8px !important; 
                         padding: 4px 10px !important; 
                         font-size: 0.78rem !important; 
                         font-weight: 700 !important;">
              <i class="bi bi-snowflake" style="font-size: 0.85rem; color: #1d4ed8;"></i>
              <span>Horas Congeladas</span>
            </span>
            <br>
            <small class="text-secondary text-decoration-line-through fw-semibold d-block mt-1" style="font-size: 0.72rem;">
              <i class="bi bi-dash-circle me-1"></i><%= j.horas_dia %> (descontadas)
            </small>
          <% } else if (esObservado) { %>
            <!-- BADGE DE OBSERVACIÓN -->
            <span class="badge d-inline-flex align-items-center gap-1" 
                  style="background-color: #fff5f5 !important; 
                         color: #d90429 !important; 
                         border: 1px solid #ffb3b3 !important; 
                         border-radius: 8px !important; 
                         padding: 4px 10px !important; 
                         font-size: 0.78rem !important; 
                         font-weight: 700 !important;">
              <i class="bi bi-exclamation-circle" style="font-size: 0.85rem; color: #d90429;"></i>
              <span>Observación</span>
            </span>
            <br>
            <!-- HORAS CONGELADAS / EN OBSERVACIÓN -->
            <small class="text-secondary text-decoration-line-through fw-semibold d-block mt-1" style="font-size: 0.72rem;">
              <i class="bi bi-snowflake me-1"></i><%= j.horas_dia %> (congeladas)
            </small>
          <% } else { %>
            <span class="badge-turno-finalizado">
              <i class="bi bi-stopwatch"></i> <%= j.horas_dia %>
            </span>
          <% } %>
        </td>

        <!-- ACCIONES / BITÁCORA / COMPROBANTE -->
        <td class="text-center align-middle">
          
          <!-- Estado detallado del registro -->
          <div class="mb-1">
            <% if (faltaAmbos) { %>
              <span class="badge d-inline-flex align-items-center gap-1" style="background-color: #fff1f2; color: #e11d48; border: 1px solid #fecdd3; font-size: 0.74rem; font-weight: 600;">
                <i class="bi bi-exclamation-circle-fill"></i> Bitácora y comprobante pendientes
              </span>
            <% } else if (faltaBitacora) { %>
              <span class="badge d-inline-flex align-items-center gap-1" style="background-color: #fffbeb; color: #b45309; border: 1px solid #fde68a; font-size: 0.74rem; font-weight: 600;">
                <i class="bi bi-file-earmark-text"></i> Bitácora pendiente
              </span>
            <% } else if (faltaComprobante) { %>
              <span class="badge d-inline-flex align-items-center gap-1" style="background-color: #fffbeb; color: #b45309; border: 1px solid #fde68a; font-size: 0.74rem; font-weight: 600;">
                <i class="bi bi-camera"></i> Comprobante pendiente
              </span>
            <% } else { %>
              <span class="badge d-inline-flex align-items-center gap-1" style="background-color: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; font-size: 0.74rem; font-weight: 600;">
                <i class="bi bi-check-circle-fill"></i> Bitácora y comprobante al día
              </span>
            <% } %>
          </div>

          <!-- Botones de Acción (Respetando Bloqueo a las 00:00 y Reactivación Admin) -->
          <div class="d-inline-flex align-items-center justify-content-center gap-2 flex-wrap mt-1">
            <% if (tieneTarea || tieneComp) { %>
              <button type="button" class="btn-ojito-bitacora btn-ver-detalle-bitacora"
                data-tarea="<%= j.tarea || '' %>" 
                data-fecha="<%= j.fecha %>"
                data-lugar="<%= j.lugar_nombre || '' %>" 
                data-comprobante="<%= j.comprobante || '' %>"
                title="Ver detalle de actividades y evidencia">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                  <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                </svg>
              </button>
            <% } %>

            <% if (esReactivada) { %>
              <!-- REACTIVADA POR EL ADMINISTRADOR: PERMITE EDITAR / COMPLETAR AUNQUE SEA DÍA PASADO -->
              <button class="btn btn-warning btn-reporte-action btn-reporte py-1 px-2 fw-bold text-dark shadow-sm"
                data-asistencia="<%= j.id_asistencia %>" 
                data-tarea="<%= j.tarea || '' %>"
                data-comprobante="<%= j.comprobante || '' %>" 
                data-fecha="<%= j.fecha %>"
                title="Bitácora reactivada por el Administrador. Puedes editarla ahora." style="font-size: 0.8rem;">
                <i class="bi bi-unlock-fill me-1"></i> <%= (tieneTarea || tieneComp) ? 'Editar (Reactivada)' : 'Registrar (Reactivada)' %>
              </button>
            <% } else if (esBloqueada) { %>
              <!-- BLOQUEADA POR HORARIO 00:00 -->
              <span class="badge bg-secondary text-white py-1 px-2 d-inline-flex align-items-center gap-1 shadow-sm" 
                    style="font-size: 0.77rem; font-weight: 600; cursor: not-allowed;" 
                    title="Esta bitácora quedó bloqueada. Solicita al administrador su reactivación si requieres modificarla.">
                <i class="bi bi-lock-fill"></i> Bloqueada
              </span>
            <% } else { %>
              <!-- JORNADA DEL DÍA O EN CURSO: HABILITADA NORMALMENTE -->
              <% if (tieneTarea || tieneComp) { %>
                <button class="btn-reporte-action btn-reporte py-1 px-2"
                  data-asistencia="<%= j.id_asistencia %>" 
                  data-tarea="<%= j.tarea || '' %>"
                  data-comprobante="<%= j.comprobante || '' %>" 
                  data-fecha="<%= j.fecha %>"
                  title="Editar bitácora" style="font-size: 0.8rem;">
                  <i class="bi bi-pencil-square me-1"></i> Editar
                </button>
              <% } else { %>
                <button class="btn btn-success btn-reporte-action btn-reporte px-3 rounded-pill fw-bold shadow-sm" 
                  data-asistencia="<%= j.id_asistencia %>"
                  data-tarea="" 
                  data-comprobante="" 
                  data-fecha="<%= j.fecha %>"
                  title="Registrar bitácora de la jornada">
                  <i class="bi bi-plus-circle me-1"></i> Registrar
                </button>
              <% } %>
            <% } %>
          </div>

          <% if(j.observacion) { %>
            <div class="mt-1"><small class="text-danger fw-semibold">Obs: <%= j.observacion %></small></div>
          <% } %>
        </td>
      </tr>
    <% }); %>
  <% } else { %>
    <tr>
      <td colspan="6" class="text-center py-4 text-muted fw-semibold">No se encontraron registros de jornadas.</td>
    </tr>
  <% } %>
</tbody>
                </table>
              </div>
            </div>

    </div>

    <!-- MODAL INTERACTIVO: SOLICITAR TELETRABAJO Y VER SOLICITUDES -->
    <div class="modal fade" id="modalTeletrabajo" tabindex="-1" aria-labelledby="modalTeletrabajoLabel"
      aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content border-0 shadow-sm"
          style="border-radius: 16px; overflow: hidden; background: #ffffff;">
          <!-- ENCABEZADO LIMPIO Y MODERNO -->
          <div class="modal-header border-bottom py-3 px-4 flex-wrap gap-2 justify-content-between align-items-center"
            style="background: #ffffff; color: #0f172a;">
            <div>
              <h5 class="modal-title fw-bold mb-0 text-dark" id="modalTeletrabajoLabel" style="font-size: 1.25rem;">
                Módulo de Teletrabajo</h5>
              <small style="color: #64748b; font-weight: 500; font-size: 0.85rem;">Solicita autorización previa para
                trabajar de forma remota</small>
            </div>

            <div class="d-flex align-items-center gap-3">
              <!-- Pestañas de Navegación en el Encabezado -->
              <ul class="nav nav-pills nav-pills-teletrabajo list-unstyled mb-0" id="teletrabajoTabs" role="tablist"
                style="list-style: none; padding-left: 0;">
                <li class="nav-item" role="presentation">
                  <button class="nav-link active" id="tab-nueva-solicitud-tab" data-bs-toggle="pill"
                    data-bs-target="#tab-nueva-solicitud" type="button" role="tab" aria-selected="true">
                    + Nueva Solicitud
                  </button>
                </li>
                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="tab-mis-solicitudes-tab" data-bs-toggle="pill"
                    data-bs-target="#tab-mis-solicitudes" type="button" role="tab" aria-selected="false">
                    <i class="bi bi-list-check me-1"></i> Mis Solicitudes
                  </button>
                </li>
              </ul>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
          </div>

          <div class="modal-body p-4" style="background: #ffffff;">
            <div class="tab-content" id="teletrabajoTabsContent">
              <!-- TAB 1: FORMULARIO DE SOLICITUD -->
              <div class="tab-pane fade show active" id="tab-nueva-solicitud" role="tabpanel"
                aria-labelledby="tab-nueva-solicitud-tab">
                <form id="formSolicitarTeletrabajo">

                  <!-- TARJETA 1: Información de la Jornada -->
                  <div class="card border-0 mb-3"
                    style="border-radius: 12px; background: #ffffff; border: 1px solid #e2e8f0 !important; overflow: hidden;">
                    <div class="card-header py-2 px-3"
                      style="background: #f8fafc; border-bottom: 1px solid #e2e8f0 !important;">
                      <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem; line-height: 1.2;">Información de la
                        Jornada</h6>
                      <small class="text-muted d-block" style="font-size: 0.78rem; line-height: 1.2;">Selecciona la
                        fecha y el rango de horas estimado para tu jornada de teletrabajo.</small>
                    </div>
                    <div class="card-body p-3">
                      <div class="row g-3">
                        <div class="col-4">
                          <label for="teletrabajo_fecha" class="form-label fw-bold text-dark mb-1"
                            style="font-size: 0.85rem;">
                            Fecha Solicitada <span class="text-danger">*</span>
                          </label>
                          <input type="date" class="form-control" id="teletrabajo_fecha" name="fecha_solicitada"
                            style="border-radius: 8px; border-color: #cbd5e1;" required>
                        </div>

                        <div class="col-4">
