<% pageTitle='Panel de Reportes de Asistencia y Bitácora' ;
  pageSubtitle='Resumen de asistencias, actividades y solicitudes de horas extras' ; %>
  <%- include('../partials/header') %>

    <!-- Hoja de estilos independiente para Reportes -->
    <link rel="stylesheet" href="/css/reporte.css">
    <style>
      #modal_tarea,
      #modal_tarea::placeholder {
        font-family: 'Montserrat', sans-serif !important;
        font-weight: 300 !important;
      }

      #btn_seleccionar_comprobante {
        transition: all 0.2s ease;
      }

      #btn_seleccionar_comprobante:hover {
        background-color: #0958a6 !important;
        border-color: #0958a6 !important;
        transform: translateY(-1px);
        box-shadow: 0 3px 8px rgba(11, 107, 203, 0.25) !important;
      }

      .btn-ojito-bitacora {
        background: rgba(11, 107, 203, 0.08) !important;
        border: 1px solid rgba(11, 107, 203, 0.25) !important;
        color: #0b6bcb !important;
        border-radius: 6px !important;
        padding: 5px 8px !important;
        font-size: 0.84rem !important;
        line-height: 1 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        vertical-align: middle !important;
        cursor: pointer !important;
        transition: all 0.15s ease !important;
        text-decoration: none !important;
      }

      .btn-ojito-bitacora:hover {
        background: #0b6bcb !important;
        color: #ffffff !important;
        border-color: #0b6bcb !important;
        transform: scale(1.08);
      }

      .btn-ojito-bitacora svg {
        display: block;
        pointer-events: none;
      }
    </style>

    <div class="reporte-wrapper py-3">

      <!-- Encabezado, Resumen de Horas y Acciones -->
      <div class="reporte-header-row">
        <div>
          <h2 class="reporte-header-title">Mi Reporte de Jornadas</h2>
          <p class="reporte-header-user">
            <i class="bi bi-person me-1"></i>Usuario: <strong>
              <%= user.nombre %>
            </strong> | CI: <%= user.ci %>
          </p>
        </div>

        <div class="reporte-header-right">
          <div class="reporte-actions-group">
            <a href="/reportes/export" class="btn-excel-custom">
              <i class="bi bi-file-earmark-excel me-1"></i> Exportar a Excel
            </a>
            <!-- Botón: Solicitar Teletrabajo -->
            <button type="button" class="btn-teletrabajo-custom" data-bs-toggle="modal"
              data-bs-target="#modalTeletrabajo">
              <i class="bi bi-house-door me-1"></i> Solicitar Teletrabajo
            </button>
            <!-- Botón que activa la alerta interactiva de módulo en desarrollo -->
            <button type="button" class="btn-horas-extra-custom" data-bs-toggle="modal"
              data-bs-target="#modalEnProceso">
              <i class="bi bi-clock-history me-1"></i> Solicitar Horas Extra
            </button>
          </div>
        </div>
      </div>

      <!-- Banner de Permiso de Teletrabajo Activo Hoy (Si aplica) -->
      <% if (typeof teletrabajoHoy !=='undefined' && teletrabajoHoy) { %>
        <div class="banner-teletrabajo-hoy mb-3 shadow-sm">
          <div class="banner-title">
            <i class="bi bi-house-check-fill text-success fs-5"></i>
            <span>¡Tienes autorización de Teletrabajo para hoy!</span>
          </div>
          <div class="d-flex align-items-center gap-3">
            <p class="banner-desc">
              Ubicación: <strong>
                <%= teletrabajoHoy.direccion_remota || 'Domicilio particular' %>
              </strong>
              | Horario: <strong>
                <%= teletrabajoHoy.hora_inicio %> - <%= teletrabajoHoy.hora_fin %>
              </strong>
            </p>
            <a href="/geofence" class="btn btn-sm btn-success rounded-pill px-3 py-1 fw-semibold text-nowrap">
              <i class="bi bi-geo-alt-fill me-1"></i> Ir a Marcación
            </a>
          </div>
        </div>
        <% } %>

          <!-- Tarjeta: Panel de Verificación GPS / Geocerca -->
          <% const jHoy=(typeof jornadaHoy !=='undefined' && jornadaHoy) ? jornadaHoy : { estado: 'SIN_JORNADA' }; let
            badgeLabel='SIN JORNADA' ; let badgeClass='badge-status-grey' ; if (jHoy.estado==='EN_CURSO' ) {
            badgeLabel=jHoy.modalidad==='TELETRABAJO' ? 'EN CURSO (TELETRABAJO)' : 'EN CURSO' ;
            badgeClass='badge-status-blue' ; } else if (jHoy.estado==='COMPLETADA' ) {
            badgeLabel=jHoy.modalidad==='TELETRABAJO' ? 'COMPLETADA (OBSERVADO)' : 'COMPLETADA' ;
            badgeClass=jHoy.modalidad==='TELETRABAJO' ? 'badge-status-amber' : 'badge-status-green' ; } %>
            <div class="card-jornada-hoy-v2 mb-4">
              <!-- Banner Azul Superior -->
              <div class="jornada-banner-top">
                <div class="jornada-banner-left">
                  <div class="jornada-banner-circle">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                      viewBox="0 0 16 16">
                      <path d="M11 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5z" />
                      <path
                        d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H1a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z" />
                    </svg>
                  </div>
                  <div>
                    <h5 class="jornada-banner-title">Jornadas de hoy</h5>
                    <span class="jornada-banner-badge <%= badgeClass %>">
                      <%= badgeLabel %>
                    </span>
                  </div>
                </div>

                <div class="jornada-banner-right">
                  <div class="jornada-banner-divider"></div>
                  <div class="jornada-banner-circle">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor"
                      viewBox="0 0 16 16">
                      <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z" />
                      <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0" />
                    </svg>
                  </div>
                  <div>
                    <span class="jornada-hours-label">Horas acumuladas</span>
                    <span class="jornada-hours-val">
                      <%= total_acumulada %> <small>hrs</small>
                    </span>
                    <% if (typeof total_observadas !=='undefined' && total_observadas && total_observadas !=='00:00:00'
                      ) { %>
                      <small class="d-block text-warning fw-semibold" style="font-size: 0.75rem;">
                        <i class="bi bi-clock-history me-1"></i>+<%= total_observadas %> hrs en observación
                      </small>
                      <% } %>
                  </div>
                </div>
              </div>

              <!-- Cuerpo de la Tarjeta (Flujo de 3 Pasos + Footer) -->
              <div class="jornada-body-v2">

                <div class="jornada-workflow-container">
                  <!-- PASO 1: ENTRADA -->
                  <div class="jornada-workflow-col">
                    <span class="workflow-col-title text-entrada">ENTRADA</span>
                    <div class="jornada-step-card card-entrada">
                      <% if (jHoy.hora_entrada) { %>
                        <div class="step-card-header">
                          <div class="step-card-icon icon-entrada">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor"
                              viewBox="0 0 16 16">
                              <path fill-rule="evenodd"
                                d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 15h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0z" />
                              <path fill-rule="evenodd"
                                d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z" />
                            </svg>
                          </div>
                          <div class="step-card-info">
                            <span class="step-card-subtitle">Entrada registrada</span>
                            <span class="step-card-time">
                              <%= jHoy.hora_entrada %> hrs
                            </span>
                          </div>
                        </div>
                        <div class="step-card-body">
                          <div class="step-card-location">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                              viewBox="0 0 16 16">
                              <path
                                d="M12.166 8.94c-.524 1.062-1.234 2.12-1.96 3.07A32 32 0 0 1 8 14.58a32 32 0 0 1-2.206-2.57c-.726-.95-1.436-2.008-1.96-3.07C3.304 7.867 3 6.862 3 6a5 5 0 0 1 10 0c0 .862-.305 1.867-.834 2.94M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10" />
                              <path d="M8 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4" />
                            </svg>
                            <span>
                              <%= jHoy.modalidad==='TELETRABAJO' ? '🏠 Teletrabajo (Remoto)' : (jHoy.lugar_nombre
                                || 'Ubicación' ) %>
                            </span>
                          </div>
                          <div
                            class="step-card-badge <%= jHoy.modalidad === 'TELETRABAJO' ? 'badge-gps-amber' : 'badge-gps-green' %>">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor"
                              viewBox="0 0 16 16">
                              <path
                                d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z" />
                            </svg>
                            <%= jHoy.modalidad==='TELETRABAJO' ? 'GPS Remoto' : 'GPS verificado' %>
                          </div>
                        </div>
                        <% } else { %>
                          <div class="step-card-header">
                            <div class="step-card-icon icon-grey">
                              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor"
                                viewBox="0 0 16 16">
                                <path fill-rule="evenodd"
                                  d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 15h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0z" />
                                <path fill-rule="evenodd"
                                  d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z" />
                              </svg>
                            </div>
                            <div class="step-card-info">
                              <span class="step-card-subtitle">Aún no registrada</span>
                              <span class="step-card-desc-empty">Marca tu entrada al iniciar tu jornada</span>
                            </div>
                          </div>
                          <% } %>
                    </div>
                  </div>

                  <!-- FLECHA DE CONEXIÓN 1 -->
                  <div class="jornada-workflow-arrow">
                    <div class="arrow-circle">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                        viewBox="0 0 16 16">
                        <path fill-rule="evenodd"
                          d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8" />
                      </svg>
                    </div>
                  </div>

                  <!-- PASO 2: TIEMPO TRANSCURRIDO HOY (CRONÓMETRO) -->
                  <div class="jornada-workflow-col">
                    <span class="workflow-col-title text-timer">TIEMPO TRANSCURRIDO HOY</span>
                    <div class="jornada-step-card card-timer">
                      <div class="timer-icon-wrapper">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor"
                          viewBox="0 0 16 16">
                          <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z" />
                          <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0" />
                        </svg>
                      </div>
                      <div class="timer-display-digits" id="cronometro-display">
                        00:00:00
                      </div>
                      <div class="timer-labels">
                        <span>Horas</span>
                        <span>Minutos</span>
                        <span>Segundos</span>
                      </div>
                    </div>
                  </div>

                  <!-- FLECHA DE CONEXIÓN 2 -->
                  <div class="jornada-workflow-arrow">
                    <div class="arrow-circle">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                        viewBox="0 0 16 16">
                        <path fill-rule="evenodd"
                          d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8" />
                      </svg>
                    </div>
                  </div>

                  <!-- PASO 3: SALIDA -->
                  <div class="jornada-workflow-col">
                    <span class="workflow-col-title text-salida">SALIDA</span>
                    <div class="jornada-step-card card-salida">
                      <% if (jHoy.hora_salida) { %>
                        <div class="step-card-header">
                          <div class="step-card-icon icon-salida">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor"
                              viewBox="0 0 16 16">
                              <path fill-rule="evenodd"
                                d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 1h-8A1.5 1.5 0 0 0 0 2.5v9A1.5 1.5 0 0 0 1.5 13h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z" />
                              <path fill-rule="evenodd"
                                d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z" />
                            </svg>
                          </div>
                          <div class="step-card-info">
                            <span class="step-card-subtitle">Salida registrada</span>
                            <span class="step-card-time">
                              <%= jHoy.hora_salida %> hrs
                            </span>
                          </div>
                        </div>
                        <div class="step-card-body">
                          <div class="step-card-location">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                              viewBox="0 0 16 16">
                              <path
                                d="M12.166 8.94c-.524 1.062-1.234 2.12-1.96 3.07A32 32 0 0 1 8 14.58a32 32 0 0 1-2.206-2.57c-.726-.95-1.436-2.008-1.96-3.07C3.304 7.867 3 6.862 3 6a5 5 0 0 1 10 0c0 .862-.305 1.867-.834 2.94M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10" />
                              <path d="M8 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4" />
                            </svg>
                            <span>
                              <%= jHoy.lugar_nombre || 'Ubicación' %>
                            </span>
                          </div>
                          <div class="step-card-badge badge-gps-amber">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor"
                              viewBox="0 0 16 16">
                              <path
                                d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z" />
                            </svg>
                            GPS verificado
                          </div>
                        </div>
                        <% } else { %>
                          <div class="step-card-header">
                            <div class="step-card-icon icon-orange">
                              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor"
                                viewBox="0 0 16 16">
                                <path fill-rule="evenodd"
                                  d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 1h-8A1.5 1.5 0 0 0 0 2.5v9A1.5 1.5 0 0 0 1.5 13h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z" />
                                <path fill-rule="evenodd"
                                  d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z" />
                              </svg>
                            </div>
                            <div class="step-card-info">
                              <span class="step-card-subtitle">Aún no registrada</span>
                              <span class="step-card-desc-empty">Marca tu salida al finalizar tu jornada</span>
                            </div>
                          </div>
                          <% } %>
                    </div>
                  </div>
                </div>

                <!-- FOOTER DE ESTADO Y BOTÓN DE ACCIÓN -->
                <div class="jornada-bottom-bar">
                  <div class="jornada-bottom-status">
                    <% if (jHoy.estado==='EN_CURSO' ) { %>
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                        class="text-success me-2 flex-shrink-0" viewBox="0 0 16 16">
                        <path
                          d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l5-6.25a.75.75 0 0 0-.019-1.04" />
                      </svg>
                      <span class="status-text fw-semibold">Tu jornada está actualmente en curso.</span>
                      <% } else if (jHoy.estado==='COMPLETADA' ) { %>
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                          class="text-success me-2 flex-shrink-0" viewBox="0 0 16 16">
                          <path
                            d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l5-6.25a.75.75 0 0 0-.019-1.04" />
                        </svg>
                        <span class="status-text fw-semibold">Tu jornada de hoy se ha completado con éxito.</span>
                        <% } else { %>
                          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                            class="text-secondary me-2 flex-shrink-0" viewBox="0 0 16 16">
                            <path
                              d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l.451-.081zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2" />
                          </svg>
                          <span class="status-text text-muted">No tienes ninguna jornada activa hoy. Debes marcar
                            entrada con GPS.</span>
                          <% } %>
                  </div>

                  <div class="jornada-bottom-action">
                    <% if (jHoy.estado==='EN_CURSO' ) { %>
                      <a href="/geofence" class="btn-gps-blue">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                          viewBox="0 0 16 16">
                          <path
                            d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6" />
                        </svg>
                        Verificar ubicación y marcar salida
                      </a>
                      <% } else if (jHoy.estado==='SIN_JORNADA' ) { %>
                        <a href="/geofence" class="btn-gps-blue">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                            viewBox="0 0 16 16">
                            <path
                              d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6" />
                          </svg>
                          Verificar GPS e iniciar jornada
                        </a>
                        <% } else { %>
                          <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" disabled>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                              class="me-1" viewBox="0 0 16 16">
                              <path
                                d="M12.354 4.354a.5.5 0 0 0-.708-.708L5 10.293 1.854 7.146a.5.5 0 1 1-.708.708l3.5 3.5a.5.5 0 0 0 .708 0zm-4.208 7-.896-.897.707-.707.501.502 6.146-6.147a.5.5 0 0 1 .708.708l-7 7a.5.5 0 0 1-.708 0z" />
                            </svg>
                            Jornada finalizada
                          </button>
                          <% } %>
                  </div>
                </div>

              </div>
            </div>

            <!-- Tabla de Jornadas (Asistencia + Bitácora) -->
            <div class="card-historial-reporte">
              <h5 class="historial-reporte-title">
                <i class="bi bi-journal-text me-2 text-primary"></i>Historial de Asistencias y Bitácora
              </h5>

              <!-- Fila de Filtros / Controles (Rango de Fechas + Búsqueda) -->
              <div class="reporte-controls-row">
                <div class="filter-field-group filter-date-box">
                  <label for="reporteFechaDesde" class="filter-field-label">Desde:</label>
                  <div class="input-icon-wrapper">
                    <i class="bi bi-calendar3"></i>
                    <input type="date" id="reporteFechaDesde" class="form-control" title="Fecha Desde">
                  </div>
                </div>
                <div class="filter-field-group filter-date-box">
                  <label for="reporteFechaHasta" class="filter-field-label">Hasta:</label>
                  <div class="input-icon-wrapper">
                    <i class="bi bi-calendar3"></i>
                    <input type="date" id="reporteFechaHasta" class="form-control" title="Fecha Hasta">
                  </div>
                </div>
                <div class="filter-field-group search-input-box">
                  <label for="reporteSearch" class="filter-field-label">Búsqueda:</label>
                  <div class="input-icon-wrapper">
                    <i class="bi bi-search"></i>
                    <input type="text" id="reporteSearch" class="form-control"
                      placeholder="Buscar por obra / lugar / tarea...">
                  </div>
                </div>
              </div>

              <div class="table-reporte-wrapper">
                <table class="table table-reporte align-middle">
                  <thead>
                    <tr>
                      <th>Fecha</th>
                      <th>Lugar / Obra</th>
                      <th>Entrada</th>
                      <th>Salida</th>
                      <th>Horas Turno</th>
                      <th class="text-center">Bitacora</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (jornadas && jornadas.length> 0) { %>
                      <% jornadas.forEach(j=> { %>
                        <tr>
                          <td><i class="bi bi-calendar2-event me-2 text-primary"></i><strong>
                              <%= j.fecha %>
                            </strong></td>

                          <td>
                            <% if (j.modalidad==='TELETRABAJO' ) { %>
                              <span class="badge-modalidad-teletrabajo mb-1">
                                <i class="bi bi-house-door"></i> Teletrabajo
                              </span>
                              <br><small class="text-muted">
                                <%= j.lugar_nombre || 'Ubicación Remota' %>
                              </small>
                              <% } else { %>
                                <strong style="color: #1e293b;">
                                  <%= j.lugar_nombre || 'N/A' %>
                                </strong>
                                <% if(j.lugar_tipo) { %>
                                  <br><small class="text-muted">(<%= j.lugar_tipo %>)</small>
                                  <% } %>
                                    <% } %>
                          </td>

                          <!-- HORA ENTRADA -->
                          <td>
                            <%= j.hora_entrada_vis || j.hora_entrada || '-' %>
                          </td>

                          <!-- HORA SALIDA -->
                          <td>
                            <%= j.hora_salida_vis || j.hora_salida || '-' %>
                          </td>

                          <!-- HORAS TRANSCURRIDAS POR FECHA -->
                          <td>
                            <% if (j.horas_dia==='En curso' ) { %>
                              <span class="badge-turno-curso">
                                <i class="bi bi-clock-history"></i> En curso
                              </span>
                              <% } else { %>
                                <span class="badge-turno-finalizado">
                                  <i class="bi bi-stopwatch"></i>
                                  <%= j.horas_dia %>
                                </span>
                                <% } %>
                                  <% if (j.asistencia_estado==='OBSERVADO' ) { %>
                                    <br><span class="badge-estado-observado"
                                      title="Pendiente de aprobación de bitácora por el Administrador">
                                      <i class="bi bi-clock-history"></i> En Observación
                                    </span>
                                    <% } %>
                          </td>

                          <td class="text-center">
                            <% if (j.tarea || j.comprobante) { %>
                              <div class="d-inline-flex align-items-center justify-content-center gap-2">
                                <button type="button" class="btn-ojito-bitacora btn-ver-detalle-bitacora"
                                  data-tarea="<%= j.tarea || '' %>" data-fecha="<%= j.fecha %>"
                                  data-lugar="<%= j.lugar_nombre || '' %>" data-comprobante="<%= j.comprobante || '' %>"
                                  title="Ver detalle">
                                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                    viewBox="0 0 16 16">
                                    <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                    <path
                                      d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                                  </svg>
                                </button>

                                <button class="btn-reporte-action btn-reporte py-1 px-2"
                                  data-asistencia="<%= j.id_asistencia %>" data-tarea="<%= j.tarea || '' %>"
                                  data-comprobante="<%= j.comprobante || '' %>" data-fecha="<%= j.fecha %>"
                                  title="Editar bitácora" style="font-size: 0.8rem;">
                                  <i class="bi bi-pencil-square me-1"></i> Editar
                                </button>
                              </div>
                              <% } else { %>
                                <button class="btn-reporte-action btn-reporte" data-asistencia="<%= j.id_asistencia %>"
                                  data-tarea="" data-comprobante="" data-fecha="<%= j.fecha %>"
                                  title="Registrar bitácora">
                                  <i class="bi bi-plus-circle me-1"></i> Registrar
                                </button>
                                <% } %>
                                  <% if(j.observacion) { %>
                                    <br><small class="text-danger">Obs: <%= j.observacion %></small>
                                    <% } %>
                          </td>
                        </tr>
                        <% }); %>
                          <% } else { %>
                            <tr>
                              <td colspan="6" class="text-center py-4 text-muted fw-semibold">No se encontraron
                                registros de
                                jornadas.</td>
                            </tr>
                            <% } %>
                  </tbody>
                </table>
              </div>
            </div>

    </div>

    <!-- MODAL INTERACTIVO: SOLICITAR TELETRABAJO Y VER SOLICITUDES -->
    <div class="modal fade" id="modalTeletrabajo" tabindex="-1" aria-labelledby="modalTeletrabajoLabel"
      aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content border-0 shadow-sm"
          style="border-radius: 16px; overflow: hidden; background: #ffffff;">
          <!-- ENCABEZADO LIMPIO Y MODERNO -->
          <div class="modal-header border-bottom py-3 px-4 flex-wrap gap-2 justify-content-between align-items-center"
            style="background: #ffffff; color: #0f172a;">
            <div>
              <h5 class="modal-title fw-bold mb-0 text-dark" id="modalTeletrabajoLabel" style="font-size: 1.25rem;">
                Módulo de Teletrabajo</h5>
              <small style="color: #64748b; font-weight: 500; font-size: 0.85rem;">Solicita autorización previa para
                trabajar de forma remota</small>
            </div>

            <div class="d-flex align-items-center gap-3">
              <!-- Pestañas de Navegación en el Encabezado -->
              <ul class="nav nav-pills nav-pills-teletrabajo list-unstyled mb-0" id="teletrabajoTabs" role="tablist"
                style="list-style: none; padding-left: 0;">
                <li class="nav-item" role="presentation">
                  <button class="nav-link active" id="tab-nueva-solicitud-tab" data-bs-toggle="pill"
                    data-bs-target="#tab-nueva-solicitud" type="button" role="tab" aria-selected="true">
                    + Nueva Solicitud
                  </button>
                </li>
                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="tab-mis-solicitudes-tab" data-bs-toggle="pill"
                    data-bs-target="#tab-mis-solicitudes" type="button" role="tab" aria-selected="false">
                    <i class="bi bi-list-check me-1"></i> Mis Solicitudes
                  </button>
                </li>
              </ul>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
          </div>

          <div class="modal-body p-4" style="background: #ffffff;">
            <div class="tab-content" id="teletrabajoTabsContent">
              <!-- TAB 1: FORMULARIO DE SOLICITUD -->
              <div class="tab-pane fade show active" id="tab-nueva-solicitud" role="tabpanel"
                aria-labelledby="tab-nueva-solicitud-tab">
                <form id="formSolicitarTeletrabajo">

                  <!-- TARJETA 1: Información de la Jornada -->
                  <div class="card border-0 mb-3"
                    style="border-radius: 12px; background: #ffffff; border: 1px solid #e2e8f0 !important; overflow: hidden;">
                    <div class="card-header py-2 px-3"
                      style="background: #f8fafc; border-bottom: 1px solid #e2e8f0 !important;">
                      <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem; line-height: 1.2;">Información de la
                        Jornada</h6>
                      <small class="text-muted d-block" style="font-size: 0.78rem; line-height: 1.2;">Selecciona la
                        fecha y el rango de horas estimado para tu jornada de teletrabajo.</small>
                    </div>
                    <div class="card-body p-3">
                      <div class="row g-3">
                        <div class="col-4">
                          <label for="teletrabajo_fecha" class="form-label fw-bold text-dark mb-1"
                            style="font-size: 0.85rem;">
                            Fecha Solicitada <span class="text-danger">*</span>
                          </label>
                          <input type="date" class="form-control" id="teletrabajo_fecha" name="fecha_solicitada"
                            style="border-radius: 8px; border-color: #cbd5e1;" required>
                        </div>

                        <div class="col-4">
                          <label for="teletrabajo_hora_inicio" class="form-label fw-bold text-dark mb-1"
                            style="font-size: 0.85rem;">
                            Hora Inicio Estimada
                          </label>
                          <input type="time" class="form-control" id="teletrabajo_hora_inicio" name="hora_inicio"
                            value="08:00" style="border-radius: 8px; border-color: #cbd5e1;">
                        </div>

                        <div class="col-4">
                          <label for="teletrabajo_hora_fin" class="form-label fw-bold text-dark mb-1"
                            style="font-size: 0.85rem;">
                            Hora Fin Estimada
                          </label>
                          <input type="time" class="form-control" id="teletrabajo_hora_fin" name="hora_fin"
                            value="17:00" style="border-radius: 8px; border-color: #cbd5e1;">
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- TARJETA 2: Detalle de la Solicitud -->
                  <div class="card border-0 mb-3"
                    style="border-radius: 12px; background: #ffffff; border: 1px solid #e2e8f0 !important; overflow: hidden;">
                    <div class="card-header py-2 px-3"
                      style="background: #f8fafc; border-bottom: 1px solid #e2e8f0 !important;">
                      <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem; line-height: 1.2;">Detalle de la
                        Solicitud</h6>
                      <small class="text-muted d-block" style="font-size: 0.78rem; line-height: 1.2;">Indica el lugar
                        desde donde trabajarás y el motivo de tu solicitud.</small>
                    </div>
                    <div class="card-body p-3">
                      <div class="row g-3">
                        <div class="col-12">
                          <label for="teletrabajo_direccion" class="form-label fw-bold text-dark mb-1"
                            style="font-size: 0.85rem;">
                            Ubicación / Domicilio <span class="text-danger">*</span>
                          </label>
                          <input type="text" class="form-control w-100" id="teletrabajo_direccion"
                            name="direccion_remota" style="border-radius: 8px; border-color: #cbd5e1; width: 100%;"
                            placeholder="Ej: Domicilio particular - Zona Sopocachi" value="Domicilio particular"
                            required>
                          <small class="text-muted d-block mt-1" style="font-size: 0.76rem;">Lugar donde establecerás tu
                            geocerca remota.</small>
                        </div>

                        <div class="col-12 mt-2">
                          <label for="teletrabajo_motivo" class="form-label fw-bold text-dark mb-1"
                            style="font-size: 0.85rem;">
                            Justificación / Motivo del Teletrabajo <span class="text-danger">*</span>
                          </label>
                          <textarea class="form-control w-100" id="teletrabajo_motivo" name="motivo" rows="3"
                            style="border-radius: 8px; border-color: #cbd5e1; width: 100%;" required
                            placeholder="Explica detalladamente las razones por las cuales solicitas realizar tu jornada en modalidad remota..."></textarea>
                          <div class="d-flex justify-content-between align-items-center mt-1">
                            <small class="text-muted" style="font-size: 0.76rem;">Mínimo 5 caracteres. El administrador
                              revisará esta información para su aprobación.</small>
                            <small class="text-muted" style="font-size: 0.76rem;" id="charCounterMotivo">0/500</small>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- BOTONES DE ACCIÓN -->
                  <div class="d-flex justify-content-end gap-2 pt-2">
                    <button type="button" class="btn btn-light border px-4 py-2 text-secondary fw-semibold"
                      style="border-radius: 10px; background: #f1f5f9; border-color: #cbd5e1 !important;"
                      data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" id="btnEnviarTeletrabajo" class="btn btn-primary px-4 py-2 fw-semibold"
                      style="background: #2563eb; border-color: #2563eb; border-radius: 10px;">
                      <i class="bi bi-send-fill me-1"></i> Enviar Solicitud
                    </button>
                  </div>
                </form>
              </div>

              <!-- TAB 2: HISTORIAL DE MIS SOLICITUDES -->
              <div class="tab-pane fade" id="tab-mis-solicitudes" role="tabpanel"
                aria-labelledby="tab-mis-solicitudes-tab">
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history me-1 text-primary"></i> Estado de tus
                    solicitudes</h6>
                  <button type="button" class="btn btn-sm btn-primary px-3 fw-semibold text-white"
                    id="btnRecargarMisSolicitudes" style="background-color: #2563eb; border-color: #2563eb;">
                    <i class="bi bi-arrow-clockwise me-1"></i> Actualizar
                  </button>
                </div>

                <div class="table-responsive" style="max-height: 340px; overflow-y: auto;">
                  <table
                    class="table table-sm table-bordered table-hover align-middle table-teletrabajo-solicitudes mb-0">
                    <thead>
                      <tr>
                        <th>Fecha Solicitada</th>
                        <th>Horario</th>
                        <th>Ubicación</th>
                        <th>Estado</th>
                        <th>Observación Admin</th>
                      </tr>
                    </thead>
                    <tbody id="tbodyMisSolicitudes">
                      <tr>
                        <td colspan="5" class="text-center py-3 text-muted">
                          <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                          Cargando solicitudes...
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- MODAL INTERACTIVO: MÓDULO EN PROCESO -->
    <div class="modal fade" id="modalEnProceso" tabindex="-1" aria-labelledby="modalEnProcesoLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-3">
          <div class="modal-header border-0 pb-0 justify-content-end">
            <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Cerrar">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
          <div class="modal-body py-3">
            <div class="mb-3">
              <i class="bi bi-cone-stripes text-warning display-3"></i>
            </div>
            <h4 class="fw-bold mb-2">Módulo en Desarrollo</h4>
            <p class="text-muted mb-0">
              La funcionalidad para <strong>Solicitar Horas Extra</strong> se encuentra actualmente en proceso de
              construcción y estará disponible próximamente.
            </p>
          </div>
          <div class="modal-footer justify-content-center border-0 pt-0">
            <button type="button" class="btn btn-secondary px-4 rounded-3" data-bs-dismiss="modal">Entendido</button>
          </div>
        </div>
      </div>
    </div>

    <!-- MODAL: REGISTRAR / EDITAR BITÁCORA -->
    <div class="modal fade" id="modalReporte" tabindex="-1">
      <div class="modal-dialog">
        <div class="modal-content">
          <form id="formReporte">
            <div class="modal-header">
              <h5 class="modal-title fw-bold">Bitácora de Trabajo</h5>
              <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Cerrar">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>
            <div class="modal-body">
              <input type="hidden" name="id_asistencia" id="modal_id_asistencia">

              <!-- Fecha de la jornada seleccionada -->
              <div class="d-flex align-items-center justify-content-between p-2 mb-3 bg-light rounded border">
                <span class="text-muted fs-7"><i class="bi bi-calendar2-event me-1 text-primary"></i> Fecha de la
                  jornada:</span>
                <span id="modal_reporte_fecha"
                  class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1"
                  style="font-size: 0.82rem; font-weight: 600;"></span>
              </div>

              <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label class="form-label fw-semibold mb-0">Descripción de la Tarea / Avance <span
                      class="text-danger">*</span></label>
                  <small class="text-muted" style="font-size: 0.78rem;"><span id="modal_tarea_count">0</span>/350
                    letras</small>
                </div>
                <textarea class="form-control" name="tarea" id="modal_tarea" rows="4" maxlength="350" required
                  style="resize: none; width: 100%; font-family: 'Montserrat', sans-serif !important; font-weight: 300 !important;"
                  placeholder="Describe las actividades realizadas en la jornada..."></textarea>
              </div>

              <!-- Comprobante existente si aplica -->
              <div id="preview_existing_container" class="mb-3 p-2 bg-light rounded border" style="display: none;">
                <div class="d-flex align-items-center justify-content-between">
                  <span class="text-muted fs-7"><i class="bi bi-image me-1"></i> Comprobante guardado:</span>
                  <a href="#" id="preview_existing_link" target="_blank"
                    class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 12px;">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Ver comprobante actual
                  </a>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold mb-2">Adjuntar Comprobante (PNG / JPG / WEBP)</label>

                <!-- Input file real 100% oculto -->
                <input type="file" name="comprobante" id="modal_comprobante"
                  accept="image/png, image/jpeg, image/jpg, image/webp" style="display: none !important;">

                <!-- Contenedor con UN SOLO BOTÓN BONITO y texto del archivo -->
                <div class="d-flex align-items-center gap-2 p-2 rounded-3 border" style="background-color: #f8fafc;">
                  <button type="button" id="btn_seleccionar_comprobante"
                    class="btn btn-sm btn-primary px-3 py-2 fw-semibold rounded-2 d-inline-flex align-items-center gap-2 shadow-sm"
                    style="background-color: #0b6bcb; border-color: #0b6bcb; font-size: 0.85rem; flex-shrink: 0;">
                    <i class="bi bi-cloud-arrow-up-fill fs-6"></i> Seleccionar archivo
                  </button>
                  <span id="upload_file_info" class="text-muted text-truncate ps-1" style="font-size: 0.83rem;">
                    Ningún archivo seleccionado
                  </span>
                </div>

                <small class="text-muted d-block mt-1" style="font-size: 0.78rem;">
                  <i class="bi bi-shield-check text-success me-1"></i>Las imágenes se subirán automáticamente a
                  Cloudinary.
                </small>
              </div>

              <!-- Previsualización de nueva imagen seleccionada -->
              <div id="preview_new_container" class="mb-3 text-center" style="display: none;">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <small class="text-muted fw-semibold">Previsualización de nueva imagen:</small>
                  <button type="button" id="btn_quitar_img" class="btn btn-sm btn-link text-danger p-0"
                    style="font-size: 12px;">Quitar</button>
                </div>
                <img id="preview_new_img" src="" alt="Previsualización" class="img-fluid rounded border shadow-sm"
                  style="max-height: 180px; object-fit: contain;">
              </div>

              <!-- Estado de carga / spinner -->
              <div id="upload_feedback" class="alert alert-info py-2 px-3 align-items-center gap-2 mb-0"
                style="display: none; font-size: 0.875rem;">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                <span id="upload_feedback_text">Subiendo imagen a Cloudinary...</span>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
              <button type="submit" id="btnGuardarReporte" class="btn btn-primary"
                style="background-color: #0b6bcb; border-color: #0b6bcb;">
                <i class="bi bi-check2-circle me-1"></i> Guardar Bitácora
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- MODAL INTERACTIVO: VER BITÁCORA DETALLADA (CENTRADOS) -->
    <div class="modal fade" id="modalVerBitacora" tabindex="-1" aria-labelledby="modalVerBitacoraLabel"
      aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header" style="background-color: #f0f5fc;">
            <h5 class="modal-title fw-bold" id="modalVerBitacoraLabel" style="color: #0b3c5d;">
              <i class="bi bi-journal-text me-2 text-primary"></i>Detalle de Tarea / Bitácora
            </h5>
            <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Cerrar">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
          <div class="modal-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
              <span class="text-muted fs-7"><i class="bi bi-calendar2-event me-1 text-primary"></i> Fecha: <strong
                  id="modalVerBitacoraFecha" class="text-dark"></strong></span>
              <span class="text-muted fs-7" id="modalVerBitacoraLugarWrap" style="display: none;"><i
                  class="bi bi-geo-alt me-1 text-danger"></i> Obra: <strong id="modalVerBitacoraLugar"
                  class="text-dark"></strong></span>
            </div>
            <label class="form-label fw-bold text-dark mb-2">Descripción Completa:</label>
            <div id="modalVerBitacoraTexto" class="p-3 bg-light rounded border mb-3"
              style="max-height: 200px; overflow-y: auto; word-break: break-word; white-space: pre-wrap; font-size: 0.93rem; color: #1e293b; line-height: 1.5;">
            </div>

            <!-- Sección Comprobante Adjunto dentro del Modal -->
            <div id="modalVerBitacoraComprobanteWrap" class="pt-2 border-top" style="display: none;">
              <label class="form-label fw-bold text-dark mb-2">
                <i class="bi bi-image text-primary me-1"></i> Comprobante Adjunto:
              </label>
              <div class="text-center p-3 bg-light rounded border">
                <a href="#" id="modalVerBitacoraImgLink" target="_blank"
                  title="Haz clic para ver la imagen en tamaño completo">
                  <img id="modalVerBitacoraImg" src="" alt="Comprobante" class="img-fluid rounded shadow-sm border mb-2"
                    style="max-height: 220px; object-fit: contain; width: auto;">
                </a>
                <div>
                  <a href="#" id="modalVerBitacoraLink" target="_blank"
                    class="btn btn-sm btn-outline-primary px-3 py-1 rounded-pill" style="font-size: 0.82rem;">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Abrir imagen completa
                  </a>
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer border-top-0 pt-0">
            <button type="button" class="btn btn-secondary px-4 rounded-3" data-bs-dismiss="modal">Cerrar</button>
          </div>
        </div>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- INICIO: INCLUSIÓN DEL COMPONENTE DE ALERTA REUTILIZABLE -->
    <!-- ========================================================================= -->
    <%- include('../partials/toast-alert') %>
      <!-- ========================================================================= -->
      <!-- FIN: INCLUSIÓN DEL COMPONENTE DE ALERTA REUTILIZABLE -->
      <!-- ========================================================================= -->

      <!-- 2. Script Oficial de Bootstrap -->
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

      <!-- 3. Lógica JavaScript de la Vista -->
      <script>
        document.addEventListener('DOMContentLoaded', () => {
          // Filtrado en vivo de Tabla de Reportes (Rango de Fechas + Búsqueda por texto)
          const reporteFechaDesde = document.getElementById('reporteFechaDesde');
          const reporteFechaHasta = document.getElementById('reporteFechaHasta');
          const reporteSearch = document.getElementById('reporteSearch');
          const tableReporteRows = document.querySelectorAll('.table-reporte tbody tr');

          function filterReporteTable() {
            const searchTerm = reporteSearch ? reporteSearch.value.toLowerCase().trim() : '';
            const fechaDesde = reporteFechaDesde ? reporteFechaDesde.value : '';
            const fechaHasta = reporteFechaHasta ? reporteFechaHasta.value : '';

            tableReporteRows.forEach(row => {
              if (row.children.length <= 1) return; // Fila vacía o de mensaje

              const cellFecha = row.cells[0] ? row.cells[0].textContent : '';
              const matchDate = cellFecha.match(/\d{4}-\d{2}-\d{2}/);
              const rowFecha = matchDate ? matchDate[0] : cellFecha.trim();

              const rowText = row.textContent.toLowerCase();
              const matchesSearch = !searchTerm || rowText.includes(searchTerm);

              let matchesDate = true;
              if (fechaDesde && rowFecha < fechaDesde) matchesDate = false;
              if (fechaHasta && rowFecha > fechaHasta) matchesDate = false;

              if (matchesSearch && matchesDate) {
                row.style.display = '';
              } else {
                row.style.display = 'none';
              }
            });
          }

          if (reporteFechaDesde) reporteFechaDesde.addEventListener('change', filterReporteTable);
          if (reporteFechaHasta) reporteFechaHasta.addEventListener('change', filterReporteTable);
          if (reporteSearch) reporteSearch.addEventListener('input', filterReporteTable);

          const modalEl = document.getElementById('modalReporte');
          const modalReporte = new bootstrap.Modal(modalEl);
          const formReporte = document.getElementById('formReporte');
          const fileInput = document.getElementById('modal_comprobante');
          const previewNewContainer = document.getElementById('preview_new_container');
          const previewNewImg = document.getElementById('preview_new_img');
          const btnQuitarImg = document.getElementById('btn_quitar_img');
          const previewExistingContainer = document.getElementById('preview_existing_container');
          const previewExistingLink = document.getElementById('preview_existing_link');
          const uploadFeedback = document.getElementById('upload_feedback');
          const uploadFeedbackText = document.getElementById('upload_feedback_text');
          const btnGuardar = document.getElementById('btnGuardarReporte');

          // Modal Ver Bitácora Completa
          const modalVerBitacoraEl = document.getElementById('modalVerBitacora');
          const modalVerBitacora = modalVerBitacoraEl ? new bootstrap.Modal(modalVerBitacoraEl) : null;

          document.querySelectorAll('.btn-ver-detalle-bitacora').forEach(btn => {
            btn.addEventListener('click', () => {
              const tarea = btn.dataset.tarea || 'Sin descripción registrada.';
              const fecha = btn.dataset.fecha || '';
              const lugar = btn.dataset.lugar || '';
              const comprobante = btn.dataset.comprobante || '';

              document.getElementById('modalVerBitacoraFecha').textContent = fecha;
              document.getElementById('modalVerBitacoraTexto').textContent = tarea;

              const lugarWrap = document.getElementById('modalVerBitacoraLugarWrap');
              const lugarEl = document.getElementById('modalVerBitacoraLugar');
              if (lugar) {
                lugarEl.textContent = lugar;
                lugarWrap.style.display = 'inline';
              } else {
                lugarWrap.style.display = 'none';
              }

              const compWrap = document.getElementById('modalVerBitacoraComprobanteWrap');
              const compImg = document.getElementById('modalVerBitacoraImg');
              const compLink = document.getElementById('modalVerBitacoraLink');
              const compImgLink = document.getElementById('modalVerBitacoraImgLink');

              if (comprobante && comprobante.trim() !== '') {
                compWrap.style.display = 'block';
                compImg.src = comprobante.trim();
                compLink.href = comprobante.trim();
                if (compImgLink) compImgLink.href = comprobante.trim();
              } else {
                compWrap.style.display = 'none';
                compImg.src = '';
                compLink.href = '#';
                if (compImgLink) compImgLink.href = '#';
              }

              if (modalVerBitacora) modalVerBitacora.show();
            });
          });

          const btnSeleccionarComprobante = document.getElementById('btn_seleccionar_comprobante');
          const uploadFileInfo = document.getElementById('upload_file_info');

          if (btnSeleccionarComprobante) {
            btnSeleccionarComprobante.addEventListener('click', () => {
              fileInput.click();
            });
          }

          // Helper para previsualizar imagen seleccionada
          fileInput.addEventListener('change', () => {
            if (fileInput.files && fileInput.files[0]) {
              const file = fileInput.files[0];
              if (uploadFileInfo) {
                uploadFileInfo.innerHTML = `<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check2-circle me-1"></i>${file.name}</span>`;
              }
              const reader = new FileReader();
              reader.onload = (e) => {
                previewNewImg.src = e.target.result;
                previewNewContainer.style.display = 'block';
              };
              reader.readAsDataURL(file);
            } else {
              limpiarPreviewNueva();
            }
          });

          function limpiarPreviewNueva() {
            fileInput.value = '';
            previewNewImg.src = '';
            previewNewContainer.style.display = 'none';
            if (uploadFileInfo) {
              uploadFileInfo.textContent = 'Ningún archivo seleccionado';
            }
          }

          if (btnQuitarImg) {
            btnQuitarImg.addEventListener('click', limpiarPreviewNueva);
          }

          // Abrir Modal de Bitácora
          document.querySelectorAll('.btn-reporte').forEach(btn => {
            btn.addEventListener('click', () => {
              formReporte.reset();
              limpiarPreviewNueva();
              uploadFeedback.style.display = 'none';

              const asistenciaId = btn.dataset.asistencia;
              const tareaTexto = btn.dataset.tarea || '';
              const comprobanteActual = btn.dataset.comprobante || '';
              const fechaJornada = btn.dataset.fecha || '';

              document.getElementById('modal_id_asistencia').value = asistenciaId;
              const modalFechaEl = document.getElementById('modal_reporte_fecha');
              if (modalFechaEl) {
                modalFechaEl.textContent = fechaJornada;
              }

              const inputTarea = document.getElementById('modal_tarea');
              inputTarea.value = tareaTexto;
              const charCountEl = document.getElementById('modal_tarea_count');
              if (charCountEl) charCountEl.textContent = inputTarea.value.length;

              if (comprobanteActual && comprobanteActual.trim() !== '') {
                previewExistingContainer.style.display = 'block';
                previewExistingLink.href = comprobanteActual.trim();
              } else {
                previewExistingContainer.style.display = 'none';
                previewExistingLink.href = '#';
              }

              modalReporte.show();
            });
          });

          const modalTareaInput = document.getElementById('modal_tarea');
          const modalTareaCountSpan = document.getElementById('modal_tarea_count');
          if (modalTareaInput && modalTareaCountSpan) {
            modalTareaInput.addEventListener('input', () => {
              modalTareaCountSpan.textContent = modalTareaInput.value.length;
            });
          }

          // Función para subir a Cloudinary directamente desde el navegador
          async function subirACloudinary(file) {
            const cloudName = '<%= cloudinaryCloudName %>';
            const uploadPreset = '<%= cloudinaryUploadPreset %>';

            if (!cloudName || !uploadPreset) return null;

            const formData = new FormData();
            formData.append('file', file);
            formData.append('upload_preset', uploadPreset);

            const res = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/image/upload`, {
              method: 'POST',
              body: formData
            });

            if (!res.ok) {
              const errorData = await res.json().catch(() => ({}));
              throw new Error(errorData.error?.message || 'Error en Cloudinary');
            }

            const data = await res.json();
            return data.secure_url || data.url;
          }

          // Enviar Formulario
          formReporte.addEventListener('submit',
            async (e) => {
              e.preventDefault();
              const id_asistencia = document.getElementById('modal_id_asistencia').value;
              const tarea = document.getElementById('modal_tarea').value.trim();
              const file = fileInput.files && fileInput.files[0];

              if (!id_asistencia || !tarea) {
                mostrarAlerta('Por favor completa la descripción de la tarea.', 'warning');
                return;
              }

              try {
                btnGuardar.disabled = true;
                let comprobanteUrl = null;

                // 1. Si se seleccionó archivo, subir a Cloudinary
                if (file) {
                  uploadFeedback.style.display = 'flex';
                  uploadFeedbackText.textContent = 'Subiendo comprobante a Cloudinary...';

                  try {
                    comprobanteUrl = await subirACloudinary(file);
                  } catch (cloudErr) {
                    console.warn('Fallo en Cloudinary, intentando subida directa por servidor:', cloudErr);
                  }
                }

                // 2. Guardar en backend
                uploadFeedback.style.display = 'flex';
                uploadFeedbackText.textContent = 'Guardando bitácora en el sistema...';

                let res;
                if (comprobanteUrl) {
                  // Se subió a Cloudinary exitosamente
                  res = await fetch('/reportes/guardar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id_asistencia, tarea, comprobante: comprobanteUrl })
                  });
                } else {
                  // Fallback con FormData (Multer local si Cloudinary no respondió)
                  const fd = new FormData();
                  fd.append('id_asistencia', id_asistencia);
                  fd.append('tarea', tarea);
                  if (file) {
                    fd.append('comprobante', file);
                  }
                  res = await fetch('/reportes/guardar', {
                    method: 'POST',
                    body: fd
                  });
                }

                const data = await res.json();

                if (data.ok) {
                  modalReporte.hide();
                  mostrarAlerta(data.msg || 'Bitácora guardada correctamente', 'success');
                  setTimeout(() => {
                    location.reload();
                  }, 1000);
                } else {
                  mostrarAlerta(data.error || 'Error al guardar la bitácora', 'error');
                }
              } catch (err) {
                console.error(err);
                mostrarAlerta('Error de conexión al procesar la bitácora: ' + err.message, 'error');
              } finally {
                btnGuardar.disabled = false;
                uploadFeedback.style.display = 'none';
              }
            });

          // =========================================================================
          // LÓGICA DE TELETRABAJO (SOLICITAR Y LISTAR)
          // =========================================================================
          const teletrabajoFechaInput = document.getElementById('teletrabajo_fecha');
          if (teletrabajoFechaInput) {
            const hoyYMD = new Date().toLocaleDateString('sv-SE', { timeZone: 'America/La_Paz' });
            teletrabajoFechaInput.value = hoyYMD;
            teletrabajoFechaInput.min = hoyYMD;
          }

          const teletrabajoMotivo = document.getElementById('teletrabajo_motivo');
          const charCounterMotivo = document.getElementById('charCounterMotivo');
          if (teletrabajoMotivo && charCounterMotivo) {
            teletrabajoMotivo.addEventListener('input', () => {
              charCounterMotivo.textContent = `${teletrabajoMotivo.value.length}/500`;
            });
          }

          // Enviar solicitud de teletrabajo
          const formSolicitarTeletrabajo = document.getElementById('formSolicitarTeletrabajo');
          const btnEnviarTeletrabajo = document.getElementById('btnEnviarTeletrabajo');
          const modalTeletrabajoEl = document.getElementById('modalTeletrabajo');
          const modalTeletrabajo = modalTeletrabajoEl ? new bootstrap.Modal(modalTeletrabajoEl) : null;

          if (formSolicitarTeletrabajo) {
            formSolicitarTeletrabajo.addEventListener('submit', async (e) => {
              e.preventDefault();
              const fd = new FormData(formSolicitarTeletrabajo);
              const payload = Object.fromEntries(fd.entries());

              try {
                if (btnEnviarTeletrabajo) btnEnviarTeletrabajo.disabled = true;

                const res = await fetch('/api/teletrabajo/solicitar', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(payload)
                });

                const data = await res.json();

                if (data.ok) {
                  mostrarAlerta(data.msg, 'success');
                  formSolicitarTeletrabajo.reset();
                  if (teletrabajoFechaInput) {
                    teletrabajoFechaInput.value = new Date().toLocaleDateString('sv-SE', { timeZone: 'America/La_Paz' });
                  }
                  // Cambiar a la pestaña de Mis Solicitudes para verla
                  const tabMisSolicitudesBtn = document.getElementById('tab-mis-solicitudes-tab');
                  if (tabMisSolicitudesBtn) {
                    const tab = new bootstrap.Tab(tabMisSolicitudesBtn);
                    tab.show();
                    cargarMisSolicitudesTeletrabajo();
                  }
                } else {
                  mostrarAlerta(data.msg || 'Error al enviar la solicitud', 'warning');
                }
              } catch (err) {
                console.error(err);
                mostrarAlerta('Error de red al enviar solicitud: ' + err.message, 'error');
              } finally {
                if (btnEnviarTeletrabajo) btnEnviarTeletrabajo.disabled = false;
              }
            });
          }

          // Cargar historial de solicitudes de teletrabajo
          async function cargarMisSolicitudesTeletrabajo() {
            const tbody = document.getElementById('tbodyMisSolicitudes');
            if (!tbody) return;

            tbody.innerHTML = `
              <tr>
                <td colspan="5" class="text-center py-3 text-muted">
                  <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                  Cargando tus solicitudes...
                </td>
              </tr>
            `;

            try {
              const res = await fetch('/api/teletrabajo/mis-solicitudes');
              const data = await res.json();

              if (!data.ok || !data.solicitudes || data.solicitudes.length === 0) {
                tbody.innerHTML = `
                  <tr>
                    <td colspan="5" class="text-center py-4 text-muted">
                      <i class="bi bi-inbox fs-4 d-block mb-1 text-secondary"></i>
                      No has realizado ninguna solicitud de teletrabajo aún.
                    </td>
                  </tr>
                `;
                return;
              }

              let html = '';
              data.solicitudes.forEach(s => {
                let badgeEstado = '';
                if (s.estado === 1) {
                  badgeEstado = '<span class="badge-teletrabajo-pendiente"><i class="bi bi-hourglass-split me-1"></i>Pendiente</span>';
                } else if (s.estado === 2) {
                  badgeEstado = '<span class="badge-teletrabajo-aprobado"><i class="bi bi-check-circle-fill me-1"></i>Aprobado</span>';
                } else {
                  badgeEstado = '<span class="badge-teletrabajo-rechazado"><i class="bi bi-x-circle-fill me-1"></i>Rechazado</span>';
                }

                html += `
                  <tr>
                    <td style="color: #0f172a !important;"><strong style="color: #0f172a !important;">${s.fecha_solicitada}</strong></td>
                    <td style="color: #0f172a !important; font-weight: 500;">${s.hora_inicio || '08:00'} - ${s.hora_fin || '17:00'}</td>
                    <td style="color: #0f172a !important; font-weight: 500;">${s.direccion_remota || 'Domicilio'}</td>
                    <td>${badgeEstado}</td>
                    <td style="color: #0f172a !important;">${s.observacion_admin ? '<span class="text-danger fw-semibold">' + s.observacion_admin + '</span>' : '<span style="color: #475569 !important;"><em>Sin observaciones</em></span>'}</td>
                  </tr>
                `;
              });

              tbody.innerHTML = html;
            } catch (err) {
              console.error(err);
              tbody.innerHTML = `
                <tr>
                  <td colspan="5" class="text-center py-3 text-danger">
                    Error al cargar solicitudes.
                  </td>
                </tr>
              `;
            }
          }

          document.getElementById('tab-mis-solicitudes-tab')?.addEventListener('click', cargarMisSolicitudesTeletrabajo);
          document.getElementById('btnRecargarMisSolicitudes')?.addEventListener('click', cargarMisSolicitudesTeletrabajo);

          // Auto-abrir modal de Bitácora si viene con ?abrirBitacora=1 en la URL
          const urlParams = new URLSearchParams(window.location.search);
          if (urlParams.get('abrirBitacora') === '1' || urlParams.get('abrirBitacora') === 'true') {
            const firstReportBtn = document.querySelector('.btn-reporte');
            if (firstReportBtn) {
              setTimeout(() => {
                firstReportBtn.click();
              }, 400);
            }
          }
        });

        // Cronómetro en vivo de Tiempo Transcurrido Hoy
        (function initCronometro() {
          const estadoJornada = '<%= jHoy.estado %>';
          const horaEntradaRaw = '<%= jHoy.hora_entrada_raw || "" %>';
          const fechaRaw = '<%= jHoy.fecha_raw || "" %>';
          const duracionSegundos = parseInt('<%= jHoy.duracion_segundos || 0 %>', 10) || 0;
          const displayEl = document.getElementById('cronometro-display');

          if (!displayEl) return;

          function formatHHMMSS(totalSecs) {
            const secs = Math.max(0, Math.floor(totalSecs));
            const h = String(Math.floor(secs / 3600)).padStart(2, '0');
            const m = String(Math.floor((secs % 3600) / 60)).padStart(2, '0');
            const s = String(secs % 60).padStart(2, '0');
            return `${h}:${m}:${s}`;
          }

          if (estadoJornada === 'EN_CURSO' && fechaRaw && horaEntradaRaw) {
            const timeParts = horaEntradaRaw.split(':');
            const dateParts = fechaRaw.split('-');
            const entradaDate = new Date(
              parseInt(dateParts[0], 10),
              parseInt(dateParts[1], 10) - 1,
              parseInt(dateParts[2], 10),
              parseInt(timeParts[0] || '0', 10),
              parseInt(timeParts[1] || '0', 10),
              parseInt(timeParts[2] || '0', 10)
            );

            function updateTicker() {
              const now = new Date();
              const diffMs = Math.max(0, now.getTime() - entradaDate.getTime());
              displayEl.textContent = formatHHMMSS(diffMs / 1000);
            }

            updateTicker();
            setInterval(updateTicker, 1000);
          } else if (estadoJornada === 'COMPLETADA') {
            displayEl.textContent = formatHHMMSS(duracionSegundos);
          } else {
            displayEl.textContent = '00:00:00';
          }
        })();

        /*
        ===============================================================
        ENVÍO DE SOLICITUD DE HORAS EXTRA (TEMPORALMENTE DESHABILITADO)
        ===============================================================
        document.getElementById('formHorasExtra').addEventListener('submit', async (e) => {
          e.preventDefault();
          const formData = new FormData(e.target);
          const payload = Object.fromEntries(formData.entries());
      
          try {
            const res = await fetch('/api/notificaciones', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
      
            const data = await res.json();
      
            if (data.ok) {
              mostrarAlerta(data.msg, 'success');
              location.reload();
            } else {
              mostrarAlerta(data.msg || 'Error al procesar la solicitud', 'error');
            }
          } catch (err) {
            mostrarAlerta('Error conectando con el servidor.', 'error');
          }
        });
        */
      </script>
      </body>

      </html>
      <%- include('../partials/footer') %>