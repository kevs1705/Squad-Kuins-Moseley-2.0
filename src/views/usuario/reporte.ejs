              const reader = new FileReader();
              reader.onload = (re) => {
                previewImg.src = re.target.result;
                previewContainer.style.display = 'block';
              };
              reader.readAsDataURL(file);
            } else {
              previewContainer.style.display = 'none';
            }
          });

          // Contador de caracteres para informe de horas extras
          const textareaFinHE = document.getElementById('he_fin_tarea');
          const charCounterHE = document.getElementById('charCounterHE');
          if (textareaFinHE && charCounterHE) {
            textareaFinHE.addEventListener('input', () => {
              charCounterHE.textContent = `${textareaFinHE.value.length}/500`;
            });
          }

          btnQuitarFoto?.addEventListener('click', () => {
            if (fileFin) fileFin.value = '';
            if (previewContainer) previewContainer.style.display = 'none';
          });

          // 5. FINALIZAR HORAS EXTRAS (ENVIAR INFORME + FOTO OBLIGATORIA)
          formFinHE?.addEventListener('submit', async (e) => {
            e.preventDefault();

            const tarea = document.getElementById('he_fin_tarea')?.value.trim() || '';
            if (tarea.length < 5) {
              mostrarAlerta('Debes redactar un informe de actividades de al menos 5 caracteres.', 'warning');
              return;
            }

            if (!fileFin?.files || fileFin.files.length === 0) {
              mostrarAlerta('Es obligatorio adjuntar una fotografía o comprobante de evidencia del trabajo realizado.', 'warning');
              return;
            }

            const formData = new FormData(formFinHE);

            try {
              if (btnSubmitFin) {
                btnSubmitFin.disabled = true;
                btnSubmitFin.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Enviando informe...';
              }

              const res = await fetch('/api/horas-extras/finalizar', {
                method: 'POST',
                body: formData
              });

              const data = await res.json();

              if (data.ok) {
                await Swal.fire({
                  icon: 'success',
                  title: '¡Horas Extras Finalizadas!',
                  text: data.msg || 'Tu informe y fotografía fueron enviados con éxito para evaluación del administrador.',
                  confirmButtonColor: '#10b981'
                });
                location.reload();
              } else {
                mostrarAlerta(data.msg || 'Error al finalizar las horas extras', 'error');
              }
            } catch (err) {
              console.error('Error finalizando horas extra:', err);
              mostrarAlerta('Error de red al enviar el reporte', 'error');
            } finally {
              if (btnSubmitFin) {
                btnSubmitFin.disabled = false;
                btnSubmitFin.innerHTML = '<i class="bi bi-send-fill me-1"></i> Finalizar y Enviar a Evaluación';
              }
            }
          });

          // 6. CUENTA REGRESIVA EN VIVO HASTA LAS 12 DE LA NOCHE (00:00)
          function initCountdownMedianoche() {
            const tickerEl = document.getElementById('countdownMedianocheTicker');
            if (!tickerEl) return;

            function update() {
              const now = new Date();
              const midnight = new Date(now);
              midnight.setHours(24, 0, 0, 0);

              const diffMs = midnight - now;
              if (diffMs <= 0) {
                tickerEl.textContent = '00h 00m 00s (Bloqueado)';
                return;
              }

              const totalSec = Math.floor(diffMs / 1000);
              const hrs = Math.floor(totalSec / 3600);
              const mins = Math.floor((totalSec % 3600) / 60);
              const secs = totalSec % 60;

              tickerEl.textContent = `${String(hrs).padStart(2, '0')}h ${String(mins).padStart(2, '0')}m ${String(secs).padStart(2, '0')}s`;
            }

            update();
            setInterval(update, 1000);
          }
          initCountdownMedianoche();

          // 7. ALERTA EMERGENTE AUTOMÁTICA AL ENTRAR A LA PESTAÑA
          const totalPendientes = <%= bitacorasPendientes || 0 %>;
          if (typeof Swal !== 'undefined' && totalPendientes > 0) {
            Swal.fire({
              icon: 'warning',
              title: '⚠️ Aviso de Bitácoras Pendientes',
              html: `
                <div style="font-size: 14px; text-align: left; color: #1e293b; line-height: 1.5;">
                  Tienes <b style="color: #dc2626; font-size: 16px;">${totalPendientes}</b> bitácora(s) o comprobante(s) pendiente(s) de registro.
                  <br><br>
                  <div style="background: #fff5f5; border: 1px solid #fecaca; border-radius: 8px; padding: 12px; font-size: 13px; color: #991b1b;">
                    ⏰ <b>Recuerda:</b> Tienes hasta las <b>12:00 AM (medianoche)</b> para registrar tu bitácora del día.<br>
                    Pasada esa hora, la bitácora quedará <b>bloqueada</b> y las horas se <b>congelarán automáticamente</b> (no sumarán a tus horas disponibles hasta que el administrador las reactive).
                  </div>
                </div>
              `,
              confirmButtonText: 'Entendido, voy a registrar',
              confirmButtonColor: '#0b6bcb'
            });
          }
        })();
      </script>
      </body>

      </html>
      <%- include('../partials/footer') %>