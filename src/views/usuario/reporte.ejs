          // Helper para obtener fecha/hora exacta de Bolivia (La Paz, UTC-4)
          function getBoliviaTime() {
            const now = new Date();
            const horaStr = now.toLocaleTimeString('en-GB', { timeZone: 'America/La_Paz' });
            const fechaStr = now.toLocaleDateString('sv-SE', { timeZone: 'America/La_Paz' });
            const [h, m, s] = (horaStr || '00:00:00').split(':').map(Number);
            const [y, mo, d] = (fechaStr || '2026-01-01').split('-').map(Number);
            return {
              date: new Date(y, mo - 1, d, h, m, s),
              horaStr,
              fechaStr
            };
          }

          // Helper para formatear segundos a HH:MM:SS
          function fmtHMS(sec) {
            const s = Math.max(0, Math.floor(sec));
            const h = Math.floor(s / 3600);
            const m = Math.floor((s % 3600) / 60);
            const secRem = s % 60;
            return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(secRem).padStart(2, '0')}`;
          }

          // 1. Cronómetro activo en tiempo real (Sincronizado con Bolivia)
          if (tickerHE && tickerHE.dataset.inicio) {
            const rawInicio = tickerHE.dataset.inicio; // Formato: YYYY-MM-DDTHH:MM:SS
            const parts = rawInicio.split('T');
            const dateParts = parts[0].split('-');
            const timeParts = (parts[1] || '00:00:00').split(':');

            const inicioDate = new Date(
              parseInt(dateParts[0], 10),
              parseInt(dateParts[1], 10) - 1,
              parseInt(dateParts[2], 10),
              parseInt(timeParts[0] || '0', 10),
              parseInt(timeParts[1] || '0', 10),
              parseInt(timeParts[2] || '0', 10)
            );

            function updateTickerHE() {
              const bolivia = getBoliviaTime();
              const diffSec = Math.max(0, (bolivia.date.getTime() - inicioDate.getTime()) / 1000);
              const formatted = fmtHMS(diffSec);

              tickerHE.textContent = formatted;

              if (modalHoraFinLive) {
                modalHoraFinLive.textContent = bolivia.horaStr;
              }
              if (modalDuracionLive) {
                modalDuracionLive.textContent = formatted;
              }
            }

            updateTickerHE();
            setInterval(updateTickerHE, 1000);
