<%
  pageTitle = 'Reportes (Administrador)';
  pageSubtitle = 'Listado global · Filtro por CI · Exportación';
%>
<%- include('partials/header') %>
<link rel="stylesheet" href="/css/reporte_admin.css">
 
<script>
  document.body.classList.add('reportes-admin-page');
  (() => {
    const header = document.querySelector('.content-header');
    if (header) {
      const h1 = header.querySelector('h1');
      if (h1) h1.childNodes[0].textContent = 'Reportes';
     
      const rightEl = header.querySelector('small.muted') || header.lastElementChild;
      if (rightEl && rightEl !== h1.parentElement) {
        const formattedDate = new Date().toLocaleDateString('es-ES', { day: 'numeric', month: 'numeric', year: 'numeric' });
        rightEl.outerHTML = `
          <div class="header-right">
            <div class="admin-badge">Administrador</div>
            <div class="header-separator"></div>
            <div class="header-date">Actualizado ${formattedDate}</div>
          </div>
        `;
      }
    }
  })();
</script>
 
<!-- KPI Stats Cards -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-icon-wrapper">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
      </svg>
    </div>
    <div class="stat-info">
      <span class="stat-label">Registros encontrados</span>
      <div class="stat-value-row">
        <span class="stat-value" id="stat-records">0</span>
      </div>
    </div>
  </div>
 
  <div class="stat-card">
    <div class="stat-icon-wrapper">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
    </div>
    <div class="stat-info">
      <span class="stat-label">Horas acumuladas</span>
      <div class="stat-value-row">
        <span class="stat-value" id="stat-hours">00:00:00</span>
        <span class="stat-badge">hh:mm:ss</span>
      </div>
    </div>
  </div>
 
  <div class="stat-card">
    <div class="stat-icon-wrapper">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
      </svg>
    </div>
  
  </div>
</div>
 
<!-- Filters Card -->
<div class="filters-card">
  <form id="filtro-form">
    <div class="filters-form-row">
      <div class="filter-group flex-grow-2">
        <label for="ci">Filtrar por CI:</label>
        <div class="input-icon-wrap">
          <input id="ci" name="ci" type="text" placeholder="Ej.: 7099111" value="<%= filtroCI %>">
        </div>
      </div>
     
      <div class="filter-group flex-grow-1">
        <label for="page-size">Filas por página:</label>
        <select id="page-size" class="select">
          <option value="10" selected>10</option>
          <option value="25">25</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>
      </div>
 
      <div class="filter-buttons">
        <button class="btn btn-primary btn-search" type="submit">Buscar</button>
        <button class="btn btn-outline-primary btn-clear" id="btn-limpiar" type="button">Limpiar</button>
        <button class="btn btn-primary btn-export" id="btn-exportar" type="button">Exportar</button>
      </div>
    </div>
   
    <div class="filters-bottom-row">
      <a href="/graficos" class="btn btn-secondary btn-chart" style="text-decoration: none;">Gráficos</a>
      <a href="/notificaciones_admin" class="btn btn-secondary btn-bell" style="text-decoration: none;">Notificaciones</a>
    </div>
  </form>
</div>
 
<!-- Panel de Filtros -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body">
        <form id="formFiltros" class="row g-3 align-items-end">
          <div class="col-md-3">
            <label class="form-label fw-semibold">Cédula de Identidad (CI)</label>
            <input type="text" id="filterCI" class="form-control" placeholder="Buscar por CI...">
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold">Usuario</label>
            <select id="filterUsuario" class="form-select">
              <option value="">-- Todos los Usuarios --</option>
              <% usuarios.forEach(u => { %>
                <option value="<%= u.id_usuario %>"><%= u.nombre %> (<%= u.CI %>)</option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold">Fecha</label>
            <input type="date" id="filterFecha" class="form-control">
          </div>
          <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100 fw-semibold">
              <i class="bi bi-search me-1"></i> Filtrar
            </button>
            <button type="button" id="btnLimpiar" class="btn btn-outline-secondary w-100">
              Limpiar
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Tabla Principal de Asistencias y Bitácoras -->
    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
              <tr>
                <th>Usuario</th>
                <th>CI</th>
                <th>Fecha</th>
                <th>Lugar / Obra</th>
                <th>Marcaciones</th>
                <th>Horas</th>
                <th>Bitácora / Avance</th>
                <th>Comprobante</th>
                <th>Observación Admin</th>
                <th class="text-center">Acción</th>
              </tr>
            </thead>
            <tbody id="tablaReportes">
              <!-- Se puebla mediante AJAX -->
            </tbody>
          </table>
        </div>
      </div>
      
      <!-- Paginación -->
      <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
        <span class="text-muted" id="infoPaginacion">Mostrando 0 de 0 registros</span>
        <nav>
          <ul class="pagination mb-0" id="paginador"></ul>
        </nav>
      </div>
    </div>
  </div>

  <!-- MODAL: EDITAR OBSERVACIÓN -->
  <div class="modal fade" id="modalObs" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <form id="formObs">
          <div class="modal-header">
            <h5 class="modal-title fw-bold">Añadir / Modificar Observación</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <input type="hidden" id="obs_id_asistencia">
            <div class="mb-3">
              <label class="form-label fw-semibold">Observaciones del Administrador</label>
              <textarea class="form-control" id="obs_texto" rows="4" placeholder="Ingresa justificativos, observaciones o correcciones de la jornada..."></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-primary">Guardar Observación</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    let currentPage = 1;
    const modalObs = new bootstrap.Modal(document.getElementById('modalObs'));

    // Cargar reporte dinámico desde el endpoint API
    async function fetchReportes(page = 1) {
      currentPage = page;
      const ci = document.getElementById('filterCI').value;
      const id_usuario = document.getElementById('filterUsuario').value;
      const fecha = document.getElementById('filterFecha').value;

      const params = new URLSearchParams({ page, size: 25, ci, id_usuario, fecha });

      try {
        const res = await fetch(`/api/admin/reportes?${params}`);
        const data = await res.json();

        if (!data.ok) throw new Error(data.error);

        renderTabla(data.data);
        renderPaginador(data.page, data.totalPages, data.total);
      } catch (err) {
        console.error(err);
        Swal.fire('Error', 'No se pudieron cargar los registros de asistencias.', 'error');
      }
    }

    function renderTabla(lista) {
      const tbody = document.getElementById('tablaReportes');
      tbody.innerHTML = '';

      if (lista.length === 0) {
        tbody.innerHTML = `<tr><td colspan="10" class="text-center py-4 text-muted">No se encontraron registros coincidentes.</td></tr>`;
        return;
      }

      lista.forEach(item => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><strong>${item.usuario_nombre}</strong></td>
          <td>${item.usuario_ci}</td>
          <td>${item.fecha}</td>
          <td>${item.lugar_nombre || 'N/A'} <br><small class="text-muted">(${item.lugar_tipo || 'GEOFENCE'})</small></td>
          <td>
            <small class="d-block"><strong>E:</strong> ${item.hora_entrada || '-'}</small>
            <small class="d-block"><strong>S:</strong> ${item.hora_salida || '-'}</small>
          </td>
          <td>
            <span class="badge ${item.horas_dia === 'En curso' ? 'bg-warning text-dark' : 'bg-secondary'}">
              ${item.horas_dia}
            </span>
          </td>
          <td>
            <div style="max-width: 250px;" class="text-truncate" title="${item.tarea || ''}">
              ${item.tarea ? item.tarea : '<em class="text-muted">Sin bitácora registrada</em>'}
            </div>
          </td>
          <td>
            ${item.comprobante ? `<a href="${item.comprobante}" target="_blank" class="btn btn-sm btn-outline-info"><i class="bi bi-image"></i> Ver</a>` : '-'}
          </td>
          <td>
            <small class="${item.observacion ? 'text-danger fw-bold' : 'text-muted'}">
              ${item.observacion || 'Sin observaciones'}
            </small>
          </td>
          <td class="text-center">
            <button class="btn btn-sm btn-outline-primary" onclick="abrirModalObs(${item.id_asistencia}, '${item.observacion || ''}')">
              <i class="bi bi-pencil-square"></i> Obs
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function renderPaginador(page, totalPages, total) {
      document.getElementById('infoPaginacion').textContent = `Página ${page} de ${totalPages} (Total: ${total} registros)`;
      const paginador = document.getElementById('paginador');
      paginador.innerHTML = '';

      for (let i = 1; i <= totalPages; i++) {
        const li = document.createElement('li');
        li.className = `page-item ${i === page ? 'active' : ''}`;
        li.innerHTML = `<a class="page-link" href="#" onclick="fetchReportes(${i})">${i}</a>`;
        paginador.appendChild(li);
      }
    }

    function abrirModalObs(idAsistencia, obsActual) {
      document.getElementById('obs_id_asistencia').value = idAsistencia;
      document.getElementById('obs_texto').value = obsActual;
      modalObs.show();
    }

    // Guardar Observación
    document.getElementById('formObs').addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = document.getElementById('obs_id_asistencia').value;
      const observacion = document.getElementById('obs_texto').value;

      try {
        const res = await fetch(`/api/admin/reportes/${id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ observacion })
        });
        const data = await res.json();

        if (data.ok) {
          modalObs.hide();
          Swal.fire({ icon: 'success', title: 'Guardado', text: 'Observación actualizada', timer: 1500, showConfirmButton: false });
          fetchReportes(currentPage);
        } else {
          Swal.fire('Error', data.msg || 'No se pudo guardar', 'error');
        }
      } catch (err) {
        Swal.fire('Error', 'Error conectando al servidor', 'error');
      }
    });

    // Filtros
    document.getElementById('formFiltros').addEventListener('submit', (e) => {
      e.preventDefault();
      fetchReportes(1);
    });

    document.getElementById('btnLimpiar').addEventListener('click', () => {
      document.getElementById('formFiltros').reset();
      fetchReportes(1);
    });

    // Exportar Excel manteniendo los filtros aplicados
    document.getElementById('btnExportar').addEventListener('click', () => {
      const ci = document.getElementById('filterCI').value;
      const fecha = document.getElementById('filterFecha').value;
      const params = new URLSearchParams({ ci, fecha });
      window.location.href = `/admin/reportes/export?${params}`;
    });

    // Carga Inicial
    fetchReportes(1);
  </script>
</body>
</html>
<%- include('partials/footer') %>