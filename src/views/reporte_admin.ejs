<% pageTitle='Reportes (Administrador)' ; pageSubtitle='Listado global · Control de Asistencias y Horas' ;
  %>
  <%- include('partials/header') %>
    <link rel="stylesheet" href="/css/reporte_admin.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/es.js"></script>

    <script>
      document.body.classList.add('reportes-admin-page');
      (() => {
        const header = document.querySelector('.content-header');
        if (header) {
          const h1 = header.querySelector('h1');
          if (h1) h1.childNodes[0].textContent = 'Reportes';

          const rightEl = header.querySelector('small.muted') || header.lastElementChild;
          if (rightEl && rightEl !== h1.parentElement) {
            const formattedDate = new Date().toLocaleDateString('es-ES', { day: 'numeric', month: 'numeric', year: 'numeric' });
            rightEl.outerHTML = `
          <div class="header-right">
            <div class="admin-badge">Administrador</div>
            <div class="header-separator"></div>
            <div class="header-date">Actualizado ${formattedDate}</div>
          </div>
        `;
          }
        }
      })();
    </script>

    <!-- Dashboard Top: Columna Izquierda (Cards dinámicas con usuario primero) + Columna Derecha (Panel de Estadísticas con Doble Pestaña) -->
    <div class="reportes-dashboard-top">
      <!-- Columna Izquierda: Tarjetas de Información -->
      <div class="kpi-column-left">
        <!-- Card 1: Usuario Seleccionado (PRIMERO) -->
        <div class="stat-card stat-card-user" id="cardUserContainer">
          <div class="stat-icon-wrapper" id="stat-user-avatar-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
          </div>
          <div class="stat-info" style="flex: 1; min-width: 0;">
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px;">
              <span class="stat-label">Usuario Seleccionado</span>
              <button type="button" class="btn-card-calendar" id="btnVerCalendarioUsuario" style="display: none;" title="Visualizar calendario de asistencias y actividades de este usuario">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <span>Calendario</span>
              </button>
            </div>
            <div class="stat-value-row">
              <span class="stat-value" id="stat-user" title="Todos los usuarios">Todos los usuarios</span>
            </div>
            <div id="stat-user-sub-details" style="font-size: 12px; color: var(--color-text-muted); display: none; margin-top: 2px;">
              <!-- Carrera y Universidad dinámicas -->
            </div>
            <div style="margin-top: 4px;">
              <span class="stat-badge" id="stat-user-badge">Global</span>
            </div>
          </div>
        </div>

        <!-- Card 2: Horas Acumuladas (Visible solo al consultar usuario individual) -->
        <div class="stat-card" id="cardHorasAcumuladas" style="display: none;">
          <div class="stat-icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
          </div>
          <div class="stat-info">
            <span class="stat-label">Horas acumuladas</span>
            <div class="stat-value-row">
              <span class="stat-value" id="stat-hours">00:00:00</span>
              <span class="stat-badge">HH:MM:SS</span>
            </div>
            <span class="stat-subtext" id="stat-hours-decimal" style="font-size: 11.5px; color: var(--color-text-muted); font-weight: 500;">0.0 horas acumuladas</span>
          </div>
        </div>

        <!-- Card 3: Total Registros / Jornadas -->
        <div class="stat-card">
          <div class="stat-icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
          </div>
          <div class="stat-info">
            <span class="stat-label">Registros encontrados</span>
            <div class="stat-value-row">
              <span class="stat-value" id="stat-records">0</span>
              <span class="stat-badge" id="stat-records-badge">Jornadas</span>
            </div>
            <span class="stat-subtext" style="font-size: 11.5px; color: var(--color-text-muted); font-weight: 500;">Asistencias en el filtro</span>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Panel de Estadísticas Dinámico con Doble Pestaña -->
      <div class="stats-panel-right">
        <div class="stats-panel-card">
          <div class="stats-panel-header">
            <div class="stats-panel-title-wrap">
              <div class="stats-panel-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
              </div>
              <div>
                <h3 class="stats-panel-title" id="statsPanelTitle">Análisis y Estadísticas</h3>
                <p class="stats-panel-subtitle" id="statsPanelSubtitle">Horas por semanas, días y rendimiento</p>
              </div>
            </div>

            <!-- Navegación de Doble Pestaña -->
            <div class="stats-tabs-nav">
              <button type="button" class="stats-tab-btn active" id="tabBtnGraficos" onclick="cambiarPestanaStats('graficos')">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                Gráficos (Semanas/Días)
              </button>
              <button type="button" class="stats-tab-btn" id="tabBtnRanking" onclick="cambiarPestanaStats('ranking')">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.45 1-1 1H7c-.55 0-1-.45-1-1v-2.34c0-.55.45-1 1-1h2c.55 0 1 .45 1 1z"/><path d="M18 14.66V17c0 .55-.45 1-1 1h-2c-.55 0-1-.45-1-1v-2.34c0-.55.45-1 1-1h2c.55 0 1 .45 1 1z"/><path d="M14 9.66V17c0 .55-.45 1-1 1h-2c-.55 0-1-.45-1-1V9.66c0-.55.45-1 1-1h2c.55 0 1 .45 1 1z"/></svg>
                <span id="tabTitleRanking">Ranking & Resumen</span>
              </button>
            </div>
          </div>

          <!-- Pestaña 1: Gráficos de Semanas / Días -->
          <div class="stats-tab-pane active" id="paneGraficos">
            <div class="chart-controls-bar">
              <div class="chart-type-toggle">
                <button type="button" class="btn-chart-toggle active" id="btnChartSemanal" onclick="cambiarModoGrafico('semanal')">
                  📅 Por Semanas
                </button>
                <button type="button" class="btn-chart-toggle" id="btnChartDiario" onclick="cambiarModoGrafico('diario')">
                  📆 Por Día (Lun - Dom)
                </button>
              </div>
              <div class="chart-summary-badge" id="chartSummaryBadge">
                <!-- Resumen de horas -->
              </div>
            </div>

            <div class="chart-container-wrap" style="position: relative; height: 185px; width: 100%;">
              <canvas id="statsChartCanvas"></canvas>
            </div>
          </div>

          <!-- Pestaña 2: Ranking o Desglose del Usuario -->
          <div class="stats-tab-pane" id="paneRanking">
            <div class="stats-panel-body" id="statsPanelBody">
              <!-- Renderizado dinámicamente vía JavaScript -->
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Barra de Acciones Superior Encima de Filtros con Nuevos Colores -->
    <div class="reportes-actions-top-bar">
      <div class="actions-left-info">
        <span class="actions-section-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-primary);"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
          Filtros de Asistencias y Horas
        </span>
        <span class="actions-section-sub">Filtra por usuario, carrera o fechas dinámicas</span>
      </div>
      <div class="actions-right-buttons">
        <a href="/graficos" class="btn-top-action btn-top-graficos" title="Ver gráficos estadísticos generales">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
          Gráficos Estadísticos
        </a>
        <a href="/notificaciones_admin" class="btn-top-action btn-top-notif" title="Gestionar avisos y notificaciones a pasantes">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          Gestión de Notificaciones
        </a>
        <button type="button" class="btn-top-action btn-top-export" id="btn-exportar" title="Descargar registros filtrados a Excel">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Exportar a Excel
        </button>
      </div>
    </div>

    <!-- Filters Card -->
    <div class="filters-card">
      <form id="filtro-form" onsubmit="return false;">
        <!-- Fila 1: Búsqueda de Usuario Ampliada -->
        <div class="filters-form-row filters-row-top">
          <div class="filter-group flex-user-full">
            <label for="userAutocompleteInput">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="margin-right: 4px; vertical-align: -2px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              Buscar Usuario (Nombre o Apellido):
            </label>
            <div class="autocomplete-container">
              <div class="autocomplete-input-wrap input-icon-wrap icon-user">
                <input id="userAutocompleteInput" type="text" placeholder="Escribe el nombre o apellido del usuario (Enter para filtrar)..."
                  autocomplete="off">
                <button type="button" class="autocomplete-clear-btn" id="btnClearUser"
                  title="Limpiar usuario seleccionado">&times;</button>
              </div>
              <!-- Dropdown con sugerencias de autocompletado -->
              <div class="autocomplete-dropdown" id="userAutocompleteDropdown"></div>
            </div>
            <!-- Input oculto para el id del usuario seleccionado -->
            <input type="hidden" id="filterUsuario" name="id_usuario" value="">
          </div>
        </div>

        <!-- Fila 2: Filtros Complementarios + Botón Limpiar -->
        <div class="filters-form-row filters-row-bottom">
          <!-- Filtro por Carrera -->
          <div class="filter-group flex-sub-item">
            <label for="filterCarrera">Carrera:</label>
            <div class="select-icon-wrap">
              <select id="filterCarrera" name="id_carrera" class="filter-select-custom">
                <option value="">Todas las carreras</option>
                <% (carreras || []).forEach(function(c) { %>
                  <option value="<%= c.id_carrera %>"><%= c.nombre %><%= c.siglas ? ' (' + c.siglas + ')' : '' %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <!-- Filtro por Lugar / Obra -->
          <div class="filter-group flex-sub-item">
            <label for="filterLugar">Lugar / Obra:</label>
            <div class="select-icon-wrap">
              <select id="filterLugar" name="id_lugar" class="filter-select-custom">
                <option value="">Todas las obras</option>
                <% (lugares || []).forEach(function(l) { %>
                  <option value="<%= l.id_lugar %>"><%= l.nombre %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <!-- Filtro por Estado -->
          <div class="filter-group flex-sub-item">
            <label for="filterEstadoDuracion">Estado:</label>
            <div class="select-icon-wrap">
              <select id="filterEstadoDuracion" name="estado_duracion" class="filter-select-custom">
                <option value="">Todos los estados</option>
                <option value="FINALIZADO">Finalizadas</option>
                <option value="EN_CURSO">En curso</option>
                <option value="OBSERVADO">Observaciones</option>
              </select>
            </div>
          </div>

          <!-- Filtro por Calendario Dinámico -->
          <div class="filter-group flex-sub-item">
            <label for="filterFechasInput">Fecha(s):</label>
            <div class="calendar-picker-wrapper">
              <div class="input-icon-wrap icon-calendar">
                <input id="filterFechasInput" name="fechas" type="text" placeholder="Seleccionar fecha(s)..." readonly>
              </div>
              <button type="button" class="calendar-clear-btn" id="btnClearFechas" title="Limpiar fechas seleccionadas" style="display: none;">&times;</button>
            </div>
          </div>

          <!-- Botón Limpiar Filtros Reacomodado con nuevo color -->
          <div class="filter-buttons-right">
            <button class="btn-outline-clean" id="btn-limpiar" type="button" title="Restablecer todos los filtros">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 5px;"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
              Limpiar Filtros
            </button>
          </div>
        </div>
      </form>
    </div>

    <!-- Tabla Principal de Asistencias y Bitácoras -->
    <div class="reports-table-card">
      <div class="table-card-top-bar">
        <div class="table-card-title-wrap">
          <span class="table-card-title">Listado de Asistencias</span>
          <span class="table-card-badge" id="tableRecordsBadge">0 registros</span>
        </div>
      </div>

      <div class="table-wrap">
        <table class="table">
          <thead id="tablaHeader">
            <!-- Renderizado dinámicamente -->
          </thead>
          <tbody id="tablaReportes">
            <!-- Poblado dinámicamente mediante fetch -->
          </tbody>
        </table>
      </div>

      <!-- Pie de tabla y Paginación -->
      <div class="table-footer">
        <span class="table-footer-info" id="infoPaginacion">Mostrando 0 de 0 registros</span>
        <div class="pagination-wrap" id="paginador">
          <!-- Generado dinámicamente -->
        </div>
      </div>
    </div>

    <!-- MODAL 1: DETALLE DE JORNADA (BITÁCORA, COMPROBANTE Y OBSERVACIÓN) -->
    <div class="modal-backdrop" id="modalDetalleBackdrop">
      <div class="modal" id="modalDetalle" style="max-width: 680px; max-height: 90vh; overflow-y: auto;">
        <div class="modal-header-custom">
          <div>
            <div class="modal-badge-tag" style="background: #E0F2FE; color: #0369A1;">Detalle de Registro</div>
            <h3 id="det_usuario_nombre" style="margin: 4px 0 2px 0;">Nombre del Pasante</h3>
            <p id="det_sub_info" style="margin: 0; font-size: 13px; color: var(--color-text-muted);">CI: 0000000 ·
              Fecha: 2026-00-00</p>
          </div>
          <button type="button" class="modal-close-btn" id="btnXCerrarDetalle">&times;</button>
        </div>

        <!-- Ficha de Datos Resumidos de la Jornada -->
        <div class="detalle-summary-grid">
          <div class="detalle-summary-item">
            <span class="detalle-summary-label">Lugar / Obra</span>
            <span class="detalle-summary-value" id="det_lugar_nombre">-</span>
          </div>
          <div class="detalle-summary-item">
            <span class="detalle-summary-label">Hora Llegada (Entrada)</span>
            <span class="detalle-summary-value text-primary" id="det_hora_entrada">-</span>
          </div>
          <div class="detalle-summary-item">
            <span class="detalle-summary-label">Hora Salida</span>
            <span class="detalle-summary-value text-teal" id="det_hora_salida">-</span>
          </div>
          <div class="detalle-summary-item">
            <span class="detalle-summary-label">Duración Total</span>
            <span class="detalle-summary-value" id="det_duracion">-</span>
          </div>
        </div>

        <!-- Sección de Bitácora / Tarea -->
        <div class="detalle-section">
          <div class="detalle-section-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <polyline points="14 2 14 8 20 8" />
              <line x1="16" y1="13" x2="8" y2="13" />
              <line x1="16" y1="17" x2="8" y2="17" />
              <polyline points="10 9 9 9 8 9" />
            </svg>
            Bitácora de Actividades / Tarea
          </div>
          <div class="detalle-content-box" id="det_tarea_box">
            Sin bitácora registrada para esta jornada.
          </div>
        </div>

        <!-- Sección de Comprobante Fotográfico -->
        <div class="detalle-section">
          <div class="detalle-section-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
              <circle cx="8.5" cy="8.5" r="1.5" />
              <polyline points="21 15 16 10 5 21" />
            </svg>
            Comprobante de Asistencia
          </div>
          <div id="det_comprobante_container" class="detalle-comprobante-wrapper">
            <!-- Renderizado dinámicamente -->
          </div>
        </div>

        <!-- Sección de Observación del Administrador -->
        <div class="detalle-section">
          <div class="detalle-section-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="8" x2="12" y2="12" />
              <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            Observación del Administrador
          </div>
          <div class="detalle-content-box obs-box" id="det_obs_box">
            Sin observaciones registradas.
          </div>
        </div>

        <div class="modal-actions" style="margin-top: 20px;">
          <button type="button" class="btn btn-secondary" id="btnCerrarDetalle">Cerrar</button>
          <button type="button" class="btn btn-primary" id="btnEditarDesdeDetalle">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
              style="margin-right: 4px;">
              <path d="M12 20h9" />
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
            </svg>
            Editar Horas / Observación
          </button>
        </div>
      </div>
    </div>

    <!-- MODAL 2: HORARIO PROGRAMADO DEL USUARIO -->
    <div class="modal-backdrop" id="modalHorarioBackdrop">
      <div class="modal" id="modalHorario" style="max-width: 620px; max-height: 90vh; overflow-y: auto;">
        <div class="modal-header-custom">
          <div>
            <div class="modal-badge-tag" style="background: #EEF2FF; color: #4338CA;">Horario Semanal</div>
            <h3 id="horario_usuario_nombre" style="margin: 4px 0 2px 0;">Horario del Pasante</h3>
            <p id="horario_usuario_sub" style="margin: 0; font-size: 13px; color: var(--color-text-muted);">Consultando
              horario...</p>
          </div>
          <button type="button" class="modal-close-btn" id="btnXCerrarHorario">&times;</button>
        </div>

        <div id="horario_body_content" style="margin-top: 16px;">
          <!-- Tabla de horarios generada vía JavaScript -->
        </div>

        <div class="modal-actions" style="margin-top: 20px;">
          <button type="button" class="btn btn-secondary" id="btnCerrarHorario">Cerrar</button>
        </div>
      </div>
    </div>

    <!-- MODAL 3: EDITAR HORAS Y OBSERVACIÓN -->
    <div class="modal-backdrop" id="modalObsBackdrop">
      <div class="modal" id="modalObs">
        <div class="modal-header-custom">
          <div>
            <div class="modal-badge-tag" style="background: #FEF3C7; color: #B45309;">Ajuste Administrativo</div>
            <h3 style="margin: 4px 0 2px 0;">Editar Registro de Jornada</h3>
            <p id="modalSubInfo" style="margin: 0; font-size: 13px; color: var(--color-text-muted);">Ajustar marcaciones
              de horas y observaciones</p>
          </div>
          <button type="button" class="modal-close-btn" id="btnXModal">&times;</button>
        </div>
        <form id="formObs" style="margin-top: 16px;">
          <input type="hidden" id="obs_id_asistencia">
          <div class="form-grid" style="grid-template-columns: 1fr 1fr; margin-bottom: 16px;">
            <label>
              Hora Entrada:
              <input type="time" id="edit_hora_entrada" name="hora_entrada" required>
            </label>
            <label>
              Hora Salida:
              <input type="time" id="edit_hora_salida" name="hora_salida">
            </label>
          </div>
          <div class="form-grid" style="grid-template-columns: 1fr;">
            <label>
              Observaciones del Administrador:
              <textarea id="obs_texto" rows="3"
                placeholder="Ingresa justificativos, observaciones o correcciones de la jornada..."></textarea>
            </label>
          </div>
          <div class="modal-actions" style="margin-top: 20px;">
            <button type="button" class="btn btn-secondary" id="btnCerrarModal">Cancelar</button>
            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
          </div>
        </form>
      </div>
    </div>

    <!-- MODAL 4: CALENDARIO DE ASISTENCIAS Y ACTIVIDADES DEL USUARIO -->
    <div class="modal-backdrop" id="modalCalendarioBackdrop">
      <div class="modal" id="modalCalendario" style="max-width: 880px; max-height: 92vh; overflow-y: auto;">
        <div class="modal-header-custom">
          <div>
            <div class="modal-badge-tag" style="background: #EFF6FF; color: #1D4ED8;">Calendario de Actividades</div>
            <h3 id="cal_usuario_nombre" style="margin: 4px 0 2px 0;">Calendario del Usuario</h3>
            <p id="cal_usuario_sub" style="margin: 0; font-size: 13px; color: var(--color-text-muted);">Consultando asistencias...</p>
          </div>
          <button type="button" class="modal-close-btn" id="btnXCerrarCalendario">&times;</button>
        </div>

        <div class="calendar-modal-body" id="calModalBody">
          <!-- Resumen de Horarios Asignados / Programados del Usuario -->
          <div class="calendar-user-schedule-bar" id="calUserScheduleBar">
            <span class="cal-sched-title">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              Horario Programado Registrado:
            </span>
            <div class="cal-sched-days-wrap" id="calSchedDaysList">
              <!-- Días programados (Lun: 08:00-12:00, etc.) -->
            </div>
          </div>

          <!-- Barra de Navegación Semanal y Resumen -->
          <div class="calendar-nav-bar">
            <div class="calendar-nav-controls">
              <button type="button" class="btn-cal-nav" id="btnCalPrevWeek" title="Semana anterior">&lsaquo;</button>
              <span class="calendar-current-month" id="calCurrentWeekLabel">Semana del --/-- al --/--</span>
              <button type="button" class="btn-cal-nav" id="btnCalNextWeek" title="Semana siguiente">&rsaquo;</button>
              <button type="button" class="btn-cal-today" id="btnCalThisWeek">Semana Actual</button>
            </div>
            <div class="calendar-kpis-wrap">
              <span class="cal-kpi-pill kpi-dias"><b id="calKpiTotalDiasSemana">0</b> días asistidos</span>
              <span class="cal-kpi-pill kpi-horas"><b id="calKpiTotalHorasSemana">00:00</b> en la semana</span>
            </div>
          </div>

          <!-- Malla de Línea de Tiempo Semanal (Horas de 06:00 a 20:00) -->
          <div class="weekly-timeline-container">
            <!-- Encabezado de Días con Fechas -->
            <div class="weekly-header-days" id="calWeeklyHeaderDays">
              <div class="weekly-time-col-header">Hora</div>
              <!-- Columnas de Lunes a Domingo generadas dinámicamente -->
            </div>

            <!-- Grilla con Eje de Horas y Columnas -->
            <div class="weekly-body-grid" id="calWeeklyBodyGrid">
              <!-- Eje de Horas Vertical -->
              <div class="weekly-time-axis" id="calWeeklyTimeAxis">
                <!-- Horas 06:00 a 20:00 -->
              </div>
              <!-- Columnas de los 7 Días -->
              <div class="weekly-days-columns" id="calWeeklyDaysColumns">
                <!-- 7 columnas con bloques programados y asistencias reales -->
              </div>
            </div>
          </div>

          <!-- Panel de Detalle del Día Seleccionado -->
          <div class="calendar-day-detail-card" id="calDayDetailCard" style="display: none;">
            <div class="cal-detail-header">
              <div class="cal-detail-title-wrap">
                <span class="cal-detail-badge" id="calDetailDateBadge">2026-09-01</span>
                <span class="cal-detail-lugar" id="calDetailLugar">Lugar / Obra</span>
              </div>
              <span class="cal-detail-status" id="calDetailStatus">Finalizado</span>
            </div>
            
            <div class="cal-detail-sched-info" id="calDetailSchedInfo">
              <span class="cal-detail-sched-label">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Horario Programado para este día:
              </span>
              <span class="cal-detail-sched-val" id="calDetailHorarioProgTxt">08:00 - 12:00</span>
            </div>

            <div class="cal-detail-grid">
              <div><b>Entrada Real:</b> <span id="calDetailEntrada">-</span></div>
              <div><b>Salida Real:</b> <span id="calDetailSalida">-</span></div>
              <div><b>Duración:</b> <span id="calDetailDuracion">-</span></div>
            </div>
            <div class="cal-detail-tarea-wrap" id="calDetailTareaWrap">
              <b>Actividad / Bitácora:</b>
              <p id="calDetailTarea">Sin bitácora registrada.</p>
            </div>
            <div class="cal-detail-obs-wrap" id="calDetailObsWrap" style="display: none;">
              <b>Observación:</b>
              <p id="calDetailObs" style="color: #DC2626;"></p>
            </div>
          </div>
        </div>

        <div class="modal-actions" style="margin-top: 16px;">
          <button type="button" class="btn btn-secondary" id="btnCerrarCalendario">Cerrar</button>
        </div>
      </div>
    </div>

    <script id="data-usuarios" type="application/json"><%- JSON.stringify(usuarios || []) %></script>
    <script id="data-lugares" type="application/json"><%- JSON.stringify(lugares || []) %></script>
    <script>
      // Listas inyectadas desde el backend
      const listaUsuarios = JSON.parse(document.getElementById('data-usuarios')?.textContent || '[]');
      const listaLugares = JSON.parse(document.getElementById('data-lugares')?.textContent || '[]');
      let currentPage = 1;
      const pageSize = 25; // Tamaño fijo de página

      // Elementos de autocompletado
      const autoInput = document.getElementById('userAutocompleteInput');
      const autoDropdown = document.getElementById('userAutocompleteDropdown');
      const hiddenUserId = document.getElementById('filterUsuario');
      const btnClearUser = document.getElementById('btnClearUser');

      // Helper para iniciales de usuario
      function getInitials(name) {
        if (!name) return 'U';
        const parts = name.trim().split(/\s+/);
        if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
        return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
      }

      // Helper para formatear segundos a HH:MM
      function formatSecondsToHHMM(seconds) {
        if (!seconds || isNaN(seconds) || seconds <= 0) return '00:00';
        const totalMinutes = Math.floor(seconds / 60);
        const hours = Math.floor(totalMinutes / 60);
        const minutes = totalMinutes % 60;
        return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;
      }

      // Helper para formatear segundos a HH:MM:SS
      function formatSecondsToHHMMSS(seconds) {
        if (!seconds || isNaN(seconds) || seconds <= 0) return '00:00:00';
        const h = Math.floor(seconds / 3600);
        const m = Math.floor((seconds % 3600) / 60);
        const s = Math.floor(seconds % 60);
        return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
      }

      // Renderizar dropdown de autocompletado
      function renderAutocomplete(query = '') {
        const q = query.trim().toLowerCase();
        autoDropdown.innerHTML = '';

        let filtrados = listaUsuarios;
        if (q) {
          filtrados = listaUsuarios.filter(u => {
            const nom = (u.nombre || '').toLowerCase();
            const ci = String(u.CI || '').toLowerCase();
            return nom.includes(q) || ci.includes(q);
          });
        }

        if (filtrados.length === 0) {
          autoDropdown.innerHTML = `
        <div class="autocomplete-empty">
          No se encontraron usuarios coincidentes con "<strong>${escapeHTML(query)}</strong>"
        </div>
      `;
          autoDropdown.classList.add('show');
          return;
        }

        // Opción para resetear a "Todos los usuarios" si hay algo escrito o seleccionado
        if (hiddenUserId.value || q) {
          const allItem = document.createElement('div');
          allItem.className = 'autocomplete-item';
          allItem.innerHTML = `
        <div class="user-avatar-initials" style="background:#F1F5F9; color:#475569;">★</div>
        <div class="user-item-info">
          <span class="user-item-name">-- Todos los Usuarios --</span>
          <span class="user-item-sub">Ver registros globales de todo el equipo</span>
        </div>
      `;
          allItem.addEventListener('click', () => {
            seleccionarUsuario(null);
            autoDropdown.classList.remove('show');
            fetchReportes(1);
          });
          autoDropdown.appendChild(allItem);
        }

        filtrados.forEach(u => {
          const item = document.createElement('div');
          item.className = `autocomplete-item ${hiddenUserId.value == u.id_usuario ? 'selected' : ''}`;

          let nombreHTML = escapeHTML(u.nombre);
          if (q) {
            const regex = new RegExp(`(${q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
            nombreHTML = nombreHTML.replace(regex, '<span class="autocomplete-highlight">$1</span>');
          }

          const carreraText = u.carrera ? ` · ${escapeHTML(u.carrera)}` : '';
          const uniText = u.universidad ? ` (${escapeHTML(u.universidad)})` : '';

          item.innerHTML = `
        <div class="user-avatar-initials">${getInitials(u.nombre)}</div>
        <div class="user-item-info">
          <span class="user-item-name">${nombreHTML}</span>
          <span class="user-item-sub">
            <span class="user-item-badge">CI: ${escapeHTML(u.CI)}</span>
            <span>${carreraText}${uniText}</span>
          </span>
        </div>
      `;

          item.addEventListener('click', () => {
            seleccionarUsuario(u);
            autoDropdown.classList.remove('show');
            fetchReportes(1);
          });

          autoDropdown.appendChild(item);
        });

        autoDropdown.classList.add('show');
      }

      function seleccionarUsuario(u) {
        if (u) {
          hiddenUserId.value = u.id_usuario;
          autoInput.value = `${u.nombre} (${u.CI})`;
          btnClearUser.style.display = 'flex';
        } else {
          hiddenUserId.value = '';
          autoInput.value = '';
          btnClearUser.style.display = 'none';
        }
      }

      // Eventos de Autocompletado
      autoInput.addEventListener('focus', () => {
        renderAutocomplete(autoInput.value);
      });

      autoInput.addEventListener('input', (e) => {
        hiddenUserId.value = ''; // Si escribe, resetea la selección fija por ID
        btnClearUser.style.display = autoInput.value ? 'flex' : 'none';
        renderAutocomplete(autoInput.value);
      });

      // Presionar Enter en el input de autocompletado para buscar directamente
      autoInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          autoDropdown.classList.remove('show');
          fetchReportes(1);
        }
      });

      btnClearUser.addEventListener('click', () => {
        seleccionarUsuario(null);
        autoDropdown.classList.remove('show');
        fetchReportes(1);
      });

      // Cerrar dropdown al hacer clic fuera
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.autocomplete-container')) {
          autoDropdown.classList.remove('show');
        }
      });

      // =========================================================================
      // 1. MODAL DE EDICIÓN DE JORNADA (HORAS Y OBSERVACIÓN)
      // =========================================================================
      const modalBackdrop = document.getElementById('modalObsBackdrop');

      function abrirModalEditar(idAsistencia, horaEntrada, horaSalida, obsActual, usuarioNombre, fecha) {
        document.getElementById('obs_id_asistencia').value = idAsistencia;
        document.getElementById('edit_hora_entrada').value = (horaEntrada && horaEntrada !== '-') ? horaEntrada : '';
        document.getElementById('edit_hora_salida').value = (horaSalida && horaSalida !== '-') ? horaSalida : '';
        document.getElementById('obs_texto').value = obsActual || '';

        const subInfo = document.getElementById('modalSubInfo');
        if (subInfo) {
          const userStr = usuarioNombre ? `${escapeHTML(usuarioNombre)} · ` : '';
          const fechaStr = fecha ? `Fecha: ${escapeHTML(fecha)}` : '';
          subInfo.innerHTML = userStr || fechaStr ? `${userStr}${fechaStr}` : 'Ajustar marcaciones de horas y observaciones';
        }

        modalBackdrop.style.display = 'flex';
      }

      function cerrarModalObs() {
        modalBackdrop.style.display = 'none';
      }

      document.getElementById('btnCerrarModal')?.addEventListener('click', cerrarModalObs);
      document.getElementById('btnXModal')?.addEventListener('click', cerrarModalObs);
      modalBackdrop.addEventListener('click', (e) => {
        if (e.target === modalBackdrop) cerrarModalObs();
      });

      // =========================================================================
      // 2. MODAL DE DETALLE DE JORNADA (BITÁCORA, COMPROBANTE Y OBSERVACIÓN)
      // =========================================================================
      const modalDetalleBackdrop = document.getElementById('modalDetalleBackdrop');
      let currentDetalleData = null;

      function abrirModalDetalle(data) {
        currentDetalleData = data;
        document.getElementById('det_usuario_nombre').textContent = data.usuario_nombre || 'Usuario';
        document.getElementById('det_sub_info').textContent = `CI: ${data.usuario_ci || 'N/A'} · Fecha: ${data.fecha || 'N/A'}`;
        document.getElementById('det_lugar_nombre').textContent = data.lugar_nombre ? `${data.lugar_nombre} ${data.lugar_tipo ? '(' + data.lugar_tipo + ')' : ''}` : 'N/A';
        document.getElementById('det_hora_entrada').textContent = data.hora_entrada || '-';
        document.getElementById('det_hora_salida').textContent = data.hora_salida || '-';
        document.getElementById('det_duracion').textContent = data.horas_dia || '-';

        // Tarea / Bitácora
        const tareaBox = document.getElementById('det_tarea_box');
        if (data.tarea && data.tarea.trim()) {
          tareaBox.innerHTML = escapeHTML(data.tarea).replace(/\n/g, '<br>');
          tareaBox.classList.remove('is-empty');
        } else {
          tareaBox.innerHTML = '<em>No se registró bitácora para esta jornada.</em>';
          tareaBox.classList.add('is-empty');
        }

        // Comprobante Fotográfico
        const compContainer = document.getElementById('det_comprobante_container');
        if (data.comprobante && data.comprobante.trim()) {
          compContainer.innerHTML = `
            <div class="comprobante-preview-card">
              <a href="${escapeHTML(data.comprobante)}" target="_blank" title="Ver imagen completa">
                <img src="${escapeHTML(data.comprobante)}" alt="Comprobante de Asistencia" class="comprobante-img" onerror="this.parentElement.innerHTML='<span style=\\'color:#94a3b8; font-size:13px;\\'>No se pudo cargar la imagen</span>'">
              </a>
              <div class="comprobante-preview-footer">
                <a href="${escapeHTML(data.comprobante)}" target="_blank" class="btn btn-outline-primary" style="height:32px; padding:4px 14px; font-size:12px;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  Ver en Pantalla Completa
                </a>
              </div>
            </div>
          `;
        } else {
          compContainer.innerHTML = `
            <div class="detalle-empty-box">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <span>Sin comprobante fotográfico adjunto</span>
            </div>
          `;
        }

        // Observación del Admin
        const obsBox = document.getElementById('det_obs_box');
        if (data.observacion && data.observacion.trim()) {
          obsBox.innerHTML = escapeHTML(data.observacion).replace(/\n/g, '<br>');
          obsBox.classList.add('has-warning');
          obsBox.classList.remove('is-empty');
        } else {
          obsBox.innerHTML = '<em>Sin observaciones del administrador.</em>';
          obsBox.classList.remove('has-warning');
          obsBox.classList.add('is-empty');
        }

        modalDetalleBackdrop.style.display = 'flex';
      }

      function cerrarModalDetalle() {
        modalDetalleBackdrop.style.display = 'none';
      }

      document.getElementById('btnCerrarDetalle')?.addEventListener('click', cerrarModalDetalle);
      document.getElementById('btnXCerrarDetalle')?.addEventListener('click', cerrarModalDetalle);
      modalDetalleBackdrop.addEventListener('click', (e) => {
        if (e.target === modalDetalleBackdrop) cerrarModalDetalle();
      });

      document.getElementById('btnEditarDesdeDetalle')?.addEventListener('click', () => {
        if (!currentDetalleData) return;
        cerrarModalDetalle();
        abrirModalEditar(
          currentDetalleData.id_asistencia,
          currentDetalleData.hora_entrada,
          currentDetalleData.hora_salida,
          currentDetalleData.observacion,
          currentDetalleData.usuario_nombre,
          currentDetalleData.fecha
        );
      });

      // =========================================================================
      // 3. MODAL DE HORARIO DEL USUARIO
      // =========================================================================
      const modalHorarioBackdrop = document.getElementById('modalHorarioBackdrop');

      async function abrirModalHorario(idUsuario, nombreUsuario, ciUsuario) {
        if (!idUsuario) return;
        const nombreEl = document.getElementById('horario_usuario_nombre');
        const subEl = document.getElementById('horario_usuario_sub');
        const bodyEl = document.getElementById('horario_body_content');

        nombreEl.textContent = nombreUsuario || 'Usuario';
        subEl.textContent = `CI: ${ciUsuario || ''} · Consultando horario asignado...`;
        bodyEl.innerHTML = `
          <div style="text-align:center; padding: 32px 16px; color: var(--color-text-muted);">
            <div style="font-weight: 500; font-size: 14px;">Cargando horario programado...</div>
          </div>
        `;

        modalHorarioBackdrop.style.display = 'flex';

        try {
          const res = await fetch(`/api/admin/usuarios/${idUsuario}/horario`);
          const data = await res.json();
          if (!data.ok) throw new Error(data.msg || 'Error al obtener horario');

          if (data.usuario) {
            const carrera = data.usuario.carrera ? ` · ${escapeHTML(data.usuario.carrera)}` : '';
            const uni = data.usuario.universidad ? ` (${escapeHTML(data.usuario.universidad)})` : '';
            subEl.textContent = `CI: ${data.usuario.CI || ciUsuario || 'N/A'}${carrera}${uni}`;
          }

          if (!data.horarios || data.horarios.length === 0) {
            bodyEl.innerHTML = `
              <div class="horario-empty-card">
                <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <div style="font-weight: 600; color: var(--color-text); margin-top: 6px;">Este usuario no tiene horario programado</div>
                <div style="font-size: 13px; color: var(--color-text-muted); margin-top: 2px;">No se encontraron días ni horas activas asignadas para este pasante.</div>
              </div>
            `;
            return;
          }

          let rowsHTML = '';
          data.horarios.forEach(h => {
            rowsHTML += `
              <tr>
                <td><strong style="color: var(--color-text); font-size: 13.5px;">${escapeHTML(h.dia_nombre)}</strong></td>
                <td><span class="badge-time-in"><b>E:</b> ${escapeHTML(h.hora_entrada || '-')}</span></td>
                <td><span class="badge-time-out"><b>S:</b> ${escapeHTML(h.hora_salida || '-')}</span></td>
                <td><span class="hours-pill" style="font-size: 12px; padding: 3px 8px;">${escapeHTML(h.horas_dia || '-')}</span></td>
                <td style="text-align: center;"><span class="badge-active" style="font-size: 10.5px;">Activo</span></td>
              </tr>
            `;
          });

          bodyEl.innerHTML = `
            <div class="horario-table-wrap">
              <table class="horario-table">
                <thead>
                  <tr>
                    <th>Día</th>
                    <th>Entrada Programada</th>
                    <th>Salida Programada</th>
                    <th>Horas / Día</th>
                    <th style="text-align: center;">Estado</th>
                  </tr>
                </thead>
                <tbody>
                  ${rowsHTML}
                </tbody>
              </table>
            </div>

            <div class="horario-footer-summary">
              <span style="font-size: 13px; color: var(--color-text-muted); font-weight: 500;">Total Horas Programadas Semanalmente:</span>
              <span class="horario-total-badge">${escapeHTML(data.total_horas_semanales || '0 hrs/sem')}</span>
            </div>
          `;
        } catch (e) {
          console.error(e);
          bodyEl.innerHTML = `
            <div class="horario-empty-card" style="border-color: #fecaca; background: #fff5f5;">
              <div style="color: #dc2626; font-weight: 600;">No se pudo cargar el horario</div>
              <div style="font-size: 13px; color: #991b1b;">Ocurrió un error al consultar el horario del usuario.</div>
            </div>
          `;
        }
      }

      function cerrarModalHorario() {
        modalHorarioBackdrop.style.display = 'none';
      }

      document.getElementById('btnCerrarHorario')?.addEventListener('click', cerrarModalHorario);
      document.getElementById('btnXCerrarHorario')?.addEventListener('click', cerrarModalHorario);
      modalHorarioBackdrop.addEventListener('click', (e) => {
        if (e.target === modalHorarioBackdrop) cerrarModalHorario();
      });

      // =========================================================================
      // 3.5. MODAL DE CALENDARIO Y AGENDA SEMANAL DE ASISTENCIAS DEL USUARIO
      // =========================================================================
      const modalCalendarioBackdrop = document.getElementById('modalCalendarioBackdrop');
      let userCalendarAttendances = [];
      let userCalendarMap = {}; // 'YYYY-MM-DD' -> array of items
      let userWeeklyScheduleMap = {}; // dia_semana (1=Lun..7=Dom) -> horario item
      let calCurrentMonday = null; // Date object representing current week's Monday
      let calCurrentSelectedDate = null;
      let currentCalendarUserId = null;

      const diasSemanaNombres = ['', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
      const diasSemanaCortos = ['', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];

      function getMondayOfDate(d) {
        const date = new Date(d);
        const day = date.getDay();
        const diff = date.getDate() - day + (day === 0 ? -6 : 1);
        const mon = new Date(date.setDate(diff));
        mon.setHours(0, 0, 0, 0);
        return mon;
      }

      function parseTimeToMinutes(timeStr) {
        if (!timeStr) return 0;
        const [h, m] = timeStr.split(':').map(Number);
        return (h * 60) + (m || 0);
      }

      async function abrirModalCalendarioUsuario(idUsuario) {
        if (!idUsuario) return;
        currentCalendarUserId = idUsuario;
        calCurrentSelectedDate = null;

        const nombreEl = document.getElementById('cal_usuario_nombre');
        const subEl = document.getElementById('cal_usuario_sub');
        const detailCard = document.getElementById('calDayDetailCard');
        const schedListEl = document.getElementById('calSchedDaysList');

        if (detailCard) detailCard.style.display = 'none';
        if (schedListEl) schedListEl.innerHTML = '<span class="cal-sched-loading">Consultando turnos...</span>';

        nombreEl.textContent = 'Cargando usuario...';
        subEl.textContent = 'Consultando asistencias, actividades y horario programado...';

        modalCalendarioBackdrop.style.display = 'flex';

        try {
          let userInfo = null;
          let asistencias = [];
          let horarios = [];

          // 1. Intentar consultar endpoint unificado de calendario
          try {
            const res = await fetch(`/api/admin/usuario/${idUsuario}/calendario`);
            if (res.ok) {
              const data = await res.json();
              if (data.ok) {
                userInfo = data.usuario;
                asistencias = data.asistencias || [];
                horarios = data.horarios || [];
              }
            }
          } catch (e) {
            // Continuar con fallback
          }

          // 2. Si faltan datos de usuario o asistencias, consultar reportes
          if (!userInfo) {
            const res = await fetch(`/api/admin/reportes?id_usuario=${idUsuario}&size=500`);
            const data = await res.json();
            if (!data.ok) throw new Error(data.error || 'Error al obtener datos');
            userInfo = data.usuario_info || {
              id_usuario: idUsuario,
              nombre: document.getElementById('stat-user')?.textContent || 'Usuario',
              CI: (document.getElementById('stat-user-badge')?.textContent || '').replace('CI: ', '').trim(),
              carrera: '',
              universidad: ''
            };
            asistencias = (data.data || []).map(a => ({
              ...a,
              estado: a.estado_calculado || a.estado || 'FINALIZADO'
            }));
          }

          // 3. Si faltan horarios, consultar API de horarios
          if (!horarios || horarios.length === 0) {
            try {
              const resH = await fetch(`/api/admin/usuarios/${idUsuario}/horario`);
              if (resH.ok) {
                const dataH = await resH.json();
                if (dataH.ok) horarios = dataH.horarios || [];
              }
            } catch (errH) {
              console.warn('No se pudo cargar horario auxiliar:', errH);
            }
          }

          nombreEl.textContent = userInfo.nombre || 'Usuario';
          subEl.textContent = `CI: ${userInfo.CI || 'N/A'} ${userInfo.carrera ? '· ' + userInfo.carrera : ''} ${userInfo.universidad ? '· ' + userInfo.universidad : ''}`;

          userCalendarAttendances = asistencias;
          userCalendarMap = {};
          userCalendarAttendances.forEach(item => {
            if (!userCalendarMap[item.fecha]) {
              userCalendarMap[item.fecha] = [];
            }
            userCalendarMap[item.fecha].push(item);
          });

          // Guardar mapa de horarios semanales
          userWeeklyScheduleMap = {};
          (horarios || []).forEach(h => {
            userWeeklyScheduleMap[h.dia_semana] = h;
          });

          // Renderizar barra superior de horarios programados
          if (schedListEl) {
            if (!horarios || horarios.length === 0) {
              schedListEl.innerHTML = '<span class="cal-sched-empty">Sin horario semanal registrado</span>';
            } else {
              schedListEl.innerHTML = horarios.map(h => {
                const diaTxt = diasSemanaCortos[h.dia_semana] || `Día ${h.dia_semana}`;
                return `<span class="cal-sched-item"><b class="cal-sched-day">${diaTxt}:</b> ${h.hora_entrada ? h.hora_entrada.slice(0,5) : '-'} a ${h.hora_salida ? h.hora_salida.slice(0,5) : '-'}</span>`;
              }).join('');
            }
          }

          // Iniciar en la semana de su última asistencia si existe, o en la semana actual
          if (userCalendarAttendances.length > 0) {
            const lastItem = userCalendarAttendances[0];
            const parts = (lastItem.fecha || '').split('-');
            if (parts.length === 3) {
              const d = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
              calCurrentMonday = getMondayOfDate(d);
            } else {
              calCurrentMonday = getMondayOfDate(new Date());
            }
          } else {
            calCurrentMonday = getMondayOfDate(new Date());
          }

          renderCalendarioSemanal();
        } catch (err) {
          console.error('Error al cargar calendario del usuario:', err);
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'No se pudo cargar el calendario del usuario.'
          });
          cerrarModalCalendario();
        }
      }

      function cerrarModalCalendario() {
        if (modalCalendarioBackdrop) modalCalendarioBackdrop.style.display = 'none';
      }

      document.getElementById('btnCerrarCalendario')?.addEventListener('click', cerrarModalCalendario);
      document.getElementById('btnXCerrarCalendario')?.addEventListener('click', cerrarModalCalendario);
      modalCalendarioBackdrop?.addEventListener('click', (e) => {
        if (e.target === modalCalendarioBackdrop) cerrarModalCalendario();
      });

      function cambiarSemanaCalendario(offset) {
        if (!calCurrentMonday) calCurrentMonday = getMondayOfDate(new Date());
        calCurrentMonday.setDate(calCurrentMonday.getDate() + (offset * 7));
        renderCalendarioSemanal();
      }

      function irEstaSemanaCalendario() {
        calCurrentMonday = getMondayOfDate(new Date());
        renderCalendarioSemanal();
      }

      document.getElementById('btnCalPrevWeek')?.addEventListener('click', () => cambiarSemanaCalendario(-1));
      document.getElementById('btnCalNextWeek')?.addEventListener('click', () => cambiarSemanaCalendario(1));
      document.getElementById('btnCalThisWeek')?.addEventListener('click', irEstaSemanaCalendario);

      function renderCalendarioSemanal() {
        if (!calCurrentMonday) calCurrentMonday = getMondayOfDate(new Date());

        const sunDate = new Date(calCurrentMonday);
        sunDate.setDate(calCurrentMonday.getDate() + 6);

        const fmtD = (d) => `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()}`;
        const fmtShort = (d) => `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}`;

        const weekLabelEl = document.getElementById('calCurrentWeekLabel');
        if (weekLabelEl) {
          weekLabelEl.textContent = `Semana del ${fmtD(calCurrentMonday)} al ${fmtD(sunDate)}`;
        }

        // 1. Renderizar Encabezados de Días (Lunes a Domingo)
        const headerDaysEl = document.getElementById('calWeeklyHeaderDays');
        if (headerDaysEl) {
          const todayObj = new Date();
          const todayStr = `${todayObj.getFullYear()}-${String(todayObj.getMonth() + 1).padStart(2, '0')}-${String(todayObj.getDate()).padStart(2, '0')}`;

          let headerHTML = `<div class="weekly-time-col-header">Hora</div>`;
          for (let i = 0; i < 7; i++) {
            const currentDayDate = new Date(calCurrentMonday);
            currentDayDate.setDate(calCurrentMonday.getDate() + i);
            const dateStr = `${currentDayDate.getFullYear()}-${String(currentDayDate.getMonth() + 1).padStart(2, '0')}-${String(currentDayDate.getDate()).padStart(2, '0')}`;
            const isToday = dateStr === todayStr;
            const diaName = diasSemanaCortos[i + 1] || '';

            headerHTML += `
              <div class="weekly-day-col-header ${isToday ? 'is-today' : ''}">
                <span class="weekly-day-title">${diaName}</span>
                <span class="weekly-day-date">${fmtShort(currentDayDate)}</span>
              </div>
            `;
          }
          headerDaysEl.innerHTML = headerHTML;
        }

        // 2. Renderizar Eje de Horas (06:00 a 20:00)
        const timeAxisEl = document.getElementById('calWeeklyTimeAxis');
        const startHour = 6;
        const endHour = 21;
        const pxPerHour = 46;

        if (timeAxisEl) {
          let axisHTML = '';
          for (let h = startHour; h < endHour; h++) {
            axisHTML += `<div>${String(h).padStart(2, '0')}:00</div>`;
          }
          timeAxisEl.innerHTML = axisHTML;
        }

        // 3. Renderizar las 7 Columnas de Días con Bloques Programados y Asistencias
        const daysColumnsEl = document.getElementById('calWeeklyDaysColumns');
        if (!daysColumnsEl) return;
        daysColumnsEl.innerHTML = '';

        let weekTotalSeconds = 0;
        let weekTotalDays = 0;

        for (let i = 0; i < 7; i++) {
          const currentDayDate = new Date(calCurrentMonday);
          currentDayDate.setDate(calCurrentMonday.getDate() + i);
          const dateStr = `${currentDayDate.getFullYear()}-${String(currentDayDate.getMonth() + 1).padStart(2, '0')}-${String(currentDayDate.getDate()).padStart(2, '0')}`;
          const diaNum = i + 1;
          const prog = userWeeklyScheduleMap[diaNum];
          const items = userCalendarMap[dateStr] || [];
          const hasAttendance = items.length > 0;

          const colEl = document.createElement('div');
          colEl.className = 'weekly-day-column';
          if (calCurrentSelectedDate === dateStr) colEl.classList.add('is-selected');

          // A) Renderizar Bloque de Horario Programado
          if (prog && prog.hora_entrada && prog.hora_salida) {
            const startMin = parseTimeToMinutes(prog.hora_entrada);
            const endMin = parseTimeToMinutes(prog.hora_salida);
            const baseMin = startHour * 60;

            const topPx = Math.max(0, ((startMin - baseMin) / 60) * pxPerHour);
            const heightPx = Math.max(24, ((endMin - startMin) / 60) * pxPerHour);

            const schedCard = document.createElement('div');
            schedCard.className = 'weekly-scheduled-slot';
            schedCard.style.top = `${topPx}px`;
            schedCard.style.height = `${heightPx}px`;
            schedCard.title = `Turno Programado: ${prog.hora_entrada.slice(0,5)} a ${prog.hora_salida.slice(0,5)}`;
            schedCard.innerHTML = `
              <div class="sched-slot-label">⏰ Programado</div>
              <div class="sched-slot-time">${prog.hora_entrada.slice(0,5)} - ${prog.hora_salida.slice(0,5)}</div>
            `;
            colEl.appendChild(schedCard);
          }

          // B) Renderizar Bloques de Asistencia Real
          if (hasAttendance) {
            weekTotalDays++;
            items.forEach(item => {
              if (item.duracion_segundos) weekTotalSeconds += item.duracion_segundos;

              let startMin = item.hora_entrada ? parseTimeToMinutes(item.hora_entrada) : (prog ? parseTimeToMinutes(prog.hora_entrada) : 8 * 60);
              let endMin = item.hora_salida ? parseTimeToMinutes(item.hora_salida) : startMin + 240;
              if (endMin <= startMin) endMin = startMin + 60;

              const baseMin = startHour * 60;
              const topPx = Math.max(0, ((startMin - baseMin) / 60) * pxPerHour);
              const heightPx = Math.max(34, ((endMin - startMin) / 60) * pxPerHour);

              let badgeClass = 'event-finalizado';
              let statusLabel = 'Asistencia';
              if (item.estado === 'OBSERVADO') {
                badgeClass = 'event-observado';
                statusLabel = 'Observación';
              } else if (item.estado === 'EN_CURSO') {
                badgeClass = 'event-en-curso';
                statusLabel = 'En curso';
              }

              let miniBadges = '';
              if (item.tarea) miniBadges += `<span class="weekly-mini-dot dot-tarea" title="Con bitácora"></span>`;
              if (item.comprobante) miniBadges += `<span class="weekly-mini-dot dot-foto" title="Con foto"></span>`;
              if (item.observacion) miniBadges += `<span class="weekly-mini-dot dot-obs" title="Con observación"></span>`;

              const eventCard = document.createElement('div');
              eventCard.className = `weekly-attendance-card ${badgeClass}`;
              eventCard.style.top = `${topPx}px`;
              eventCard.style.height = `${heightPx}px`;
              eventCard.title = `Asistencia: ${item.hora_entrada || '-'} a ${item.hora_salida || '-'} (${item.horas_dia || '-'})`;
              eventCard.innerHTML = `
                <div class="weekly-event-header">
                  <span class="weekly-event-status">${statusLabel}</span>
                  <div class="weekly-mini-dots">${miniBadges}</div>
                </div>
                <div class="weekly-event-hours">${item.hora_entrada || '-'} - ${item.hora_salida || '-'}</div>
                <div class="weekly-event-duration">${item.horas_dia || ''}</div>
                <div class="weekly-event-place">${escapeHTML(item.lugar_nombre || 'Obra')}</div>
              `;

              eventCard.onclick = (e) => {
                e.stopPropagation();
                document.querySelectorAll('.weekly-day-column').forEach(c => c.classList.remove('is-selected'));
                colEl.classList.add('is-selected');
                calCurrentSelectedDate = dateStr;
                mostrarDetalleDiaCalendario(item, diaNum, dateStr);
              };

              colEl.appendChild(eventCard);
            });
          }

          // Clic en la columna
          colEl.onclick = () => {
            document.querySelectorAll('.weekly-day-column').forEach(c => c.classList.remove('is-selected'));
            colEl.classList.add('is-selected');
            calCurrentSelectedDate = dateStr;
            mostrarDetalleDiaCalendario(hasAttendance ? items[0] : null, diaNum, dateStr);
          };

          daysColumnsEl.appendChild(colEl);
        }

        // Actualizar KPIs de la semana
        document.getElementById('calKpiTotalDiasSemana').textContent = weekTotalDays;
        document.getElementById('calKpiTotalHorasSemana').textContent = formatSecondsToHHMM(weekTotalSeconds);
      }

      function mostrarDetalleDiaCalendario(item, diaNum, dateStr) {
        const detailCard = document.getElementById('calDayDetailCard');
        if (!detailCard) return;

        detailCard.style.display = 'block';
        const diaNombre = diasSemanaNombres[diaNum] || '';
        document.getElementById('calDetailDateBadge').textContent = `${dateStr} (${diaNombre})`;

        // Horario programado
        const prog = userWeeklyScheduleMap[diaNum];
        const schedTxtEl = document.getElementById('calDetailHorarioProgTxt');
        if (prog) {
          schedTxtEl.textContent = `${prog.hora_entrada.slice(0,5)} a ${prog.hora_salida.slice(0,5)} (Turno de ${diaNombre})`;
          schedTxtEl.style.color = '#1D4ED8';
        } else {
          schedTxtEl.textContent = `Sin horario programado para los ${diaNombre}s`;
          schedTxtEl.style.color = 'var(--color-text-muted)';
        }

        const lugarEl = document.getElementById('calDetailLugar');
        const statusEl = document.getElementById('calDetailStatus');
        const entradaEl = document.getElementById('calDetailEntrada');
        const salidaEl = document.getElementById('calDetailSalida');
        const duracionEl = document.getElementById('calDetailDuracion');
        const tareaEl = document.getElementById('calDetailTarea');
        const obsWrap = document.getElementById('calDetailObsWrap');
        const obsEl = document.getElementById('calDetailObs');

        if (item) {
          lugarEl.textContent = item.lugar_nombre ? `${item.lugar_nombre} ${item.lugar_tipo ? '(' + item.lugar_tipo + ')' : ''}` : 'Sin lugar asignado';

          if (item.estado === 'OBSERVADO') {
            statusEl.textContent = 'Observación (Sin salida)';
            statusEl.className = 'cal-detail-status status-observado';
          } else if (item.estado === 'EN_CURSO') {
            statusEl.textContent = 'En curso';
            statusEl.className = 'cal-detail-status status-en-curso';
          } else {
            statusEl.textContent = 'Finalizado';
            statusEl.className = 'cal-detail-status status-finalizado';
          }

          entradaEl.textContent = item.hora_entrada || '-';
          salidaEl.textContent = item.hora_salida || '-';
          duracionEl.textContent = item.horas_dia || '-';

          if (item.tarea && item.tarea.trim()) {
            tareaEl.innerHTML = escapeHTML(item.tarea).replace(/\n/g, '<br>');
          } else {
            tareaEl.innerHTML = '<em>Sin bitácora registrada para esta jornada.</em>';
          }

          if (item.observacion && item.observacion.trim()) {
            obsWrap.style.display = 'block';
            obsEl.innerHTML = escapeHTML(item.observacion).replace(/\n/g, '<br>');
          } else {
            obsWrap.style.display = 'none';
          }
        } else {
          // Día sin asistencia registrada
          lugarEl.textContent = 'Sin jornada registrada';
          statusEl.textContent = prog ? 'Programado (Pendiente)' : 'Sin Asistencia';
          statusEl.className = prog ? 'cal-detail-status status-en-curso' : 'cal-detail-status';
          entradaEl.textContent = '-';
          salidaEl.textContent = '-';
          duracionEl.textContent = '00:00';
          tareaEl.innerHTML = '<em>No se registraron actividades para este día.</em>';
          obsWrap.style.display = 'none';
        }

        detailCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

