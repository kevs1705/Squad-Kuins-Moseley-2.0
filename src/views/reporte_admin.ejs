<% pageTitle='Reportes (Administrador)' ; pageSubtitle='Listado global · Búsqueda por Usuario / CI · Control de Horas' ;
  %>
  <%- include('partials/header') %>
    <link rel="stylesheet" href="/css/reporte_admin.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
      document.body.classList.add('reportes-admin-page');
      (() => {
        const header = document.querySelector('.content-header');
        if (header) {
          const h1 = header.querySelector('h1');
          if (h1) h1.childNodes[0].textContent = 'Reportes';

          const rightEl = header.querySelector('small.muted') || header.lastElementChild;
          if (rightEl && rightEl !== h1.parentElement) {
            const formattedDate = new Date().toLocaleDateString('es-ES', { day: 'numeric', month: 'numeric', year: 'numeric' });
            rightEl.outerHTML = `
          <div class="header-right">
            <div class="admin-badge">Administrador</div>
            <div class="header-separator"></div>
            <div class="header-date">Actualizado ${formattedDate}</div>
          </div>
        `;
          }
        }
      })();
    </script>

    <!-- KPI Stats Cards -->
    <div class="stats-grid">
      <!-- Card 1: Total Registros -->
      <div class="stat-card">
        <div class="stat-icon-wrapper">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
            stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
          </svg>
        </div>
        <div class="stat-info">
          <span class="stat-label">Registros encontrados</span>
          <div class="stat-value-row">
            <span class="stat-value" id="stat-records">0</span>
            <span class="stat-badge" id="stat-records-badge">Jornadas</span>
          </div>
        </div>
      </div>

      <!-- Card 2: Horas Acumuladas -->
      <div class="stat-card">
        <div class="stat-icon-wrapper">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
            stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        </div>
        <div class="stat-info">
          <span class="stat-label">Horas acumuladas</span>
          <div class="stat-value-row">
            <span class="stat-value" id="stat-hours">00:00:00</span>
            <span class="stat-badge">HH:MM:SS</span>
          </div>
        </div>
      </div>

      <!-- Card 3: Usuario Seleccionado -->
      <div class="stat-card">
        <div class="stat-icon-wrapper">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
            stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
          </svg>
        </div>
        <div class="stat-info">
          <span class="stat-label">Usuario Seleccionado</span>
          <div class="stat-value-row">
            <span class="stat-value" id="stat-user"
              style="font-size: 19px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
              title="Todos los usuarios">Todos los usuarios</span>
          </div>
          <div>
            <span class="stat-badge" id="stat-user-badge">Global</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Filters Card -->
    <div class="filters-card">
      <form id="filtro-form">
        <div class="filters-form-row">
          <!-- Búsqueda de Usuario con Autocompletado (Nombre y Apellido) -->
          <div class="filter-group flex-grow-2">
            <label for="userAutocompleteInput">Buscar Usuario (Nombre o Apellido):</label>
            <div class="autocomplete-container">
              <div class="autocomplete-input-wrap input-icon-wrap icon-user">
                <input id="userAutocompleteInput" type="text" placeholder="Escribe nombre, apellido o CI..."
                  autocomplete="off">
                <button type="button" class="autocomplete-clear-btn" id="btnClearUser"
                  title="Limpiar usuario seleccionado">&times;</button>
              </div>
              <!-- Dropdown con sugerencias de autocompletado -->
              <div class="autocomplete-dropdown" id="userAutocompleteDropdown"></div>
            </div>
            <!-- Input oculto para el id del usuario seleccionado -->
            <input type="hidden" id="filterUsuario" name="id_usuario" value="">
          </div>

          <!-- Filtro por CI -->
          <div class="filter-group flex-grow-1">
            <label for="filterCI">Filtrar por CI:</label>
            <div class="input-icon-wrap">
              <input id="filterCI" name="ci" type="text" placeholder="Ej.: 7099111" value="<%= filtroCI || '' %>">
            </div>
          </div>

          <!-- Filtro por Fecha -->
          <div class="filter-group flex-grow-1">
            <label for="filterFecha">Fecha específica:</label>
            <div class="input-icon-wrap icon-calendar">
              <input id="filterFecha" name="fecha" type="date">
            </div>
          </div>

          <!-- Botones de Acción -->
          <div class="filter-buttons">
            <button class="btn btn-primary btn-search" type="submit">Buscar</button>
            <button class="btn btn-outline-primary btn-clear" id="btn-limpiar" type="button">Limpiar</button>
            <button class="btn btn-primary btn-export" id="btn-exportar" type="button">Exportar</button>
          </div>
        </div>

        <!-- Accesos Directos -->
        <div class="filters-bottom-row">
          <a href="/graficos" class="btn btn-secondary btn-chart" style="text-decoration: none;">Gráficos
            Estadísticos</a>
          <a href="/notificaciones_admin" class="btn btn-secondary btn-bell" style="text-decoration: none;">Gestión de
            Notificaciones</a>
        </div>
      </form>
    </div>

    <!-- Tabla Principal de Asistencias y Bitácoras -->
    <div class="reports-table-card">
      <div class="table-wrap">
        <table class="table">
          <thead id="tablaHeader">
            <tr>
              <th>Usuario</th>
              <th>CI</th>
              <th>Fecha</th>
              <th>
                <div class="th-filter-wrapper">
                  <span>Lugar / Obra</span>
                  <select id="filterLugar" class="th-filter-select" title="Filtrar por obra / lugar">
                    <option value="">Todas las obras</option>
                    <% (lugares || []).forEach(l=> { %>
                      <option value="<%= l.id_lugar %>">
                        <%= l.nombre %>
                      </option>
                      <% }) %>
                  </select>
                </div>
              </th>
              <th>Marcaciones</th>
              <th>Duración</th>
              <th>Bitácora / Tarea</th>
              <th>Comprobante</th>
              <th>Observación Admin</th>
              <th style="text-align: center;">Acción</th>
            </tr>
          </thead>
          <tbody id="tablaReportes">
            <!-- Poblado dinámicamente mediante fetch -->
          </tbody>
        </table>
      </div>

      <!-- Pie de tabla y Paginación -->
      <div class="table-footer">
        <span class="table-footer-info" id="infoPaginacion">Mostrando 0 de 0 registros</span>
        <div class="pagination-wrap" id="paginador">
          <!-- Generado dinámicamente -->
        </div>
      </div>
    </div>

    <!-- MODAL: EDITAR HORAS Y OBSERVACIÓN -->
    <div class="modal-backdrop" id="modalObsBackdrop">
      <div class="modal" id="modalObs">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 18px;">
          <div>
            <h3 style="margin: 0 0 4px 0;">Editar Registro de Jornada</h3>
            <p id="modalSubInfo" style="margin: 0; font-size: 13px; color: var(--color-text-muted);">Ajustar marcaciones
              de horas y observaciones</p>
          </div>
          <button type="button" id="btnXModal"
            style="background: none; border: none; font-size: 22px; cursor: pointer; color: var(--color-text-muted); line-height: 1; padding: 2px 6px;">&times;</button>
        </div>
        <form id="formObs">
          <input type="hidden" id="obs_id_asistencia">
          <div class="form-grid" style="grid-template-columns: 1fr 1fr; margin-bottom: 16px;">
            <label>
              Hora Entrada:
              <input type="time" id="edit_hora_entrada" name="hora_entrada" required>
            </label>
            <label>
              Hora Salida:
              <input type="time" id="edit_hora_salida" name="hora_salida">
            </label>
          </div>
          <div class="form-grid" style="grid-template-columns: 1fr;">
            <label>
              Observaciones del Administrador:
              <textarea id="obs_texto" rows="3"
                placeholder="Ingresa justificativos, observaciones o correcciones de la jornada..."></textarea>
            </label>
          </div>
          <div class="modal-actions" style="margin-top: 20px;">
            <button type="button" class="btn btn-secondary" id="btnCerrarModal">Cancelar</button>
            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
          </div>
        </form>
      </div>
    </div>

    <script id="data-usuarios" type="application/json"><%- JSON.stringify(usuarios || []) %></script>
    <script id="data-lugares" type="application/json"><%- JSON.stringify(lugares || []) %></script>
    <script>
      // Listas inyectadas desde el backend
      const listaUsuarios = JSON.parse(document.getElementById('data-usuarios')?.textContent || '[]');
      const listaLugares = JSON.parse(document.getElementById('data-lugares')?.textContent || '[]');
      let currentPage = 1;
      const pageSize = 25; // Tamaño fijo de página

      // Elementos de autocompletado
      const autoInput = document.getElementById('userAutocompleteInput');
      const autoDropdown = document.getElementById('userAutocompleteDropdown');
      const hiddenUserId = document.getElementById('filterUsuario');
      const btnClearUser = document.getElementById('btnClearUser');

      // Helper para iniciales de usuario
      function getInitials(name) {
        if (!name) return 'U';
        const parts = name.trim().split(/\s+/);
        if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
        return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
      }

      // Renderizar dropdown de autocompletado
      function renderAutocomplete(query = '') {
        const q = query.trim().toLowerCase();
        autoDropdown.innerHTML = '';

        let filtrados = listaUsuarios;
        if (q) {
          filtrados = listaUsuarios.filter(u => {
            const nom = (u.nombre || '').toLowerCase();
            const ci = String(u.CI || '').toLowerCase();
            return nom.includes(q) || ci.includes(q);
          });
        }

        if (filtrados.length === 0) {
          autoDropdown.innerHTML = `
        <div class="autocomplete-empty">
          No se encontraron usuarios coincidentes con "<strong>${escapeHTML(query)}</strong>"
        </div>
      `;
          autoDropdown.classList.add('show');
          return;
        }

        // Opción para resetear a "Todos los usuarios" si hay algo escrito o seleccionado
        if (hiddenUserId.value || q) {
          const allItem = document.createElement('div');
          allItem.className = 'autocomplete-item';
          allItem.innerHTML = `
        <div class="user-avatar-initials" style="background:#F1F5F9; color:#475569;">★</div>
        <div class="user-item-info">
          <span class="user-item-name">-- Todos los Usuarios --</span>
          <span class="user-item-sub">Ver registros globales de todo el equipo</span>
        </div>
      `;
          allItem.addEventListener('click', () => {
            seleccionarUsuario(null);
            autoDropdown.classList.remove('show');
            fetchReportes(1);
          });
          autoDropdown.appendChild(allItem);
        }

        filtrados.forEach(u => {
          const item = document.createElement('div');
          item.className = `autocomplete-item ${hiddenUserId.value == u.id_usuario ? 'selected' : ''}`;

          let nombreHTML = escapeHTML(u.nombre);
          if (q) {
            const regex = new RegExp(`(${q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
            nombreHTML = nombreHTML.replace(regex, '<span class="autocomplete-highlight">$1</span>');
          }

          const carreraText = u.carrera ? ` · ${escapeHTML(u.carrera)}` : '';
          const uniText = u.universidad ? ` (${escapeHTML(u.universidad)})` : '';

          item.innerHTML = `
        <div class="user-avatar-initials">${getInitials(u.nombre)}</div>
        <div class="user-item-info">
          <span class="user-item-name">${nombreHTML}</span>
          <span class="user-item-sub">
            <span class="user-item-badge">CI: ${escapeHTML(u.CI)}</span>
            <span>${carreraText}${uniText}</span>
          </span>
        </div>
      `;

          item.addEventListener('click', () => {
            seleccionarUsuario(u);
            autoDropdown.classList.remove('show');
            fetchReportes(1);
          });

          autoDropdown.appendChild(item);
        });

        autoDropdown.classList.add('show');
      }

      function seleccionarUsuario(u) {
        if (u) {
          hiddenUserId.value = u.id_usuario;
          autoInput.value = `${u.nombre} (${u.CI})`;
          btnClearUser.style.display = 'flex';
          // Limpiar filtro de CI para evitar conflictos
          document.getElementById('filterCI').value = '';
        } else {
          hiddenUserId.value = '';
          autoInput.value = '';
          btnClearUser.style.display = 'none';
        }
      }

      // Eventos de Autocompletado
      autoInput.addEventListener('focus', () => {
        renderAutocomplete(autoInput.value);
      });

      autoInput.addEventListener('input', (e) => {
        hiddenUserId.value = ''; // Si escribe, resetea la selección fija por ID
        btnClearUser.style.display = autoInput.value ? 'flex' : 'none';
        renderAutocomplete(autoInput.value);
      });

      btnClearUser.addEventListener('click', () => {
        seleccionarUsuario(null);
        autoDropdown.classList.remove('show');
        fetchReportes(1);
      });

      // Cerrar dropdown al hacer clic fuera
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.autocomplete-container')) {
          autoDropdown.classList.remove('show');
        }
      });

      // Manejo de Modal de Edición de Jornada (Horas y Observación)
      const modalBackdrop = document.getElementById('modalObsBackdrop');

      function abrirModalEditar(idAsistencia, horaEntrada, horaSalida, obsActual, usuarioNombre, fecha) {
        document.getElementById('obs_id_asistencia').value = idAsistencia;
        document.getElementById('edit_hora_entrada').value = (horaEntrada && horaEntrada !== '-') ? horaEntrada : '';
        document.getElementById('edit_hora_salida').value = (horaSalida && horaSalida !== '-') ? horaSalida : '';
        document.getElementById('obs_texto').value = obsActual || '';

        const subInfo = document.getElementById('modalSubInfo');
        if (subInfo) {
          const userStr = usuarioNombre ? `${escapeHTML(usuarioNombre)} · ` : '';
          const fechaStr = fecha ? `Fecha: ${escapeHTML(fecha)}` : '';
          subInfo.innerHTML = userStr || fechaStr ? `${userStr}${fechaStr}` : 'Ajustar marcaciones de horas y observaciones';
        }

        modalBackdrop.style.display = 'flex';
      }

      function cerrarModalObs() {
        modalBackdrop.style.display = 'none';
      }

      document.getElementById('btnCerrarModal')?.addEventListener('click', cerrarModalObs);
      document.getElementById('btnXModal')?.addEventListener('click', cerrarModalObs);
      modalBackdrop.addEventListener('click', (e) => {
        if (e.target === modalBackdrop) cerrarModalObs();
      });

      // Renderizar dinámicamente encabezados de la tabla
      function renderThead(isSpecificUser) {
        const thead = document.getElementById('tablaHeader');
        if (!thead) return;

        const currentLugar = document.getElementById('filterLugar')?.value || '';

        const lugarOptions = listaLugares.map(l =>
          `<option value="${l.id_lugar}">${escapeHTML(l.nombre)}</option>`
        ).join('');

        const userThs = isSpecificUser ? '' : `
          <th>Usuario</th>
          <th>CI</th>
        `;

        thead.innerHTML = `
          <tr>
            ${userThs}
            <th>Fecha</th>
            <th>
              <div class="th-filter-wrapper">
                <span>Lugar / Obra</span>
                <select id="filterLugar" class="th-filter-select" title="Filtrar por obra / lugar">
                  <option value="">Todas las obras</option>
                  ${lugarOptions}
                </select>
              </div>
            </th>
            <th>Marcaciones</th>
            <th>Duración</th>
            <th>Bitácora / Tarea</th>
            <th>Comprobante</th>
            <th>Observación Admin</th>
            <th style="text-align: center;">Acción</th>
          </tr>
        `;

        const newFilterLugar = document.getElementById('filterLugar');
        if (newFilterLugar) {
          newFilterLugar.value = currentLugar;
          newFilterLugar.addEventListener('change', () => fetchReportes(1));
        }
      }

      // Función principal para cargar reportes y estadísticas
      async function fetchReportes(page = 1) {
        currentPage = page;
        const ci = document.getElementById('filterCI').value.trim();
        const id_usuario = hiddenUserId.value;
        const id_lugar = document.getElementById('filterLugar')?.value || '';
        const nombreBusqueda = !id_usuario ? autoInput.value.trim() : '';
        const fecha = document.getElementById('filterFecha').value;

        const params = new URLSearchParams({
          page,
          size: pageSize,
          ci,
          id_usuario,
          id_lugar,
          nombre: nombreBusqueda,
          fecha
        });

        try {
          const res = await fetch(`/api/admin/reportes?${params}`);
          const data = await res.json();

          if (!data.ok) throw new Error(data.error || 'Error al obtener datos');

          // 1. Actualizar KPIs
          document.getElementById('stat-records').textContent = data.total.toLocaleString();
          document.getElementById('stat-hours').textContent = data.total_acumulada || '00:00:00';

          // 2. Actualizar KPI del Usuario
          const statUser = document.getElementById('stat-user');
          const statUserBadge = document.getElementById('stat-user-badge');

          const isSpecificUser = Boolean(data.usuario_info || id_usuario || nombreBusqueda || ci);

          if (data.usuario_info) {
            statUser.textContent = data.usuario_info.nombre;
            statUser.title = data.usuario_info.nombre;
            statUserBadge.textContent = `CI: ${data.usuario_info.CI}`;
          } else if (nombreBusqueda) {
            statUser.textContent = `Búsqueda: "${nombreBusqueda}"`;
            statUser.title = nombreBusqueda;
            statUserBadge.textContent = 'Filtro Nombre';
          } else if (ci) {
            statUser.textContent = `Filtro CI: ${ci}`;
            statUser.title = `Filtro CI: ${ci}`;
            statUserBadge.textContent = 'Filtro Cédula';
          } else {
            statUser.textContent = 'Todos los usuarios';
            statUser.title = 'Todos los usuarios';
            statUserBadge.textContent = 'Global';
          }

          // 3. Renderizar Encabezados, Tabla y Paginador
          renderThead(isSpecificUser);
          renderTabla(data.data, isSpecificUser);
          renderPaginador(data.page, data.totalPages, data.total, data.size);
        } catch (err) {
          console.error(err);
          Swal.fire({
            icon: 'error',
            title: 'Error de Carga',
            text: 'No se pudieron cargar los registros de asistencias y horas.'
          });
        }
      }

      function renderTabla(lista, isSpecificUser = false) {
        const tbody = document.getElementById('tablaReportes');
        tbody.innerHTML = '';
        const colspan = isSpecificUser ? 8 : 10;

        if (!lista || lista.length === 0) {
          tbody.innerHTML = `
        <tr>
          <td colspan="${colspan}" style="text-align: center; padding: 36px 16px; color: var(--color-text-muted);">
            <svg xmlns="http://www.w3.org/2000/svg" style="width: 40px; height: 40px; margin-bottom: 8px; stroke: #94a3b8;" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
            <div style="font-weight: 600; font-size: 15px;">No se encontraron registros coincidentes</div>
            <div style="font-size: 13px;">Prueba ajustando los filtros de usuario, obra o fecha.</div>
          </td>
        </tr>
      `;
          return;
        }

        lista.forEach(item => {
          const tr = document.createElement('tr');
          const obsSegura = (item.observacion || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');

          const userTds = isSpecificUser ? '' : `
            <td>
              <div class="user-name-cell">
                <span>${escapeHTML(item.usuario_nombre)}</span>
              </div>
            </td>
            <td><strong style="color: var(--color-text-muted);">${escapeHTML(item.usuario_ci)}</strong></td>
          `;

          tr.innerHTML = `
        ${userTds}
        <td><span style="font-weight: 500;">${item.fecha}</span></td>
        <td>
          <span style="font-weight: 600; color: var(--color-text);">${escapeHTML(item.lugar_nombre || 'N/A')}</span>
          ${item.lugar_tipo ? `<br><small style="color: var(--color-text-muted); font-size: 11px;">(${escapeHTML(item.lugar_tipo)})</small>` : ''}
        </td>
        <td>
          <div style="font-size: 12px; line-height: 1.4;">
            <div><strong style="color: var(--color-primary);">E:</strong> ${item.hora_entrada || '-'}</div>
            <div><strong style="color: #0D9488;">S:</strong> ${item.hora_salida || '-'}</div>
          </div>
        </td>
        <td>
          <span class="hours-pill" style="${item.horas_dia === 'En curso' ? 'background:#FEF3C7; color:#B45309; border-color: rgba(180,83,9,0.2);' : ''}">
            ${item.horas_dia}
          </span>
        </td>
        <td>
          <div style="max-width: 220px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${escapeHTML(item.tarea || '')}">
            ${item.tarea ? escapeHTML(item.tarea) : '<em style="color: var(--color-text-muted); font-size: 12px;">Sin bitácora</em>'}
          </div>
        </td>
        <td>
          ${item.comprobante ? `<a href="${item.comprobante}" target="_blank" class="pill">Ver Foto</a>` : '<span style="color: var(--color-text-muted); font-size: 12px;">-</span>'}
        </td>
        <td>
          <div style="max-width: 180px; font-size: 12px; color: ${item.observacion ? '#DC2626; font-weight: 600;' : 'var(--color-text-muted);'}" class="text-truncate" title="${escapeHTML(item.observacion || '')}">
            ${item.observacion ? escapeHTML(item.observacion) : 'Sin observaciones'}
          </div>
        </td>
        <td style="text-align: center;">
          <button class="btn-edit-row" type="button" onclick="abrirModalEditar(${item.id_asistencia}, '${item.hora_entrada || ''}', '${item.hora_salida || ''}', '${obsSegura}', '${(item.usuario_nombre || '').replace(/'/g, "\\'")}', '${item.fecha || ''}')">
            Editar
          </button>
        </td>
      `;
          tbody.appendChild(tr);
        });
      }

      function escapeHTML(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function renderPaginador(page, totalPages, total, size) {
        const start = total === 0 ? 0 : (page - 1) * size + 1;
        const end = Math.min(page * size, total);
        document.getElementById('infoPaginacion').textContent = `Mostrando ${start} a ${end} de ${total.toLocaleString()} registros`;

        const paginador = document.getElementById('paginador');
        paginador.innerHTML = '';

        if (totalPages <= 1) return;

        // Botón Anterior
        const btnPrev = document.createElement('button');
        btnPrev.className = 'btn-page-nav';
        btnPrev.innerHTML = '&lsaquo;';
        btnPrev.disabled = page <= 1;
        btnPrev.onclick = () => fetchReportes(page - 1);
        paginador.appendChild(btnPrev);

        // Botones de Páginas
        let startPage = Math.max(1, page - 2);
        let endPage = Math.min(totalPages, page + 2);

        if (startPage > 1) {
          const b1 = document.createElement('button');
          b1.className = 'btn-page-number';
          b1.textContent = '1';
          b1.onclick = () => fetchReportes(1);
          paginador.appendChild(b1);
          if (startPage > 2) {
            const dots = document.createElement('span');
            dots.style.padding = '0 4px';
            dots.textContent = '...';
            paginador.appendChild(dots);
          }
        }

        for (let i = startPage; i <= endPage; i++) {
          const btn = document.createElement('button');
          btn.className = `btn-page-number ${i === page ? 'active' : ''}`;
          btn.textContent = i;
          btn.onclick = () => fetchReportes(i);
          paginador.appendChild(btn);
        }

        if (endPage < totalPages) {
          if (endPage < totalPages - 1) {
            const dots = document.createElement('span');
            dots.style.padding = '0 4px';
            dots.textContent = '...';
            paginador.appendChild(dots);
          }
          const bEnd = document.createElement('button');
          bEnd.className = 'btn-page-number';
          bEnd.textContent = totalPages;
          bEnd.onclick = () => fetchReportes(totalPages);
          paginador.appendChild(bEnd);
        }

        // Botón Siguiente
        const btnNext = document.createElement('button');
        btnNext.className = 'btn-page-nav';
        btnNext.innerHTML = '&rsaquo;';
        btnNext.disabled = page >= totalPages;
        btnNext.onclick = () => fetchReportes(page + 1);
        paginador.appendChild(btnNext);
      }

      // Guardar Horas y Observación
      document.getElementById('formObs').addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('obs_id_asistencia').value;
        const hora_entrada = document.getElementById('edit_hora_entrada').value;
        const hora_salida = document.getElementById('edit_hora_salida').value;
        const observacion = document.getElementById('obs_texto').value.trim();

        try {
          const res = await fetch(`/api/admin/reportes/${id}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ hora_entrada, hora_salida, observacion })
          });
          const data = await res.json();

          if (data.ok) {
            cerrarModalObs();
            Swal.fire({
              icon: 'success',
              title: 'Guardado',
              text: 'Jornada y horas actualizadas correctamente',
              timer: 1500,
              showConfirmButton: false
            });
            fetchReportes(currentPage);
          } else {
            Swal.fire('Error', data.msg || 'No se pudo guardar la información', 'error');
          }
        } catch (err) {
          console.error(err);
          Swal.fire('Error', 'Error de conexión con el servidor', 'error');
        }
      });

      // Evento de cambio en el filtro de Obras/Lugares en la tabla
      document.getElementById('filterLugar')?.addEventListener('change', () => {
        fetchReportes(1);
      });

      // Submit del Formulario de Búsqueda
      document.getElementById('filtro-form').addEventListener('submit', (e) => {
        e.preventDefault();
        autoDropdown.classList.remove('show');
        fetchReportes(1);
      });

      // Botón Limpiar Filtros
      document.getElementById('btn-limpiar').addEventListener('click', () => {
        document.getElementById('filtro-form').reset();
        seleccionarUsuario(null);
        document.getElementById('filterCI').value = '';
        document.getElementById('filterFecha').value = '';
        const selectLugar = document.getElementById('filterLugar');
        if (selectLugar) selectLugar.value = '';
        fetchReportes(1);
      });

      // Botón Exportar a Excel respetando los filtros actuales
      document.getElementById('btn-exportar').addEventListener('click', () => {
        const ci = document.getElementById('filterCI').value.trim();
        const id_usuario = hiddenUserId.value;
        const id_lugar = document.getElementById('filterLugar')?.value || '';
        const nombre = !id_usuario ? autoInput.value.trim() : '';
        const fecha = document.getElementById('filterFecha').value;
        const params = new URLSearchParams({ ci, id_usuario, id_lugar, nombre, fecha });
        window.location.href = `/admin/reportes/export?${params}`;
      });

      // Carga Inicial
      fetchReportes(1);
    </script>

    <%- include('partials/footer') %>