<%
  pageTitle = 'Notificaciones';
  pageSubtitle = 'Solicitudes de horas extra — ' + (user ? user.nombre : '');
%>
<%- include('partials/header') %>

  <!-- HEADER -->
  <div class="row">
    <section class="card col">

      <div class="grid grid-2 gap-2 mt-3">
        <div class="kv">
          <span class="label">Nombre</span>
          <span class="value"><%= user?.nombre || '—' %></span>
        </div>
        <div class="kv">
          <span class="label">Solicitudes</span>
          <span class="value"><%= (notifs||[]).length %></span>
        </div>
      </div>
    </section>

    <aside class="card col-2" style="max-width:360px">
       <div class="panel">
          <div class="grid grid-2 gap-2">
            <a class="btn max-w" href="/reporte">🏠 Volver</a>
          </div>
        </div>
    </aside>
  </div>

  <!-- LISTADOR -->
  <section class="card mt-4">
    <div class="toolbar justify-between">
      <h3 class="h3 m-0">Listado de notificaciones</h3>
      <div class="toolbar">
        <input id="q" class="input" placeholder="Buscar por motivo o fecha..." />
        <select id="filtroEstado" class="select">
          <option value="">Todos</option>
          <option value="1">Pendiente</option>
          <option value="2">Aprobado</option>
          <option value="3">Rechazado</option>
        </select>
      </div>
    </div>

    <% if ((notifs||[]).length === 0) { %>
      <div class="empty">Aún no tienes solicitudes de horas extra.</div>
    <% } else { %>

    <!-- tabla desktop -->
    <div class="table-wrap desktop-only">
      <table class="table">
        <thead class="thead">
          <tr>
            <th>Fecha</th>
            <th>Horario / Horas</th>
            <th>Informe de Actividades</th>
            <th>Foto / Evidencia</th>
            <th>Estado</th>
            <th>Observación Admin</th>
            <th class="muted">Enviado</th>
          </tr>
        </thead>
        <tbody id="tbody">
        <% notifs.forEach(n => { 
          const tareaTxt = n.tarea || n.motivo || '';
        %>
          <tr class="tr"
              data-estado="<%= Number(n.estado) %>"
              data-fecha="<%- n.fecha_solicitada %>"
              data-motivo="<%- tareaTxt.toLowerCase().replace(/"/g,'&quot;') %>">
            <td class="td fw-semibold"><%= n.fecha_solicitada %></td>
            <td class="td">
              <span class="badge bg-warning text-dark px-2 py-1 mb-1 d-inline-block fw-bold" style="font-size: 11.5px;">
                <%= n.horas_cantidad ? n.horas_cantidad + ' hrs' : ((n.hora_inicio||'').slice(0,5) + ' - ' + (n.hora_fin||'').slice(0,5)) %>
              </span>
              <div class="fs-8 text-muted"><%= (n.hora_inicio||'').slice(0,5) %> a <%= (n.hora_fin||'').slice(0,5) %></div>
            </td>
            <td class="td" style="max-width: 260px;">
              <div style="max-height: 70px; overflow-y: auto; white-space: pre-wrap; font-size: 12.5px; background: #f8fafc; padding: 6px 8px; border-radius: 6px; border: 1px solid #e2e8f0;">
                <%= tareaTxt %>
              </div>
            </td>
            <td class="td">
              <% if (n.comprobante) { %>
                <a href="<%= n.comprobante %>" target="_blank" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1 shadow-xs" 
                   style="background-color: #0b6bcb; border-color: #0b6bcb; color: #ffffff !important; font-weight: 600; border-radius: 8px; padding: 5px 14px; font-size: 13px; text-decoration: none;" 
                   title="Ver fotografía de evidencia">
                  <i class="bi bi-eye-fill" style="color: #ffffff !important;"></i> <span style="color: #ffffff !important;">Ver</span>
                </a>
              <% } else { %>
                <span class="text-muted fs-8">Sin foto</span>
              <% } %>
            </td>
            <td class="td">
              <span class="chip <%= n.estado==1?'chip--pend':(n.estado==2?'chip--ok':'chip--err') %>">
                <%= n.estado==1?'⏳ En Revisión':(n.estado==2?'✅ Horas Sumadas':'❌ Observado') %>
              </span>
            </td>
            <td class="td" style="max-width: 200px;">
              <% if (n.observacion_admin) { %>
                <span class="text-danger fs-8 fw-medium" style="display: block; line-height: 1.3;">
                  <%= n.observacion_admin %>
                </span>
              <% } else { %>
                <span class="text-muted fs-8">—</span>
              <% } %>
            </td>
            <td class="td muted fs-8"><%= new Date(n.creado_en).toLocaleString('es-BO') %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </section>


  <!-- Scripts -->
  <script>
    // Filtros simples
    (function(){
      const q = document.getElementById('q');
      const filtro = document.getElementById('filtroEstado');
      const tbody = document.getElementById('tbody');
      const cards = document.getElementById('cards');

      function apply(){
        const txt = (q?.value || '').toLowerCase().trim();
        const est = filtro?.value || '';
        const applyTo = (el) => {
          const motivo = (el.dataset.motivo || '');
          const fecha  = (el.dataset.fecha || '');
          const estado = (el.dataset.estado || '');
          const okTxt = !txt || motivo.includes(txt) || fecha.includes(txt);
          const okEst = !est || estado === est;
          el.style.display = (okTxt && okEst) ? '' : 'none';
        };

        if (tbody) [...tbody.children].forEach(applyTo);
        if (cards) [...cards.children].forEach(applyTo);
      }

      q?.addEventListener('input', apply);
      filtro?.addEventListener('change', apply);
    })();

    // Abrir modal de "Horas extra" (si ya creaste el handler antes, puedes quitar esto)
    document.getElementById('btnHorasExtra')?.addEventListener('click', () => {
      // Aquí puedes reutilizar el SweetAlert2 que ya te pasé para solicitar horas extra.
      // Ej.: openHorasExtraModal();  // tu función existente
    });
  </script>
<%- include('partials/footer') %>
