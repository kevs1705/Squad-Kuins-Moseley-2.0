<%
  pageTitle = 'Notificaciones';
  pageSubtitle = 'Solicitudes de horas extra — Admin: ' + (user ? user.nombre : '');
%>
<%- include('partials/header') %>

  <!-- HEADER -->
  <div class="row">
    <section class="card col">

      <div class="grid grid-2 gap-2 mt-3">
        <div class="kv">
          <span class="label">Total solicitudes</span>
          <span class="value"><%= (notifs||[]).length %></span>
        </div>
        <div class="kv">
          <span class="label">Pendientes</span>
          <span class="value"><%= (notifs||[]).filter(n => Number(n.estado)===1).length %></span>
        </div>
      </div>
    </section>

    <aside class="card col-2" style="max-width:360px">
      <div class="panel">
        <div class="grid grid-2 gap-2">
          <a class="btn max-w" href="/cuenta">🏠 Menú</a>
        </div>
      </div>
    </aside>
  </div>

  <!-- LISTADOR -->
  <section class="card mt-4">
    <div class="toolbar justify-between">
      <h3 class="h3 m-0">Listado de notificaciones</h3>
      <div class="toolbar">
        <input id="q" class="input" placeholder="Buscar por nombre, motivo o fecha..." />
        <select id="filtroEstado" class="select">
          <option value="">Todos</option>
          <option value="1">Pendiente</option>
          <option value="2">Aprobado</option>
          <option value="3">Rechazado</option>
        </select>
      </div>
    </div>

    <% if ((notifs||[]).length === 0) { %>
      <div class="alert alert--info mt-3">Aún no hay solicitudes de horas extra.</div>
    <% } else { %>

    <!-- tabla desktop -->
    <div class="table-wrap desktop-only">
      <table class="table">
        <thead class="thead">
          <tr>
            <th>Pasante</th>
            <th>Fecha</th>
            <th>Inicio</th>
            <th>Fin</th>
            <th>Motivo</th>
            <th>Estado</th>
            <th class="td--center">Acciones</th>
            <th class="muted">Creado</th>
          </tr>
        </thead>
        <tbody id="tbody">
        <% notifs.forEach(n => { %>
          <tr class="tr"
              data-id="<%= n.id_notificacion %>"
              data-estado="<%= Number(n.estado) %>"
              data-fecha="<%- n.fecha_solicitada %>"
              data-motivo="<%- (n.motivo||'').toLowerCase().replace(/"/g,'&quot;') %>"
              data-nombre="<%- (n.nombre_usuario||'').toLowerCase().replace(/"/g,'&quot;') %>">
            <td class="td"><%= n.nombre_usuario %></td>
            <td class="td"><%= n.fecha_solicitada %></td>
            <td class="td nowrap"><%= (n.hora_inicio||'').slice(0,5) %></td>
            <td class="td nowrap"><%= (n.hora_fin||'').slice(0,5) %></td>
            <td class="td muted"><%- n.motivo %></td>
            <td class="td">
              <span class="chip <%= n.estado==1?'chip--pend':(n.estado==2?'chip--ok':'chip--err') %>">
                <%= n.estado==1?'Pendiente':(n.estado==2?'Aprobado':'Rechazado') %>
              </span>
            </td>
            <td class="td td--center">
              <% if (Number(n.estado) === 1) { %>
              <div class="grid" style="gap:8px">
                <input class="input" placeholder="Observación admin (opcional)" data-role="obs" />
                <div class="toolbar justify-center gap-2">
                  <button class="btn btn--primary" data-role="approve">✔ Aprobar</button>
                  <button class="btn btn--danger"  data-role="reject">✖ Rechazar</button>
                </div>
              </div>
              <% } else { %>
                <div class="muted"><%= n.observacion_admin || '—' %></div>
              <% } %>
            </td>
            <td class="td muted"><%= new Date(n.creado_en).toLocaleString('es-BO') %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>


    <% } %>
  </section>

<script>
  // --- Filtros (texto + estado) ---
  (function(){
    const q = document.getElementById('q');
    const filtro = document.getElementById('filtroEstado');
    const tbody = document.getElementById('tbody');
    const cards = document.getElementById('cards');

    function match(el, txt, est) {
      const motivo = (el.dataset.motivo || '');
      const fecha  = (el.dataset.fecha || '');
      const estado = (el.dataset.estado || '');
      const nombre = (el.dataset.nombre || '');
      const okTxt = !txt || motivo.includes(txt) || fecha.includes(txt) || nombre.includes(txt);
      const okEst = !est || estado === est;
      el.style.display = (okTxt && okEst) ? '' : 'none';
    }

    function apply(){
      const txt = (q?.value || '').toLowerCase().trim();
      const est = (filtro?.value || '');
      if (tbody) [...tbody.children].forEach(tr => match(tr, txt, est));
      if (cards) [...cards.children].forEach(li => match(li, txt, est));
    }

    q?.addEventListener('input', apply);
    filtro?.addEventListener('change', apply);
  })();

  // --- Acciones Aprobar/Rechazar ---
  (function(){
    async function call(id, action, obs){
      const r = await fetch(`/notificaciones/${id}/${action}`, {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ obs })
      });
      return r.json();
    }

    function handleContainer(container){
      if (!container) return;
      container.addEventListener('click', async (ev) => {
        const btn = ev.target.closest('button[data-role]');
        if (!btn) return;
        const parent = ev.target.closest('[data-id]');
        if (!parent) return;
        const id = parent.dataset.id;
        const obsInput = parent.querySelector('[data-role="obs"]');
        const obs = obsInput ? obsInput.value.trim() : '';

        const role = btn.dataset.role; // approve | reject
        btn.disabled = true;

        try{
          const j = await call(id, role, obs);
          if (!j.ok) {
            alert(j.msg || 'Operación falló');
            btn.disabled = false;
            return;
          }
          // Actualizar UI: estado + chips + acciones
          parent.dataset.estado = (role === 'approve') ? '2' : '3';
          const chip = parent.querySelector('.chip');
          if (chip){
            chip.className = 'chip ' + (role==='approve' ? 'chip--ok' : 'chip--err');
            chip.textContent = (role==='approve' ? 'Aprobado' : 'Rechazado');
          }
          // Reemplazar el bloque de acciones por observación
          const actionsCell = parent.querySelector('.td.td--center') || parent; // desktop o móvil
          if (actionsCell){
            const obsText = document.createElement('div');
            obsText.className = 'muted';
            obsText.textContent = obs || '—';
            // limpiar inputs/botones
            const inputs = actionsCell.querySelectorAll('input,button');
            inputs.forEach(n => n.remove());
            actionsCell.appendChild(obsText);
          }
        }catch(e){
          console.error(e);
          alert('Error de red');
          btn.disabled = false;
        }
      });
    }

    handleContainer(document.getElementById('tbody'));
    handleContainer(document.getElementById('cards'));
  })();
</script>
<%- include('partials/footer') %>
